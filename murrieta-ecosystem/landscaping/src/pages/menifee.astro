---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you offer landscaping services for seniors in Sun City Menifee?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we work with many Sun City Menifee homeowners, including seniors who want low-maintenance yards they can enjoy without heavy upkeep. We specialize in easy-care drought-tolerant designs using slow-growing plants, decomposed granite, and drip irrigation systems with smart controllers that manage watering automatically. We offer patient consultations and clear written estimates with no pressure to commit." } },
    { '@type': 'Question', name: "How do you handle Menifee's expansive clay soil in landscaping?", acceptedAnswer: { '@type': 'Answer', text: "Menifee's clay soils expand when wet and shrink when dry, which can heave sidewalks and crack concrete over time. When landscaping on clay, we amend planting areas with compost, install drainage swales where needed, and choose plants adapted to alternating wet and dry conditions. We avoid plants with aggressive roots that accelerate soil movement near structures." } },
    { '@type': 'Question', name: 'Can you design drought-tolerant landscapes for newer Menifee homes?', acceptedAnswer: { '@type': 'Answer', text: "Absolutely — newer Menifee developments like Audie Murphy Ranch, Heartland, and Heritage Lakes often have builder-installed landscaping that uses water-intensive turf. Many homeowners want to convert these to drought-tolerant designs that still look polished and neighborhood-appropriate. We design low-water front yards that qualify for EVMWD water rebates and match HOA requirements." } },
    { '@type': 'Question', name: "What's the typical cost for a front yard landscaping project in Menifee?", acceptedAnswer: { '@type': 'Answer', text: "A standard Menifee front yard project — turf removal, drought-tolerant planting, drip irrigation, and mulch — typically runs $4,000–$9,000 depending on yard size and plant selection. Irrigation upgrades alone run $1,500–$3,500. We provide detailed written estimates after a free site visit, and we'll identify any water rebate opportunities available through your water district." } },
  ],
};
---

<BaseLayout
  title="Landscaping Menifee, CA | Lawn Care & Yard Design | Free Consultation"
  description="Professional landscaping and lawn care in Menifee, CA. Drought-tolerant designs, irrigation, and yard transformations for Menifee's newest communities. Free consultations."
  canonicalUrl="https://landscapingmurrieta.com/menifee/"
>
  <Hero
    headline="Landscaping & Lawn Care in Menifee, CA"
    subheadline="Beautiful, drought-smart yard transformations for Menifee's growing communities. Custom landscape design, lawn care, irrigation, and seasonal cleanup. Free consultations throughout Menifee."
    ctaText="Get a Free Consultation"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Landscaping Services in Menifee</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      We design and maintain beautiful yards throughout Menifee — water-smart, HOA-compliant, and built for inland SoCal's warm climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Landscaping for Menifee's New Construction Homes</h2>
      <p>
        Menifee is one of California's fastest-growing cities — and with that growth comes an enormous number of homes with minimal builder landscaping. The standard builder install in Menifee's newer subdivisions typically includes basic front-yard sod, a handful of starter shrubs along the foundation, and a simple sprinkler timer. It's designed to pass inspection, not to look great or perform well long-term.
      </p>
      <p>
        New construction soil is another challenge. Heavy equipment compacts soil deeply during the building process, and it often isn't amended before final grading. This compacted soil drains poorly, restricts root development, and makes it hard to establish healthy lawns or plant beds without intervention. Before we design anything, we assess the soil so our solution addresses what's actually happening underground, not just what's visible above it.
      </p>

      <h2>Drought-Tolerant Landscaping in Menifee</h2>
      <p>
        Much of Menifee is served by Eastern Municipal Water District, which operates under the same California tiered-pricing structure as other inland SoCal water agencies. Outdoor irrigation — especially traditional lawn irrigation — is the largest driver of residential water bills in Menifee during summer months. A properly designed drought-tolerant landscape with drip irrigation can cut outdoor water use by 40–60%.
      </p>
      <p>
        California native plants are particularly well-suited to Menifee's warm, dry climate. Salvia, Ceanothus, Agave, Manzanita, and ornamental grasses look exceptional in Menifee's landscape conditions and require minimal supplemental water once established. Many of our designs also qualify for Eastern Municipal Water District turf replacement rebates, which can offset installation costs by $1–$2 per square foot.
      </p>

      <h2>Serving All Menifee Communities</h2>
      <p>
        We landscape homes throughout Menifee, including Audie Murphy Ranch, Bradley Junction, Romoland, Quail Valley, Sun City, and properties along the Holland Road and Murrieta Road corridors. Menifee's newer master-planned communities — particularly Audie Murphy Ranch — have detailed HOA landscape guidelines. We're familiar with these approval processes and handle all documentation and submissions on your behalf.
      </p>

      <h2>Coordinated Outdoor Renovations</h2>
      <p>
        Many Menifee homeowners combine landscaping with hardscape improvements — new driveways, patios, and concrete work that transforms the entire outdoor space at once. We coordinate directly with <a href="https://murrietaconcreteworks.com">concrete contractors</a> to sequence work properly so landscape plants go in after hardscape is complete, and irrigation is laid before concrete is poured. We also work alongside <a href="https://murrietatreeexperts.com">certified arborists</a> when projects involve removing or significantly trimming trees before new landscaping begins — getting the tree work done first protects everything that comes after.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Temecula Valley</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Landscaping in Menifee</h2>
    <div class="space-y-4">
      {[
        { q: "Do you offer landscaping services for seniors in Sun City Menifee?", a: "Yes — we work with many Sun City Menifee homeowners, including seniors who want low-maintenance yards they can enjoy without heavy upkeep. We specialize in easy-care drought-tolerant designs using slow-growing plants, decomposed granite, and drip irrigation systems with smart controllers that manage watering automatically. We offer patient consultations and clear written estimates with no pressure to commit." },
        { q: "How do you handle Menifee's expansive clay soil in landscaping?", a: "Menifee's clay soils expand when wet and shrink when dry, which can heave sidewalks and crack concrete over time. When landscaping on clay, we amend planting areas with compost, install drainage swales where needed, and choose plants adapted to alternating wet and dry conditions. We avoid plants with aggressive roots that accelerate soil movement near structures." },
        { q: "Can you design drought-tolerant landscapes for newer Menifee homes?", a: "Absolutely — newer Menifee developments like Audie Murphy Ranch, Heartland, and Heritage Lakes often have builder-installed landscaping that uses water-intensive turf. Many homeowners want to convert these to drought-tolerant designs that still look polished and neighborhood-appropriate. We design low-water front yards that qualify for EVMWD water rebates and match HOA requirements." },
        { q: "What's the typical cost for a front yard landscaping project in Menifee?", a: "A standard Menifee front yard project — turf removal, drought-tolerant planting, drip irrigation, and mulch — typically runs $4,000–$9,000 depending on yard size and plant selection. Irrigation upgrades alone run $1,500–$3,500. We provide detailed written estimates after a free site visit, and we'll identify any water rebate opportunities available through your water district." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Schedule Your Free Landscaping Consultation in Menifee" />
  </section>
</BaseLayout>
