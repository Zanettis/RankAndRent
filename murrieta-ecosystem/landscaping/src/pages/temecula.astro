---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you design landscapes for Wine Country estates and HOA communities in Temecula?', acceptedAnswer: { '@type': 'Answer', text: "Yes — Temecula's Wine Country properties and HOA communities like Redhawk, Wolf Creek, and Paloma del Sol each have distinct design requirements. HOA communities require pre-approved plant lists, specific fence heights, and often mandate drought-tolerant plantings. We prepare all HOA documentation and submit plans on your behalf. For Wine Country estates, we specialize in Mediterranean-style landscapes that complement the regional character." } },
    { '@type': 'Question', name: 'What drought-tolerant plants work best in Temecula?', acceptedAnswer: { '@type': 'Answer', text: "Temecula's warm, dry climate is ideal for lavender, rosemary, bougainvillea, California sagebrush, and ornamental grasses like blue oat grass and Mexican feather grass. We also work with California natives like Cleveland sage, toyon, and blue-eyed grass that are adapted to summer drought. Many of these plants qualify for EVMWD water rebates — we can identify which selections in your design qualify for rebate credit." } },
    { '@type': 'Question', name: 'Can you help me get water rebates from EVMWD for drought-tolerant landscaping in Temecula?', acceptedAnswer: { '@type': 'Answer', text: "Yes. The Eastern Municipal Water District (EVMWD) offers turf replacement rebates for Temecula properties that convert water-intensive grass to drought-tolerant plants. We're familiar with the EVMWD program requirements — qualifying plant species, minimum conversion size, before/after photo documentation, and the application process. We design the project to maximize your rebate eligibility and can walk you through the application." } },
    { '@type': 'Question', name: 'How much does a landscaping project typically cost in Temecula?', acceptedAnswer: { '@type': 'Answer', text: "Landscaping costs in Temecula vary widely based on scope. A standard front yard drought-tolerant conversion (turf removal + new planting + mulch) runs $3,500–$8,000. Full backyard designs with irrigation, patios, and mature plantings typically start at $12,000. We provide free, detailed written estimates after a site visit — no phone quotes, since every yard is different." } },
  ],
};
---

<BaseLayout
  title="Landscaping Temecula, CA | Lawn Care, Irrigation & Landscape Design"
  description="Professional landscaping, lawn care, and irrigation in Temecula, CA. Drought-smart designs, HOA-compliant work, free consultations. Serving Redhawk, Wolf Creek, Crowne Hill, and all Temecula communities."
  canonicalUrl="https://landscapingmurrieta.com/temecula/"
>
  <Hero
    headline="Landscaping & Lawn Care in Temecula, CA"
    subheadline="Beautiful, drought-smart outdoor spaces for Temecula homeowners. Custom landscape design, weekly lawn care, irrigation installation, and seasonal cleanup. Free consultations throughout Temecula."
    ctaText="Get a Free Consultation"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Landscaping Services in Temecula</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      We design and maintain beautiful yards throughout Temecula — water-smart, HOA-compliant, and built for inland SoCal's warm climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Landscaping Built for Temecula's Climate</h2>
      <p>
        Temecula's warm inland climate is ideal for outdoor living — but designing a yard that thrives here requires understanding local conditions. Clay-heavy soils drain poorly and stress turf roots. Summer temperatures regularly exceed 100°F. Water costs are high, and the Rancho California Water District has specific conservation guidelines. Our landscape designs address every one of these realities, creating yards that look great with minimal water and maintenance.
      </p>

      <h2>Serving All Temecula Neighborhoods</h2>
      <p>
        We landscape homes throughout Temecula, including Redhawk, Wolf Creek, Paloma del Sol, Crowne Hill, Harveston, Morgan Hill, and communities near Old Town Temecula and the Wine Country. We're familiar with the HOA guidelines in each of these communities — particularly the strict landscape approval processes in Redhawk and Crowne Hill — and we handle all documentation and submissions on your behalf.
      </p>

      <h2>Drought-Tolerant and Water-Efficient Designs</h2>
      <p>
        Most Temecula homeowners want a beautiful yard without a high water bill. We specialize in drought-tolerant landscaping using California native plants, Mediterranean-climate species, and low-water ground covers that look spectacular even in Temecula's dry summers. We also install drip irrigation systems and smart controllers that automatically adjust watering schedules based on weather — often qualifying for rebates from local water districts.
      </p>

      <h2>Why Temecula Homeowners Choose Us</h2>
      <p>
        We're locally based in the Murrieta/Temecula Valley — not a franchise. Our crew knows Temecula's soil, HOA requirements, and plant palette. We provide free on-site consultations, written project proposals, and realistic timelines before any work begins. Every job comes with a satisfaction guarantee: if something doesn't look right, we come back and fix it.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Temecula Valley</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Landscaping in Temecula</h2>
    <div class="space-y-4">
      {[
        { q: "Do you design landscapes for Wine Country estates and HOA communities in Temecula?", a: "Yes — Temecula's Wine Country properties and HOA communities like Redhawk, Wolf Creek, and Paloma del Sol each have distinct design requirements. HOA communities require pre-approved plant lists, specific fence heights, and often mandate drought-tolerant plantings. We prepare all HOA documentation and submit plans on your behalf. For Wine Country estates, we specialize in Mediterranean-style landscapes that complement the regional character." },
        { q: "What drought-tolerant plants work best in Temecula?", a: "Temecula's warm, dry climate is ideal for lavender, rosemary, bougainvillea, California sagebrush, and ornamental grasses like blue oat grass and Mexican feather grass. We also work with California natives like Cleveland sage, toyon, and blue-eyed grass that are adapted to summer drought. Many of these plants qualify for EVMWD water rebates — we can identify which selections in your design qualify for rebate credit." },
        { q: "Can you help me get water rebates from EVMWD for drought-tolerant landscaping in Temecula?", a: "Yes. The Eastern Municipal Water District (EVMWD) offers turf replacement rebates for Temecula properties that convert water-intensive grass to drought-tolerant plants. We're familiar with the EVMWD program requirements — qualifying plant species, minimum conversion size, before/after photo documentation, and the application process. We design the project to maximize your rebate eligibility and can walk you through the application." },
        { q: "How much does a landscaping project typically cost in Temecula?", a: "Landscaping costs in Temecula vary widely based on scope. A standard front yard drought-tolerant conversion (turf removal + new planting + mulch) runs $3,500–$8,000. Full backyard designs with irrigation, patios, and mature plantings typically start at $12,000. We provide free, detailed written estimates after a site visit — no phone quotes, since every yard is different." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Schedule Your Free Landscaping Consultation in Temecula" />
  </section>
</BaseLayout>
