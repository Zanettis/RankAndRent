---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_CONFIG } from '../config';
---

<BaseLayout
  title="Page Not Found | Murrieta Landscaping"
  description="The page you're looking for doesn't exist. Return to Murrieta Landscaping for professional landscaping, lawn care, and irrigation services."
>
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="text-6xl font-bold text-primary mb-4">404</p>
    <h1 class="text-3xl font-bold text-primary mb-4">Page Not Found</h1>
    <p class="text-gray-600 mb-10 text-lg">
      This page doesn't exist or has been moved. Let us help you find what you need.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-12">
      <a href="/" class="bg-cta text-white px-6 py-3 rounded-lg font-bold hover:opacity-90 transition-opacity">
        Back to Home
      </a>
      <a href="/services/" class="border-2 border-primary text-primary px-6 py-3 rounded-lg font-semibold hover:bg-primary hover:text-white transition-colors">
        View All Services
      </a>
    </div>
    <div class="text-left max-w-sm mx-auto">
      <p class="font-semibold text-primary mb-3">Our services:</p>
      <ul class="space-y-2">
        {SITE_CONFIG.services.map(s => (
          <li><a href={s.href} class="text-cta hover:underline text-sm">{s.title}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
