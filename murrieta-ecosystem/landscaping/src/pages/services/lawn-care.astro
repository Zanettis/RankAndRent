---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "How often should I have my lawn mowed in Murrieta's climate?",
      acceptedAnswer: { '@type': 'Answer', text: "In Murrieta's warm inland climate, most lawns benefit from weekly mowing during the spring and summer growing season — typically March through October. During cooler months when growth slows, biweekly service is usually sufficient. We adjust your schedule automatically based on seasonal conditions so your lawn always looks its best." },
    },
    {
      '@type': 'Question',
      name: "What's the best lawn care schedule for summer in Southern California?",
      acceptedAnswer: { '@type': 'Answer', text: "Southern California summers are tough on lawns. We recommend weekly mowing at a slightly higher blade height (3–4 inches) to reduce heat stress, deep but infrequent watering early in the morning to minimize evaporation, and a slow-release fertilizer application in late spring before temperatures spike. We also monitor for grub and chinch bug activity, which peaks during Murrieta's hottest months." },
    },
    {
      '@type': 'Question',
      name: 'Do you handle fertilization and weed control as part of lawn care?',
      acceptedAnswer: { '@type': 'Answer', text: "Yes. We offer fertilization and weed control as add-ons to any maintenance plan. Our seasonal fertilization program includes a spring pre-emergent weed treatment, a summer slow-release feed, and a fall application to strengthen roots heading into winter. Spot weed control is included in all maintenance visits at no extra charge." },
    },
    {
      '@type': 'Question',
      name: 'Can you maintain a lawn if there are large trees creating shade or root competition?',
      acceptedAnswer: { '@type': 'Answer', text: "Absolutely — this is a common challenge in Murrieta's older neighborhoods. We assess how tree canopy and surface roots affect your turf and adjust our approach accordingly, sometimes recommending shade-tolerant grass varieties or strategic mulching around root zones. In some cases, light canopy thinning by a certified arborist can significantly improve lawn health." },
    },
    {
      '@type': 'Question',
      name: 'How much does weekly or biweekly lawn care cost in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: "Standard residential lawn care in Murrieta starts at $75–$100 per visit for a typical lot, including mowing, edging, and blowing off hardscaped surfaces. Biweekly service is priced slightly higher per visit. Fertilization, weed control, and aeration are priced as add-ons. We provide a firm quote after a quick yard assessment — no surprises." },
    },
    {
      '@type': 'Question',
      name: 'How do I keep my lawn green while complying with California water restrictions?',
      acceptedAnswer: { '@type': 'Answer', text: "California water restrictions require smart irrigation habits — watering before 9 a.m. or after 6 p.m., avoiding runoff, and limiting watering days based on local mandates. We help by programming your irrigation controller correctly, checking for leaks or inefficient heads, and recommending drought-tolerant turf alternatives like tall fescue or buffalo grass that stay green on less water. We're familiar with EVMWD and RCWD guidelines and can keep your lawn compliant." },
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Lawn Care',
  name: 'Lawn Care in Murrieta, CA',
  description: 'Weekly and biweekly lawn maintenance in Murrieta. Mowing, edging, fertilizing, and weed control. Consistent service built for inland SoCal climate. Free quotes.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    telephone: SITE_CONFIG.phone,
  },
  areaServed: [
    { '@type': 'City', name: 'Murrieta' },
    { '@type': 'City', name: 'Temecula' },
    { '@type': 'City', name: 'Wildomar' },
    { '@type': 'City', name: 'Menifee' },
  ],
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: '75',
      maxPrice: '200',
      priceCurrency: 'USD',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Lawn Care', item: `${SITE_CONFIG.domain}/services/lawn-care/` },
  ],
};
---

<BaseLayout
  title="Lawn Care Murrieta, CA | Weekly Maintenance & Free Quote"
  description="Professional lawn care in Murrieta. Weekly mowing, edging, fertilizing & weed control. Consistent service for SoCal's climate. Free quotes."
  ogImage="/images/hero.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Professional Lawn Care in Murrieta"
    subheadline="Consistent, reliable lawn maintenance that keeps your yard looking great every week — without the hassle of doing it yourself."
    ctaText="Get a Free Quote"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Murrieta's Lawn Care Challenges</h2>
      <p>
        Growing a healthy lawn in Murrieta requires navigating clay soil, summer temperatures
        regularly exceeding 100°F, California's water restrictions, and pests like grubs and
        chinch bugs that thrive in inland Southern California. Our maintenance plans are built
        around these specific challenges — not generic national programs.
      </p>

      <h2>What's Included in Our Lawn Care Service</h2>
      <p>
        Our standard maintenance visits include mowing to the correct height for your grass type,
        edging along driveways and beds, blowing off hardscaped surfaces, and a visual inspection
        for pest or disease issues. We can add fertilization, weed control, and overseeding
        as needed based on your lawn's condition.
      </p>

      <h2>Seasonal Adjustments</h2>
      <p>
        Murrieta lawns need different care in each season. Spring is for fertilization and
        pre-emergent weed control. Summer requires careful watering schedules and heat stress
        management. Fall is ideal for aeration and overseeding. Winter is when many lawns
        go dormant and maintenance frequency decreases. We adjust your service schedule
        automatically throughout the year.
      </p>

      <h2>Trees and Lawn: Working Together</h2>
      <p>
        Trees significantly affect lawn health — their roots compete for water, and dense canopies
        create shade that favors different grass varieties. Before starting a new lawn care program,
        we assess how existing trees impact your turf, and may recommend
        <a href="https://murrietatreeexperts.com/services/tree-trimming">canopy thinning</a>
        to improve the lawn's access to sunlight.
      </p>
    </div>

    <CrossLinkWidget
      heading="Tree Services That Affect Your Lawn"
      links={[
        { text: "Tree Trimming in Murrieta", href: "https://murrietatreeexperts.com/services/tree-trimming", description: "Canopy thinning improves sunlight access to lawn areas struggling under dense shade.", icon: "🌳" },
        { text: "Stump Grinding Murrieta", href: "https://murrietatreeexperts.com/services/stump-grinding", description: "Remove stumps that block mowing and prevent uniform lawn maintenance.", icon: "🪵" },
        { text: "Concrete Driveways & Slabs", href: "https://murrietaconcreteworks.com/services/concrete-driveways", description: "Install concrete driveways and slabs that complement your lawn and landscaping.", icon: "🏗️" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Landscaping Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/lawn-care').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        { q: "How often should I have my lawn mowed in Murrieta's climate?", a: "In Murrieta's warm inland climate, most lawns benefit from weekly mowing during the spring and summer growing season — typically March through October. During cooler months when growth slows, biweekly service is usually sufficient. We adjust your schedule automatically based on seasonal conditions so your lawn always looks its best." },
        { q: "What's the best lawn care schedule for summer in Southern California?", a: "Southern California summers are tough on lawns. We recommend weekly mowing at a slightly higher blade height (3–4 inches) to reduce heat stress, deep but infrequent watering early in the morning to minimize evaporation, and a slow-release fertilizer application in late spring before temperatures spike. We also monitor for grub and chinch bug activity, which peaks during Murrieta's hottest months." },
        { q: "Do you handle fertilization and weed control as part of lawn care?", a: "Yes. We offer fertilization and weed control as add-ons to any maintenance plan. Our seasonal fertilization program includes a spring pre-emergent weed treatment, a summer slow-release feed, and a fall application to strengthen roots heading into winter. Spot weed control is included in all maintenance visits at no extra charge." },
        { q: "Can you maintain a lawn if there are large trees creating shade or root competition?", a: "Absolutely — this is a common challenge in Murrieta's older neighborhoods. We assess how tree canopy and surface roots affect your turf and adjust our approach accordingly, sometimes recommending shade-tolerant grass varieties or strategic mulching around root zones. In some cases, light canopy thinning by a certified arborist can significantly improve lawn health." },
        { q: "How much does weekly or biweekly lawn care cost in Murrieta?", a: "Standard residential lawn care in Murrieta starts at $75–$100 per visit for a typical lot, including mowing, edging, and blowing off hardscaped surfaces. Biweekly service is priced slightly higher per visit. Fertilization, weed control, and aeration are priced as add-ons. We provide a firm quote after a quick yard assessment — no surprises." },
        { q: "How do I keep my lawn green while complying with California water restrictions?", a: "California water restrictions require smart irrigation habits — watering before 9 a.m. or after 6 p.m., avoiding runoff, and limiting watering days based on local mandates. We help by programming your irrigation controller correctly, checking for leaks or inefficient heads, and recommending drought-tolerant turf alternatives like tall fescue or buffalo grass that stay green on less water. We're familiar with EVMWD and RCWD guidelines and can keep your lawn compliant." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Get Your Free Lawn Care Quote" />
  </section>
</BaseLayout>
