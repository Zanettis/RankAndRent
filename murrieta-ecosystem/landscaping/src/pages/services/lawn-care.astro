---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';
---

<BaseLayout
  title="Lawn Care Murrieta, CA | Weekly & Monthly Maintenance | Free Quotes"
  description="Professional lawn care in Murrieta, CA. Mowing, edging, fertilizing, and weed control. Consistent weekly or biweekly service. Free quotes."
>
  <Hero
    headline="Professional Lawn Care in Murrieta"
    subheadline="Consistent, reliable lawn maintenance that keeps your yard looking great every week — without the hassle of doing it yourself."
    ctaText="Get a Free Quote"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Murrieta's Lawn Care Challenges</h2>
      <p>
        Growing a healthy lawn in Murrieta requires navigating clay soil, summer temperatures
        regularly exceeding 100°F, California's water restrictions, and pests like grubs and
        chinch bugs that thrive in inland Southern California. Our maintenance plans are built
        around these specific challenges — not generic national programs.
      </p>

      <h2>What's Included in Our Lawn Care Service</h2>
      <p>
        Our standard maintenance visits include mowing to the correct height for your grass type,
        edging along driveways and beds, blowing off hardscaped surfaces, and a visual inspection
        for pest or disease issues. We can add fertilization, weed control, and overseeding
        as needed based on your lawn's condition.
      </p>

      <h2>Seasonal Adjustments</h2>
      <p>
        Murrieta lawns need different care in each season. Spring is for fertilization and
        pre-emergent weed control. Summer requires careful watering schedules and heat stress
        management. Fall is ideal for aeration and overseeding. Winter is when many lawns
        go dormant and maintenance frequency decreases. We adjust your service schedule
        automatically throughout the year.
      </p>

      <h2>Trees and Lawn: Working Together</h2>
      <p>
        Trees significantly affect lawn health — their roots compete for water, and dense canopies
        create shade that favors different grass varieties. Before starting a new lawn care program,
        we assess how existing trees impact your turf, and may recommend
        <a href="https://treeservice-murrieta.com/services/tree-trimming">canopy thinning</a>
        to improve the lawn's access to sunlight.
      </p>
    </div>

    <CrossLinkWidget
      heading="Tree Services That Affect Your Lawn"
      links={[
        { text: "Tree Trimming in Murrieta", href: "https://treeservice-murrieta.com/services/tree-trimming", description: "Canopy thinning improves sunlight access to lawn areas struggling under dense shade.", icon: "🌳" },
        { text: "Stump Grinding Murrieta", href: "https://treeservice-murrieta.com/services/stump-grinding", description: "Remove stumps that block mowing and prevent uniform lawn maintenance.", icon: "🪵" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Landscaping Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/lawn-care').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <LeadForm heading="Get Your Free Lawn Care Quote" />
    </div>
  </div>
</BaseLayout>
