---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE_CONFIG } from '../../config';

const icons = ['🎨', '🌿', '💧', '🍂', '🌱', '🪵', '🧱'];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What landscaping services do you offer in Murrieta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We offer landscape design, lawn care, irrigation system installation and repair, seasonal cleanup, sod installation, mulching, and retaining wall construction throughout Murrieta and the Temecula Valley.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you provide free estimates for landscaping work in Murrieta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. All consultations and estimates are free with no obligation. We assess your yard, discuss your goals, and provide a written quote before any work begins.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you serve cities other than Murrieta?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. We serve Murrieta, Temecula, Wildomar, Menifee, Lake Elsinore, Canyon Lake, Hemet, Perris, San Jacinto, and Fallbrook.',
      },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
  ],
};
---

<BaseLayout
  title="Landscaping Services in Murrieta, CA | Full Service Menu"
  description="Explore all landscaping services offered in Murrieta: landscape design, lawn care, irrigation, sod installation, mulching, retaining walls, and seasonal cleanup. Free estimates."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-6xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-6" aria-label="breadcrumb">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="mx-2">/</span>
      <span class="text-gray-800">Services</span>
    </nav>

    <header class="text-center mb-12">
      <h1 class="text-4xl font-bold text-primary mb-4">Landscaping Services in Murrieta, CA</h1>
      <p class="text-gray-600 max-w-2xl mx-auto text-lg">
        From custom landscape design to weekly lawn care, we handle every aspect of your outdoor space.
        All work is drought-smart, HOA-compliant, and backed by free consultations.
      </p>
    </header>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {SITE_CONFIG.services.map((service, i) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          href={service.href}
          icon={icons[i] ?? '🌿'}
        />
      ))}
    </div>

    <section class="bg-gray-50 rounded-2xl p-8 mb-16">
      <h2 class="text-2xl font-bold text-primary mb-4 text-center">Why Murrieta Homeowners Choose Us</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
        <div class="text-center">
          <div class="text-3xl mb-3">☀️</div>
          <h3 class="font-semibold text-primary mb-2">Built for Inland SoCal</h3>
          <p class="text-gray-600 text-sm">Every design accounts for Murrieta's heat, clay soils, and tiered water pricing — so your landscape thrives without inflating your water bill.</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-3">📋</div>
          <h3 class="font-semibold text-primary mb-2">HOA Submission Handled</h3>
          <p class="text-gray-600 text-sm">We prepare and submit all HOA documentation on your behalf — from Bear Creek to Greer Ranch, we know what each board approves.</p>
        </div>
        <div class="text-center">
          <div class="text-3xl mb-3">💧</div>
          <h3 class="font-semibold text-primary mb-2">Rebate-Ready Designs</h3>
          <p class="text-gray-600 text-sm">Many of our drought-tolerant landscapes and irrigation systems qualify for EVMWD and RCWD rebates — we help you capture every dollar available.</p>
        </div>
      </div>
    </section>

    <section class="max-w-3xl mx-auto mb-16">
      <h2 class="text-2xl font-bold text-primary text-center mb-8">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqSchema.mainEntity.map(({ name, acceptedAnswer }) => (
          <details class="border border-gray-200 rounded-xl overflow-hidden group">
            <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
              {name}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{acceptedAnswer.text}</div>
          </details>
        ))}
      </div>
    </section>

    <section class="max-w-3xl mx-auto">
      <LeadForm heading="Get a Free Landscaping Estimate in Murrieta" />
    </section>
  </div>
</BaseLayout>
