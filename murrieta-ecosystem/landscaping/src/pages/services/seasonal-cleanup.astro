---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { SITE_CONFIG } from '../../config';
---

<BaseLayout
  title="Seasonal Cleanup Murrieta, CA | Spring & Fall Yard Cleanup | Free Quotes"
  description="Professional seasonal yard cleanup in Murrieta, CA. Leaf removal, bed clearing, pruning, and spring prep. Free quotes."
>
  <Hero
    headline="Seasonal Yard Cleanup in Murrieta"
    subheadline="Start each season with a fresh, clean landscape. Our seasonal cleanup services prep your yard for success all year long."
    ctaText="Get a Free Quote"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Spring Cleanup: Prep for Growing Season</h2>
      <p>
        Murrieta's spring cleanup focuses on clearing winter debris, cutting back dormant perennials,
        applying pre-emergent weed control before annual weeds germinate, and refreshing mulch
        in planting beds. We also inspect irrigation systems after winter and make any necessary
        adjustments before the hot season begins.
      </p>

      <h2>Fall Cleanup: Wind Down for Winter</h2>
      <p>
        As Murrieta's deciduous trees drop their leaves in fall, yard cleanup becomes essential.
        We remove accumulated leaves and debris, cut back summer annuals, aerate and overseed
        warm-season lawns, and prep planting beds for winter planting. Fall is also the best
        time to plant many California natives and drought-adapted shrubs.
      </p>

      <h2>Combining Cleanup with Tree Work</h2>
      <p>
        Many homeowners schedule seasonal cleanup alongside
        <a href="https://treeservice-murrieta.com/services/tree-trimming">tree trimming</a>
        to handle everything at once. We coordinate timing so tree work happens first,
        then ground crews clean up all debris together — saving you time and money.
      </p>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Landscaping Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/seasonal-cleanup').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <LeadForm heading="Schedule Your Seasonal Cleanup" />
    </div>
  </div>
</BaseLayout>
