---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';
---

<BaseLayout
  title="Seasonal Yard Cleanup Murrieta, CA | Spring & Fall | Free Quote"
  description="Professional seasonal yard cleanup in Murrieta, CA. Spring and fall cleanups including leaf removal, pruning, mulching, and debris hauling. Free quotes."
>
  <Hero
    headline="Seasonal Yard Cleanup in Murrieta, CA"
    subheadline="Spring and fall yard cleanups that keep your property looking sharp year-round. Leaf removal, pruning, mulching, edging, and full debris haul-away. Free quotes."
    ctaText="Schedule Your Cleanup"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Why Seasonal Cleanup Matters in Murrieta</h2>
      <p>
        Murrieta's warm climate means year-round plant growth — which is beautiful but also means
        year-round accumulation of leaves, dead growth, and debris. Seasonal cleanups in spring and
        fall reset your yard, reduce fire hazard around your property, and set up your plants for
        healthy growth in the coming season.
      </p>

      <h2>Spring Cleanup</h2>
      <p>
        After winter, yards in Murrieta often need a full refresh before the growing season kicks in.
        Our spring cleanup includes removal of dead plant material and winter debris, pruning back
        dormant shrubs and perennials, edging beds and borders, applying fresh mulch, and a full
        property sweep and haul-away. We leave your yard ready for summer with minimal maintenance
        effort on your part.
      </p>

      <h2>Fall Cleanup</h2>
      <p>
        Fall is prime time for leaf accumulation, especially in neighborhoods with mature oak and
        sycamore trees. Our fall cleanup covers leaf removal and haul-away, cutting back spent
        summer growth, prepping irrigation systems for cooler months, and mulching plant beds for
        winter moisture retention. A proper fall cleanup also reduces habitat for pests and reduces
        fire fuel load around your home.
      </p>

      <h2>What's Included</h2>
      <p>
        Every seasonal cleanup includes:
      </p>
      <ul>
        <li>Full leaf and debris removal</li>
        <li>Lawn mowing and edging</li>
        <li>Shrub and perennial pruning</li>
        <li>Weed pulling from beds</li>
        <li>Mulch refresh (optional add-on)</li>
        <li>Complete haul-away — we take everything with us</li>
      </ul>

      <h2>One-Time or Recurring Service</h2>
      <p>
        We offer seasonal cleanups as one-time services or as part of a recurring maintenance plan.
        Homeowners on a maintenance plan receive priority scheduling and discounted cleanup pricing.
        Ask about our annual maintenance packages when you request a quote.
      </p>
    </div>

    <CrossLinkWidget
      heading="Combine Cleanup With Tree Trimming"
      links={[
        { text: "Tree Trimming in Murrieta", href: "https://murrietatreeexperts.com/services/tree-trimming", description: "Schedule tree trimming alongside your seasonal cleanup for a complete yard refresh.", icon: "🌳" },
        { text: "Stump Grinding Murrieta", href: "https://murrietatreeexperts.com/services/stump-grinding", description: "Remove stumps and dead wood as part of a full spring or fall cleanup.", icon: "🪵" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Landscaping Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/seasonal-cleanup').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <LeadForm heading="Schedule Your Seasonal Yard Cleanup" />
    </div>
  </div>
</BaseLayout>
