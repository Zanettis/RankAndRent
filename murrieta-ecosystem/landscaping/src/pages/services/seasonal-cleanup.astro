---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How often should I schedule seasonal yard cleanup?',
      acceptedAnswer: { '@type': 'Answer', text: "Most Murrieta homeowners benefit from at least two seasonal cleanups per year — spring and fall. Spring cleanup removes winter debris and preps plants for the growing season, while fall cleanup clears summer growth and reduces fire hazard heading into the dry season. Properties with more mature trees or heavy landscaping may benefit from quarterly light cleanups in between." },
    },
    {
      '@type': 'Question',
      name: "What's the difference between spring cleanup and fall cleanup?",
      acceptedAnswer: { '@type': 'Answer', text: "Spring cleanup focuses on refreshing your yard after winter — removing dead growth, pruning back dormant shrubs, pulling winter weeds, edging beds, and applying fresh mulch. Fall cleanup addresses the end of the growing season — clearing accumulated leaves, cutting back summer-spent perennials, prepping irrigation for cooler temperatures, and mulching beds for winter moisture retention. Both include full debris haul-away." },
    },
    {
      '@type': 'Question',
      name: 'Do you haul away all debris, including green waste?',
      acceptedAnswer: { '@type': 'Answer', text: "Yes — complete haul-away is always included in our seasonal cleanup service. We remove all leaves, branches, dead plants, pulled weeds, and green waste from your property. We do not leave piles at the curb or expect you to arrange separate disposal. You won't need to deal with any of it after we leave." },
    },
    {
      '@type': 'Question',
      name: 'How much does a seasonal yard cleanup cost in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: "Seasonal cleanup pricing in Murrieta depends on yard size, the volume of debris, and whether add-ons like mulching or deep pruning are included. A standard single-family home cleanup typically runs $200–$500 for spring or fall service. Larger properties with mature trees or overgrown beds cost more. We always provide a firm written quote before starting — no hidden fees." },
    },
    {
      '@type': 'Question',
      name: 'Can I combine seasonal cleanup with tree trimming or lawn care?',
      acceptedAnswer: { '@type': 'Answer', text: "Absolutely, and we encourage it. Combining your seasonal cleanup with tree trimming or lawn care service is more efficient and often less expensive than scheduling them separately. Many clients also add mulching, fertilization, or irrigation system checks to their cleanup visit. Just let us know what you need when you request a quote and we'll bundle the services." },
    },
    {
      '@type': 'Question',
      name: 'Does yard cleanup help reduce fire hazard around my home?',
      acceptedAnswer: { '@type': 'Answer', text: "Yes — this is especially important in Murrieta given the region's fire history. Removing dry leaves, dead vegetation, overgrown shrubs, and accumulated debris from your property significantly reduces available fuel load. Our fall cleanups specifically target high-fire-risk materials like dead grass clumps and dried annual plants. We can also help create defensible space buffers around structures as part of a cleanup service." },
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Seasonal Yard Cleanup',
  name: 'Seasonal Yard Cleanup in Murrieta, CA',
  description: 'Spring and fall yard cleanup for Murrieta properties. Leaf removal, pruning, mulching, and full debris haul-away. Reduces fire hazard. Free quotes.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    telephone: SITE_CONFIG.phone,
  },
  areaServed: [
    { '@type': 'City', name: 'Murrieta' },
    { '@type': 'City', name: 'Temecula' },
    { '@type': 'City', name: 'Wildomar' },
    { '@type': 'City', name: 'Menifee' },
  ],
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: '200',
      maxPrice: '500',
      priceCurrency: 'USD',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Seasonal Cleanup', item: `${SITE_CONFIG.domain}/services/seasonal-cleanup/` },
  ],
};
---

<BaseLayout
  title="Seasonal Yard Cleanup Murrieta, CA | Free Quote"
  description="Spring & fall yard cleanup in Murrieta. Leaf removal, pruning, mulching & full debris haul-away. Reduces fire hazard. Free quotes."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Seasonal Yard Cleanup in Murrieta, CA"
    subheadline="Spring and fall yard cleanups that keep your property looking sharp year-round. Leaf removal, pruning, mulching, edging, and full debris haul-away. Free quotes."
    ctaText="Schedule Your Cleanup"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Why Seasonal Cleanup Matters in Murrieta</h2>
      <p>
        Murrieta's warm climate means year-round plant growth — which is beautiful but also means
        year-round accumulation of leaves, dead growth, and debris. Seasonal cleanups in spring and
        fall reset your yard, reduce fire hazard around your property, and set up your plants for
        healthy growth in the coming season.
      </p>

      <h2>Spring Cleanup</h2>
      <p>
        After winter, yards in Murrieta often need a full refresh before the growing season kicks in.
        Our spring cleanup includes removal of dead plant material and winter debris, pruning back
        dormant shrubs and perennials, edging beds and borders, applying fresh mulch, and a full
        property sweep and haul-away. We leave your yard ready for summer with minimal maintenance
        effort on your part.
      </p>

      <h2>Fall Cleanup</h2>
      <p>
        Fall is prime time for leaf accumulation, especially in neighborhoods with mature oak and
        sycamore trees. Our fall cleanup covers leaf removal and haul-away, cutting back spent
        summer growth, prepping irrigation systems for cooler months, and mulching plant beds for
        winter moisture retention. A proper fall cleanup also reduces habitat for pests and reduces
        fire fuel load around your home.
      </p>

      <h2>What's Included</h2>
      <p>
        Every seasonal cleanup includes:
      </p>
      <ul>
        <li>Full leaf and debris removal</li>
        <li>Lawn mowing and edging</li>
        <li>Shrub and perennial pruning</li>
        <li>Weed pulling from beds</li>
        <li>Mulch refresh (optional add-on)</li>
        <li>Complete haul-away — we take everything with us</li>
      </ul>

      <h2>One-Time or Recurring Service</h2>
      <p>
        We offer seasonal cleanups as one-time services or as part of a recurring maintenance plan.
        Homeowners on a maintenance plan receive priority scheduling and discounted cleanup pricing.
        Ask about our annual maintenance packages when you request a quote.
      </p>
    </div>

    <CrossLinkWidget
      heading="Combine Cleanup With Tree Trimming"
      links={[
        { text: "Tree Trimming in Murrieta", href: "https://murrietatreeexperts.com/services/tree-trimming", description: "Schedule tree trimming alongside your seasonal cleanup for a complete yard refresh.", icon: "🌳" },
        { text: "Stump Grinding Murrieta", href: "https://murrietatreeexperts.com/services/stump-grinding", description: "Remove stumps and dead wood as part of a full spring or fall cleanup.", icon: "🪵" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Landscaping Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/seasonal-cleanup').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        { q: "How often should I schedule seasonal yard cleanup?", a: "Most Murrieta homeowners benefit from at least two seasonal cleanups per year — spring and fall. Spring cleanup removes winter debris and preps plants for the growing season, while fall cleanup clears summer growth and reduces fire hazard heading into the dry season. Properties with more mature trees or heavy landscaping may benefit from quarterly light cleanups in between." },
        { q: "What's the difference between spring cleanup and fall cleanup?", a: "Spring cleanup focuses on refreshing your yard after winter — removing dead growth, pruning back dormant shrubs, pulling winter weeds, edging beds, and applying fresh mulch. Fall cleanup addresses the end of the growing season — clearing accumulated leaves, cutting back summer-spent perennials, prepping irrigation for cooler temperatures, and mulching beds for winter moisture retention. Both include full debris haul-away." },
        { q: "Do you haul away all debris, including green waste?", a: "Yes — complete haul-away is always included in our seasonal cleanup service. We remove all leaves, branches, dead plants, pulled weeds, and green waste from your property. We do not leave piles at the curb or expect you to arrange separate disposal. You won't need to deal with any of it after we leave." },
        { q: "How much does a seasonal yard cleanup cost in Murrieta?", a: "Seasonal cleanup pricing in Murrieta depends on yard size, the volume of debris, and whether add-ons like mulching or deep pruning are included. A standard single-family home cleanup typically runs $200–$500 for spring or fall service. Larger properties with mature trees or overgrown beds cost more. We always provide a firm written quote before starting — no hidden fees." },
        { q: "Can I combine seasonal cleanup with tree trimming or lawn care?", a: "Absolutely, and we encourage it. Combining your seasonal cleanup with tree trimming or lawn care service is more efficient and often less expensive than scheduling them separately. Many clients also add mulching, fertilization, or irrigation system checks to their cleanup visit. Just let us know what you need when you request a quote and we'll bundle the services." },
        { q: "Does yard cleanup help reduce fire hazard around my home?", a: "Yes — this is especially important in Murrieta given the region's fire history. Removing dry leaves, dead vegetation, overgrown shrubs, and accumulated debris from your property significantly reduces available fuel load. Our fall cleanups specifically target high-fire-risk materials like dead grass clumps and dried annual plants. We can also help create defensible space buffers around structures as part of a cleanup service." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Schedule Your Seasonal Yard Cleanup" />
  </section>
</BaseLayout>
