---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';
import heroBg from '../../assets/images/drought-tolerant-garden.jpg';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What\'s the difference between drip irrigation and a sprinkler system?',
      acceptedAnswer: { '@type': 'Answer', text: 'Drip irrigation delivers water slowly and directly to the root zone of individual plants through emitters, making it ideal for garden beds, shrubs, trees, and drought-tolerant landscaping. Sprinkler systems distribute water over a wider area via rotating or pop-up heads, making them better suited for lawns. Many Murrieta properties benefit from a hybrid system — drip for plant beds and sprinklers for turf areas — for maximum efficiency.' },
    },
    {
      '@type': 'Question',
      name: 'How much can a smart irrigation controller save on my water bill?',
      acceptedAnswer: { '@type': 'Answer', text: "Replacing a standard timer with a weather-based smart controller can reduce outdoor water use by 20–50%, depending on your current system. For the average Murrieta homeowner, that translates to $100–$300 per year in water savings. Smart controllers adjust automatically based on weather, soil moisture, and plant type — so your system never runs when it doesn't need to." },
    },
    {
      '@type': 'Question',
      name: 'Are there rebates available for irrigation upgrades in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: "Yes. Both Eastern Municipal Water District (EVMWD) and Rancho California Water District (RCWD) offer rebates for qualifying irrigation upgrades, including smart controllers, drip conversion, and high-efficiency sprinkler heads. The amounts change periodically, but rebates of $100–$400 or more are common. We'll let you know exactly what you may qualify for when we assess your system." },
    },
    {
      '@type': 'Question',
      name: 'Can you upgrade my existing irrigation system or do I need a full replacement?',
      acceptedAnswer: { '@type': 'Answer', text: "In most cases, we can upgrade your existing system rather than replacing it entirely. Common upgrades include adding a smart controller, converting spray heads to drip, replacing leaking valves, and rezoning for more efficient coverage. A full replacement is usually only necessary when pipes are severely damaged or the system layout is fundamentally inefficient. We'll assess your current setup and give you honest options." },
    },
    {
      '@type': 'Question',
      name: 'Do you install backflow prevention devices?',
      acceptedAnswer: { '@type': 'Answer', text: "Yes. California law requires backflow prevention devices on all irrigation systems connected to a potable water supply, and Murrieta's HOAs and water districts enforce this requirement. We install pressure vacuum breakers and reduced pressure assemblies as appropriate for your system, ensuring full compliance with local code." },
    },
    {
      '@type': 'Question',
      name: "How long do irrigation systems typically last in Murrieta's climate?",
      acceptedAnswer: { '@type': 'Answer', text: "A well-installed irrigation system in Murrieta can last 15–25 years with basic maintenance. PVC pipe is highly durable, but valves, sprinkler heads, and controllers typically need servicing or replacement every 5–10 years. Murrieta's hard water and UV exposure can accelerate wear on above-ground components. Annual system checks help catch small issues before they become costly repairs." },
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Irrigation System Installation',
  name: 'Irrigation Systems in Murrieta, CA',
  description: 'Drip irrigation, sprinkler systems, and smart controller installation for Murrieta homes. Water-efficient, rebate-eligible, and HOA-compliant. Free quotes.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    telephone: SITE_CONFIG.phone,
  },
  areaServed: [
    { '@type': 'City', name: 'Murrieta' },
    { '@type': 'City', name: 'Temecula' },
    { '@type': 'City', name: 'Wildomar' },
    { '@type': 'City', name: 'Menifee' },
  ],
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: '500',
      maxPrice: '4000',
      priceCurrency: 'USD',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Irrigation Systems', item: `${SITE_CONFIG.domain}/services/irrigation/` },
  ],
};
---

<BaseLayout
  title="Irrigation Systems Murrieta, CA | Free Quote"
  description="Water-efficient drip & sprinkler systems for Murrieta homes. Smart controllers, rebate-eligible installs, HOA-compliant. Free quotes."
  ogImage="/images/drought-tolerant-garden.jpg"
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Smart Irrigation Systems for Murrieta Homes"
    subheadline="Keep your lawn and garden green without wasting water. We install drip irrigation, sprinkler systems, and smart controllers designed for inland SoCal's climate and water restrictions."
    ctaText="Get a Free Irrigation Quote"
    backgroundImage={heroBg}
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Irrigation Designed for Murrieta's Climate</h2>
      <p>
        Murrieta sits in inland Southern California where summers are hot, water is expensive, and
        conservation matters. An efficient irrigation system doesn't just keep your yard green —
        it can cut your water bill by 30–50% compared to hand watering or outdated sprinkler systems.
        We design systems that deliver the right amount of water to the right places, nothing more.
      </p>

      <h2>Drip Irrigation</h2>
      <p>
        Drip systems deliver water directly to plant root zones, eliminating evaporation and runoff.
        They're ideal for garden beds, shrubs, trees, and drought-tolerant landscaping. We design and
        install complete drip systems including pressure regulators, filters, emitters, and backflow
        prevention. Many Murrieta water districts offer rebates for drip conversion — we'll let you
        know if you qualify.
      </p>

      <h2>Sprinkler Systems</h2>
      <p>
        For lawns, we install rotary and pop-up sprinkler systems zoned for even coverage without
        overlap or dry spots. We account for Murrieta's varying soil types, slope, and sun exposure
        in every design. All systems include backflow prevention devices as required by California law.
      </p>

      <h2>Smart Controllers & Upgrades</h2>
      <p>
        A smart irrigation controller adjusts watering schedules automatically based on weather,
        soil moisture, and plant type. Replacing a standard timer with a smart controller can save
        the average Murrieta homeowner $100–$300/year. We install and program WiFi-enabled controllers
        compatible with your phone. We also upgrade and repair existing systems — no full replacement needed.
      </p>

      <h2>HOA & Water District Compliance</h2>
      <p>
        California mandates specific backflow prevention and many Murrieta HOAs have guidelines on
        irrigation timing and visible equipment. We ensure every system we install is fully compliant
        so you avoid fines or HOA violations.
      </p>
    </div>

    <CrossLinkWidget
      heading="Tree Irrigation & Arborist Services"
      links={[
        { text: "Tree Trimming in Murrieta", href: "https://murrietatreeexperts.com/services/tree-trimming", description: "Certified arborists help manage canopy to reduce water competition with your lawn and garden.", icon: "🌳" },
        { text: "Tree Removal Murrieta", href: "https://murrietatreeexperts.com/services/tree-removal", description: "Removing a problem tree can dramatically change irrigation zone requirements for your yard.", icon: "🪓" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Landscaping Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/irrigation').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        { q: "What's the difference between drip irrigation and a sprinkler system?", a: "Drip irrigation delivers water slowly and directly to the root zone of individual plants through emitters, making it ideal for garden beds, shrubs, trees, and drought-tolerant landscaping. Sprinkler systems distribute water over a wider area via rotating or pop-up heads, making them better suited for lawns. Many Murrieta properties benefit from a hybrid system — drip for plant beds and sprinklers for turf areas — for maximum efficiency." },
        { q: "How much can a smart irrigation controller save on my water bill?", a: "Replacing a standard timer with a weather-based smart controller can reduce outdoor water use by 20–50%, depending on your current system. For the average Murrieta homeowner, that translates to $100–$300 per year in water savings. Smart controllers adjust automatically based on weather, soil moisture, and plant type — so your system never runs when it doesn't need to." },
        { q: "Are there rebates available for irrigation upgrades in Murrieta?", a: "Yes. Both Eastern Municipal Water District (EVMWD) and Rancho California Water District (RCWD) offer rebates for qualifying irrigation upgrades, including smart controllers, drip conversion, and high-efficiency sprinkler heads. The amounts change periodically, but rebates of $100–$400 or more are common. We'll let you know exactly what you may qualify for when we assess your system." },
        { q: "Can you upgrade my existing irrigation system or do I need a full replacement?", a: "In most cases, we can upgrade your existing system rather than replacing it entirely. Common upgrades include adding a smart controller, converting spray heads to drip, replacing leaking valves, and rezoning for more efficient coverage. A full replacement is usually only necessary when pipes are severely damaged or the system layout is fundamentally inefficient. We'll assess your current setup and give you honest options." },
        { q: "Do you install backflow prevention devices?", a: "Yes. California law requires backflow prevention devices on all irrigation systems connected to a potable water supply, and Murrieta's HOAs and water districts enforce this requirement. We install pressure vacuum breakers and reduced pressure assemblies as appropriate for your system, ensuring full compliance with local code." },
        { q: "How long do irrigation systems typically last in Murrieta's climate?", a: "A well-installed irrigation system in Murrieta can last 15–25 years with basic maintenance. PVC pipe is highly durable, but valves, sprinkler heads, and controllers typically need servicing or replacement every 5–10 years. Murrieta's hard water and UV exposure can accelerate wear on above-ground components. Annual system checks help catch small issues before they become costly repairs." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Get Your Free Irrigation System Quote" />
  </section>
</BaseLayout>
