---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Can you landscape hillside lots in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: "Yes — hillside landscaping is one of our specialties in Wildomar. We work with sloped terrain throughout Heritage Lake, Palomar Hills, and Clinton Keith Estates. Our hillside designs address erosion control, proper drainage, and plant selection for slopes. We use deep-rooted native groundcovers, terracing, and decomposed granite paths to create beautiful, stable landscapes on challenging lots." } },
    { '@type': 'Question', name: "How do you handle Wildomar's clay soil in landscape projects?", acceptedAnswer: { '@type': 'Answer', text: "Wildomar's heavy clay soils drain poorly and compact easily, which limits plant choices and irrigation design. We amend clay soil with organic compost and gypsum to improve structure, install raised planting beds where deep drainage is needed, and select plants that tolerate wet winters and dry summers on clay. Getting the soil preparation right is the foundation of a successful landscape on Wildomar's clay." } },
    { '@type': 'Question', name: 'Do you serve Heritage Lake and Clinton Keith Estates neighborhoods in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we work throughout Wildomar including Heritage Lake, Palomar Hills, Clinton Keith Estates, and properties along the California Oaks Road corridor. We know the community character and common HOA guidelines in these neighborhoods and can help you design a yard that looks great within any community restrictions." } },
    { '@type': 'Question', name: 'What plants thrive on Wildomar hillside properties?', acceptedAnswer: { '@type': 'Answer', text: "For Wildomar's hillside lots, we recommend drought-adapted groundcovers like Ceanothus (California lilac), Salvia clevelandii (Cleveland sage), Arctostaphylos (manzanita), and Echium candicans (pride of Madeira). These plants establish deep roots that anchor sloped soil, require minimal water once established, and provide significant visual interest with seasonal blooms." } },
  ],
};
---

<BaseLayout
  title="Landscaping Wildomar, CA | Lawn Care & Yard Design | Free Consultation"
  description="Professional landscaping and lawn care in Wildomar, CA. Drought-tolerant designs, irrigation installation, and seasonal cleanup. Free consultations."
  canonicalUrl="https://landscapingmurrieta.com/wildomar/"
>
  <Hero
    headline="Landscaping & Lawn Care in Wildomar, CA"
    subheadline="Custom landscape design, lawn maintenance, and irrigation for Wildomar homeowners. Drought-smart, HOA-compliant, and built for inland SoCal. Free consultations."
    ctaText="Get a Free Consultation"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Landscaping Services in Wildomar</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      We design and maintain beautiful yards throughout Wildomar — water-smart, HOA-compliant, and built for inland SoCal's warm climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Landscaping for Wildomar's Growing Communities</h2>
      <p>
        Wildomar incorporated in 2008 and has grown steadily since — most of its residential neighborhoods were built between 2000 and 2015, which means many homes are reaching the point where the original builder landscaping needs a serious upgrade. Typical builder installs are minimal by design: a strip of sod, a few starter shrubs, and a basic sprinkler timer. They're not designed to last or to look great. We specialize in taking that foundation and turning it into an intentional, low-maintenance yard that actually fits Wildomar's climate and your lifestyle.
      </p>
      <p>
        Wildomar's soils tend toward clay-heavy, which drains slowly and compacts under foot traffic. This matters enormously for irrigation design — clay soil needs slower water delivery to avoid runoff, and lawns planted without proper soil amendment struggle from the start. We assess soil conditions before designing so we're solving the actual problem, not just applying generic solutions.
      </p>

      <h2>Water-Smart Designs for Wildomar Homeowners</h2>
      <p>
        Wildomar is served by the Elsinore Valley Municipal Water District (EVMWD), which uses tiered pricing similar to other inland SoCal water districts — the more water you use, the more you pay per unit. A traditional lawn can push a Wildomar household into higher tiers during summer, adding $80–$150/month to water bills. Drought-tolerant landscaping combined with properly designed drip irrigation can cut outdoor water use by 40–60%, often paying for the upgrade within a few years.
      </p>
      <p>
        We design around California native plants and drought-adapted Mediterranean species that thrive in Wildomar's warm, dry summers without demanding constant irrigation. Once established, many of these plants require minimal supplemental water beyond natural rainfall.
      </p>

      <h2>Serving All Wildomar Neighborhoods</h2>
      <p>
        We landscape homes throughout Wildomar, including properties along the Bundy Canyon Road corridor, The Farm community, neighborhoods adjacent to Tuscany Hills, and the newer developments near Clinton Keith Road and Palomar Street. We're familiar with HOA requirements in Wildomar's master-planned communities and can handle all documentation and plan submissions on your behalf.
      </p>

      <h2>Why Choose a Local Murrieta/Wildomar Landscaper</h2>
      <p>
        We're locally based in the Murrieta/Temecula Valley — not a franchise or regional chain that sends different crews each time. Our team knows Wildomar's soil conditions, microclimates, and HOA requirements. We provide free on-site consultations, written project proposals with itemized pricing, and realistic timelines before any work begins. Every project comes with a satisfaction guarantee: if something doesn't look right, we come back and fix it.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Temecula Valley</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Landscaping in Wildomar</h2>
    <div class="space-y-4">
      {[
        { q: "Can you landscape hillside lots in Wildomar?", a: "Yes — hillside landscaping is one of our specialties in Wildomar. We work with sloped terrain throughout Heritage Lake, Palomar Hills, and Clinton Keith Estates. Our hillside designs address erosion control, proper drainage, and plant selection for slopes. We use deep-rooted native groundcovers, terracing, and decomposed granite paths to create beautiful, stable landscapes on challenging lots." },
        { q: "How do you handle Wildomar's clay soil in landscape projects?", a: "Wildomar's heavy clay soils drain poorly and compact easily, which limits plant choices and irrigation design. We amend clay soil with organic compost and gypsum to improve structure, install raised planting beds where deep drainage is needed, and select plants that tolerate wet winters and dry summers on clay. Getting the soil preparation right is the foundation of a successful landscape on Wildomar's clay." },
        { q: "Do you serve Heritage Lake and Clinton Keith Estates neighborhoods in Wildomar?", a: "Yes — we work throughout Wildomar including Heritage Lake, Palomar Hills, Clinton Keith Estates, and properties along the California Oaks Road corridor. We know the community character and common HOA guidelines in these neighborhoods and can help you design a yard that looks great within any community restrictions." },
        { q: "What plants thrive on Wildomar hillside properties?", a: "For Wildomar's hillside lots, we recommend drought-adapted groundcovers like Ceanothus (California lilac), Salvia clevelandii (Cleveland sage), Arctostaphylos (manzanita), and Echium candicans (pride of Madeira). These plants establish deep roots that anchor sloped soil, require minimal water once established, and provide significant visual interest with seasonal blooms." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Schedule Your Free Landscaping Consultation in Wildomar" />
  </section>
</BaseLayout>
