---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';
---

<BaseLayout
  title="Landscaping Wildomar, CA | Lawn Care & Yard Design | Free Consultation"
  description="Professional landscaping and lawn care in Wildomar, CA. Drought-tolerant designs, irrigation installation, and seasonal cleanup. Free consultations."
  canonicalUrl="https://landscapingmurrieta.com/wildomar/"
>
  <Hero
    headline="Landscaping & Lawn Care in Wildomar, CA"
    subheadline="Custom landscape design, lawn maintenance, and irrigation for Wildomar homeowners. Drought-smart, HOA-compliant, and built for inland SoCal. Free consultations."
    ctaText="Get a Free Consultation"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Landscaping Services in Wildomar</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      We design and maintain beautiful yards throughout Wildomar — water-smart, HOA-compliant, and built for inland SoCal's warm climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Landscaping for Wildomar's Growing Communities</h2>
      <p>
        Wildomar incorporated in 2008 and has grown steadily since — most of its residential neighborhoods were built between 2000 and 2015, which means many homes are reaching the point where the original builder landscaping needs a serious upgrade. Typical builder installs are minimal by design: a strip of sod, a few starter shrubs, and a basic sprinkler timer. They're not designed to last or to look great. We specialize in taking that foundation and turning it into an intentional, low-maintenance yard that actually fits Wildomar's climate and your lifestyle.
      </p>
      <p>
        Wildomar's soils tend toward clay-heavy, which drains slowly and compacts under foot traffic. This matters enormously for irrigation design — clay soil needs slower water delivery to avoid runoff, and lawns planted without proper soil amendment struggle from the start. We assess soil conditions before designing so we're solving the actual problem, not just applying generic solutions.
      </p>

      <h2>Water-Smart Designs for Wildomar Homeowners</h2>
      <p>
        Wildomar is served by the Elsinore Valley Municipal Water District (EVMWD), which uses tiered pricing similar to other inland SoCal water districts — the more water you use, the more you pay per unit. A traditional lawn can push a Wildomar household into higher tiers during summer, adding $80–$150/month to water bills. Drought-tolerant landscaping combined with properly designed drip irrigation can cut outdoor water use by 40–60%, often paying for the upgrade within a few years.
      </p>
      <p>
        We design around California native plants and drought-adapted Mediterranean species that thrive in Wildomar's warm, dry summers without demanding constant irrigation. Once established, many of these plants require minimal supplemental water beyond natural rainfall.
      </p>

      <h2>Serving All Wildomar Neighborhoods</h2>
      <p>
        We landscape homes throughout Wildomar, including properties along the Bundy Canyon Road corridor, The Farm community, neighborhoods adjacent to Tuscany Hills, and the newer developments near Clinton Keith Road and Palomar Street. We're familiar with HOA requirements in Wildomar's master-planned communities and can handle all documentation and plan submissions on your behalf.
      </p>

      <h2>Why Choose a Local Murrieta/Wildomar Landscaper</h2>
      <p>
        We're locally based in the Murrieta/Temecula Valley — not a franchise or regional chain that sends different crews each time. Our team knows Wildomar's soil conditions, microclimates, and HOA requirements. We provide free on-site consultations, written project proposals with itemized pricing, and realistic timelines before any work begins. Every project comes with a satisfaction guarantee: if something doesn't look right, we come back and fix it.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Temecula Valley</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Schedule Your Free Landscaping Consultation in Wildomar" />
  </section>
</BaseLayout>
