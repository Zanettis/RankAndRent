---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does HomeAdvisor sell your contact info when you request landscaping quotes?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. HomeAdvisor (now merged with Angi) sells your contact information to typically 3–5 contractors the moment you submit a landscaping request. Each contractor pays for the lead, which means multiple companies receive your name, phone number, and email simultaneously — whether or not you want to hear from all of them.' },
    },
    {
      '@type': 'Question',
      name: 'What license does a landscaping contractor need in California?',
      acceptedAnswer: { '@type': 'Answer', text: 'In California, landscaping contractors performing work over $500 in labor and materials must hold a C-27 Landscaping Contractor license issued by the California Contractors State License Board (CSLB). You can verify any contractor\'s C-27 license status at cslb.ca.gov before signing a contract.' },
    },
    {
      '@type': 'Question',
      name: "What's the best HomeAdvisor alternative for landscaping in Murrieta, CA?",
      acceptedAnswer: { '@type': 'Answer', text: "For Murrieta homeowners, the best alternative is contacting a local C-27 licensed landscaping specialist directly — someone who works in Southwest Riverside County and understands Murrieta's expansive clay soil, EVMWD and RCWD water restrictions, and local HOA requirements. A local specialist can provide a free on-site consultation without distributing your contact information to multiple contractors." },
    },
    {
      '@type': 'Question',
      name: "How do I know if a landscaper knows Murrieta's EVMWD or RCWD water restrictions?",
      acceptedAnswer: { '@type': 'Answer', text: "Ask the contractor directly whether they're familiar with Eastern Municipal Water District (EVMWD) or Rancho California Water District (RCWD) watering schedules and rebate programs. A knowledgeable local landscaper will be able to discuss specific watering day restrictions, turf removal rebates, and EPA WaterSense-certified irrigation equipment without being prompted." },
    },
    {
      '@type': 'Question',
      name: 'Is Thumbtack good for finding landscapers in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: 'Thumbtack works reasonably well for simple recurring maintenance like lawn mowing and basic cleanup, where local knowledge is less critical. For full landscape redesigns, drought-tolerant conversions, or HOA-restricted projects in Murrieta, a platform-matched contractor is unlikely to have the specific local expertise your project requires.' },
    },
    {
      '@type': 'Question',
      name: 'Does Murrieta Landscaping share my contact information with other companies?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. When you contact Murrieta Landscaping through our website or by phone, your information stays with our company only. We do not sell, share, or distribute your contact details to other contractors or third-party services.' },
    },
  ],
};
---

<BaseLayout
  title="Best HomeAdvisor Alternatives for Landscaping in Murrieta, CA (2025)"
  description="Tired of HomeAdvisor selling your info to multiple landscapers? Compare the best alternatives for landscaping in Murrieta, CA — local specialists, Thumbtack, Yelp, Google LSAs, and more."
  canonicalUrl="https://landscapingmurrieta.com/homeadvisor-alternatives/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-primary text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Best HomeAdvisor Alternatives for Landscaping in Murrieta, CA
      </h1>
      <p class="text-xl text-white/85 max-w-2xl mx-auto">
        You need a landscaper who knows Murrieta's water restrictions, clay soil, and HOA rules — not a national platform that connects you with whoever paid for the lead.
      </p>
    </div>
  </section>

  <!-- Why People Search for Alternatives -->
  <section class="max-w-4xl mx-auto px-4 py-14">
    <div class="prose prose-lg max-w-none prose-headings:text-primary text-gray-700">
      <h2>Why Murrieta Homeowners Look for HomeAdvisor Alternatives for Landscaping</h2>
      <p>
        HomeAdvisor and Angi (same company since 2021) operate as a lead auction. When you submit a request for landscaping, your contact information is immediately sold to three to five contractors who each paid for the right to contact you. The first contractor to call you wins the job more often than the best contractor does.
      </p>
      <p>
        For landscaping in Murrieta specifically, this model creates real problems. Landscaping in Southwest Riverside County requires knowledge that a random contractor from outside the area simply won't have:
      </p>
      <ul>
        <li>EVMWD and RCWD water restrictions that affect irrigation system design and watering schedules</li>
        <li>Murrieta's clay-heavy, expansive soil that affects plant selection, drainage, and root growth</li>
        <li>HOA guidelines in communities like Greer Ranch, Spencer's Crossing, and California Oaks that restrict plant types, colors, and hardscape materials</li>
        <li>Drought-tolerant plant species that actually survive inland SoCal summers versus those that just look good in a showroom photo</li>
        <li>Riverside County permit requirements for certain retaining walls, grading, and drainage modifications</li>
      </ul>
      <p>
        A contractor matched through HomeAdvisor from Riverside or San Bernardino may have no experience with EVMWD rebate programs or what landscaping styles local HOAs will approve. Here are the best alternatives that actually serve Murrieta homeowners well.
      </p>
    </div>
  </section>

  <!-- What to Look For -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-primary mb-6">What to Look For in a Landscaping Alternative</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          { title: 'California C-27 Landscaping License', body: 'California requires a C-27 landscaping contractor license for most landscaping work. Verify at the CSLB website before signing any contract.' },
          { title: 'Inland SoCal Experience', body: 'Your landscaper should know Murrieta\'s soil type (expansive clay), heat levels, and EVMWD/RCWD water rules — not just general Southern California landscaping.' },
          { title: 'HOA Familiarity', body: 'Many Murrieta communities have strict landscaping guidelines. Your contractor should ask about HOA requirements before designing or proposing plant palettes.' },
          { title: 'Drought-Tolerant Plant Knowledge', body: 'With ongoing water restrictions, you want a landscaper who can specify plants that thrive in our climate with minimal irrigation — not turf-heavy designs that fail in summer.' },
          { title: 'Free On-Site Consultation', body: 'Landscaping cannot be quoted from photos or descriptions alone. Any legitimate landscaping company will send someone to your property before giving a price.' },
          { title: 'Irrigation System Expertise', body: 'In Murrieta\'s climate, irrigation design is critical. Look for contractors familiar with smart controllers, drip systems, and EVMWD rebate-eligible equipment.' },
        ].map(item => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <h3 class="font-bold text-primary mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Alternatives -->
  <section class="max-w-4xl mx-auto px-4 py-14">
    <h2 class="text-3xl font-bold text-primary mb-2">6 HomeAdvisor Alternatives for Landscaping in Murrieta</h2>
    <p class="text-gray-600 mb-10">Ranked from most to least recommended for Murrieta homeowners specifically.</p>

    <!-- Option 1 -->
    <div class="border-2 border-primary rounded-2xl p-7 mb-8 bg-primary/5">
      <div class="flex items-start gap-4 mb-4">
        <span class="bg-primary text-white font-bold text-lg rounded-full w-10 h-10 flex items-center justify-center shrink-0">1</span>
        <div>
          <h3 class="text-2xl font-bold text-primary">Murrieta Landscaping — Local Specialist</h3>
          <p class="text-green-700 font-semibold text-sm mt-1">Best Overall for Murrieta Homeowners</p>
        </div>
      </div>
      <p class="text-gray-700 mb-4">
        Murrieta Landscaping is a locally based landscaping company specializing in Murrieta, Temecula, and Southwest Riverside County. We work with homeowners on landscape design, lawn care, irrigation systems, and seasonal cleanup — all with full knowledge of EVMWD/RCWD water restrictions, local soil conditions, and HOA norms.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Pros</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ Your contact info is never sold or shared</li>
            <li>✓ Deep Murrieta-specific knowledge: soil, water, HOA</li>
            <li>✓ CA licensed (C-27) and fully insured</li>
            <li>✓ Free on-site consultations — no obligation</li>
            <li>✓ Drought-tolerant design expertise for inland SoCal</li>
            <li>✓ EVMWD/RCWD rebate-eligible irrigation systems</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Cons</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>— Serves Southwest Riverside County only</li>
            <li>— May have 1–2 week wait for design consultations during peak season (spring/fall)</li>
          </ul>
        </div>
      </div>
      <p class="text-sm text-gray-600 font-medium">
        <span class="font-bold text-primary">Best for:</span> Murrieta homeowners wanting landscape design, lawn maintenance, irrigation, or seasonal cleanup from one local company that knows the area.
      </p>
    </div>

    <!-- Option 2 -->
    <div class="border border-gray-200 rounded-2xl p-7 mb-8">
      <div class="flex items-start gap-4 mb-4">
        <span class="bg-gray-200 text-gray-700 font-bold text-lg rounded-full w-10 h-10 flex items-center justify-center shrink-0">2</span>
        <div>
          <h3 class="text-2xl font-bold text-gray-800">Thumbtack</h3>
          <p class="text-gray-500 text-sm mt-1">Aggregator with contractor profiles and bids</p>
        </div>
      </div>
      <p class="text-gray-700 mb-4">
        Thumbtack is a competitor to HomeAdvisor that allows contractors to submit quotes on your project. Unlike HomeAdvisor, you can browse contractor profiles before they contact you. For landscaping, this can be useful for comparing prices on routine lawn maintenance — though the local knowledge problem remains.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Pros</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ Can read contractor profiles and reviews before being contacted</li>
            <li>✓ Useful for recurring maintenance (weekly lawn care, etc.)</li>
            <li>✓ Price comparison is easier than calling individually</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Cons</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>— Your info still goes to multiple contractors via bids</li>
            <li>— Difficult to assess whether contractors know Murrieta's specific requirements</li>
            <li>— License verification is your responsibility</li>
          </ul>
        </div>
      </div>
      <p class="text-sm text-gray-600">
        <span class="font-bold text-gray-800">Best for:</span> Simple recurring maintenance (lawn mowing, basic cleanup) where local knowledge is less critical.
      </p>
    </div>

    <!-- Option 3 -->
    <div class="border border-gray-200 rounded-2xl p-7 mb-8">
      <div class="flex items-start gap-4 mb-4">
        <span class="bg-gray-200 text-gray-700 font-bold text-lg rounded-full w-10 h-10 flex items-center justify-center shrink-0">3</span>
        <div>
          <h3 class="text-2xl font-bold text-gray-800">Google Local Services Ads (LSAs)</h3>
          <p class="text-gray-500 text-sm mt-1">Google-verified contractors</p>
        </div>
      </div>
      <p class="text-gray-700 mb-4">
        Google's Local Services Ads verify background checks, licensing, and insurance for participating contractors. Searching "landscaping near me" on Google may surface LSA-badged companies you can call directly. It's one of the few platforms where Google itself has vetted the contractor's credentials.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Pros</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ Google verifies license and insurance independently</li>
            <li>✓ "Google Guaranteed" offers consumer protection on the job</li>
            <li>✓ Direct contact — your info isn't auctioned</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Cons</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>— Limited number of Murrieta landscapers participate</li>
            <li>— Google doesn't verify local knowledge or specialty expertise</li>
            <li>— Availability fluctuates with who's running ads</li>
          </ul>
        </div>
      </div>
      <p class="text-sm text-gray-600">
        <span class="font-bold text-gray-800">Best for:</span> Homeowners who prioritize credential verification and want to call directly without going through an aggregator form.
      </p>
    </div>

    <!-- Option 4 -->
    <div class="border border-gray-200 rounded-2xl p-7 mb-8">
      <div class="flex items-start gap-4 mb-4">
        <span class="bg-gray-200 text-gray-700 font-bold text-lg rounded-full w-10 h-10 flex items-center justify-center shrink-0">4</span>
        <div>
          <h3 class="text-2xl font-bold text-gray-800">Nextdoor</h3>
          <p class="text-gray-500 text-sm mt-1">Neighborhood recommendations from verified residents</p>
        </div>
      </div>
      <p class="text-gray-700 mb-4">
        Nextdoor is a neighborhood social network where Murrieta homeowners share contractor recommendations by subdivision. Searching for a landscaper used by neighbors in your specific community (Greer Ranch, Spencer's Crossing, Copper Canyon) often surfaces people with real local experience in your HOA's specific requirements.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Pros</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ Recommendations from neighbors with the same HOA rules and soil conditions</li>
            <li>✓ Real reviews — not gameable like Yelp or Google</li>
            <li>✓ Your info is not shared with contractors unless you choose to contact them</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Cons</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>— No license verification built in</li>
            <li>— Results are limited to who's been recommended recently</li>
            <li>— Hard to compare prices or services systematically</li>
          </ul>
        </div>
      </div>
      <p class="text-sm text-gray-600">
        <span class="font-bold text-gray-800">Best for:</span> Finding landscapers with proven experience in your specific Murrieta neighborhood or HOA.
      </p>
    </div>

    <!-- Option 5 -->
    <div class="border border-gray-200 rounded-2xl p-7 mb-8">
      <div class="flex items-start gap-4 mb-4">
        <span class="bg-gray-200 text-gray-700 font-bold text-lg rounded-full w-10 h-10 flex items-center justify-center shrink-0">5</span>
        <div>
          <h3 class="text-2xl font-bold text-gray-800">Local Nurseries & Hardware Stores</h3>
          <p class="text-gray-500 text-sm mt-1">Word-of-mouth from people who know the trade</p>
        </div>
      </div>
      <p class="text-gray-700 mb-4">
        Murrieta area nurseries and hardware stores (Armstrong Garden Centers, SummerWinds, and local independent nurseries in Temecula) often know which landscaping contractors use quality plants, ask the right questions about soil and irrigation, and do professional work. Asking a nursery staff member for a recommendation is an underrated shortcut.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Pros</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ Nurseries see which contractors buy quality plants and materials</li>
            <li>✓ Completely free, zero info shared</li>
            <li>✓ Recommendations often reflect actual work quality, not marketing budgets</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Cons</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>— Limited to whoever has recently shopped at that nursery</li>
            <li>— No license or insurance verification</li>
            <li>— Inconsistent availability of good referrals</li>
          </ul>
        </div>
      </div>
      <p class="text-sm text-gray-600">
        <span class="font-bold text-gray-800">Best for:</span> Homeowners doing a full landscape redesign who want plant-knowledgeable contractors.
      </p>
    </div>

    <!-- Option 6 -->
    <div class="border border-gray-200 rounded-2xl p-7 mb-8">
      <div class="flex items-start gap-4 mb-4">
        <span class="bg-gray-200 text-gray-700 font-bold text-lg rounded-full w-10 h-10 flex items-center justify-center shrink-0">6</span>
        <div>
          <h3 class="text-2xl font-bold text-gray-800">Direct Google Search + CSLB Verification</h3>
          <p class="text-gray-500 text-sm mt-1">No intermediary — full control</p>
        </div>
      </div>
      <p class="text-gray-700 mb-4">
        Searching "landscaping company Murrieta" on Google and calling businesses directly bypasses every platform. Verify each contractor's C-27 license at the California Contractors State License Board website. It takes more effort but gives you full control over who you contact.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Pros</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>✓ No aggregator — you decide who gets your contact info</li>
            <li>✓ Companies with strong organic rankings have invested in local presence</li>
            <li>✓ CSLB C-27 lookup is free and takes two minutes</li>
          </ul>
        </div>
        <div>
          <h4 class="font-bold text-gray-800 mb-2">Cons</h4>
          <ul class="text-sm text-gray-600 space-y-1">
            <li>— You must verify license, insurance, and HOA experience yourself</li>
            <li>— More phone calls required to compare options</li>
          </ul>
        </div>
      </div>
      <p class="text-sm text-gray-600">
        <span class="font-bold text-gray-800">Best for:</span> Detail-oriented homeowners who want to do thorough due diligence before hiring.
      </p>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="bg-gray-50 py-14 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-primary text-center mb-10">Side-by-Side Comparison</h2>
      <div class="overflow-x-auto rounded-xl shadow">
        <table class="w-full text-sm bg-white">
          <thead>
            <tr class="bg-primary text-white">
              <th class="px-4 py-3 text-left font-bold">Platform / Option</th>
              <th class="px-4 py-3 text-center font-bold">Sells Your Info?</th>
              <th class="px-4 py-3 text-center font-bold">Murrieta Local</th>
              <th class="px-4 py-3 text-center font-bold">License Verified</th>
              <th class="px-4 py-3 text-center font-bold">Free Estimate</th>
              <th class="px-4 py-3 text-center font-bold">HOA Knowledge</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <tr class="bg-primary/5">
              <td class="px-4 py-3 font-bold text-primary">Murrieta Landscaping</td>
              <td class="px-4 py-3 text-center text-green-600 font-bold">No</td>
              <td class="px-4 py-3 text-center text-green-600 font-bold">Yes</td>
              <td class="px-4 py-3 text-center text-green-600 font-bold">Yes (C-27)</td>
              <td class="px-4 py-3 text-center text-green-600 font-bold">Yes, on-site</td>
              <td class="px-4 py-3 text-center text-green-600 font-bold">Yes</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-gray-700">HomeAdvisor / Angi</td>
              <td class="px-4 py-3 text-center text-red-500">Yes (3–5)</td>
              <td class="px-4 py-3 text-center text-yellow-600">Partial</td>
              <td class="px-4 py-3 text-center text-yellow-600">Partial</td>
              <td class="px-4 py-3 text-center text-yellow-600">Varies</td>
              <td class="px-4 py-3 text-center text-red-500">Unlikely</td>
            </tr>
            <tr class="bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-700">Thumbtack</td>
              <td class="px-4 py-3 text-center text-red-500">Yes (bids)</td>
              <td class="px-4 py-3 text-center text-yellow-600">Partial</td>
              <td class="px-4 py-3 text-center text-yellow-600">Partial</td>
              <td class="px-4 py-3 text-center text-yellow-600">Varies</td>
              <td class="px-4 py-3 text-center text-yellow-600">Varies</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-medium text-gray-700">Google LSAs</td>
              <td class="px-4 py-3 text-center text-green-600">No</td>
