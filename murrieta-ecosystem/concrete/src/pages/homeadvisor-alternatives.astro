---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does HomeAdvisor sell your contact info for concrete project requests?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. HomeAdvisor (now merged with Angi) distributes your project request to typically 3–5 contractors immediately after you submit a form. Each contractor pays for the lead, so multiple companies receive your contact information at once. For high-dollar concrete projects, this often results in aggressive follow-up from contractors who have never seen your property.' },
    },
    {
      '@type': 'Question',
      name: 'What license does a concrete contractor need in California?',
      acceptedAnswer: { '@type': 'Answer', text: 'Concrete contractors in California must hold a C-8 Concrete Contractor specialty license issued by the California Contractors State License Board (CSLB). You can verify any contractor\'s C-8 license status at cslb.ca.gov. Always confirm that the license is current and that the contractor carries both general liability insurance and workers\' compensation coverage.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need a permit for a concrete driveway in Murrieta, CA?',
      acceptedAnswer: { '@type': 'Answer', text: 'In most cases, yes. The City of Murrieta and Riverside County require permits for new driveway construction, major driveway replacements, and some patio additions. A legitimate licensed contractor will address permit requirements during the estimate and include permit costs in their proposal. Be cautious of contractors who suggest skipping permits — unpermitted concrete work can create issues when you sell your home.' },
    },
    {
      '@type': 'Question',
      name: 'Why does concrete crack in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: "Murrieta sits on expansive clay soil that swells when wet and contracts in dry heat. Without proper base preparation — typically 4–6 inches of compacted aggregate base — and correctly spaced expansion joints, concrete slabs will crack as the soil moves seasonally. A contractor familiar with Murrieta's soil conditions will spec the base depth and joint spacing accordingly." },
    },
    {
      '@type': 'Question',
      name: 'What is the best way to find a concrete contractor in Murrieta without HomeAdvisor?',
      acceptedAnswer: { '@type': 'Answer', text: 'Search "concrete contractor Murrieta" on Google and call businesses from the organic results directly. Then verify each contractor\'s C-8 license at the CSLB website before scheduling a site visit. Ask specifically about base preparation for expansive clay soil, permit handling, and whether they have experience working with local HOAs. Require a free written on-site estimate before committing.' },
    },
    {
      '@type': 'Question',
      name: 'Does Murrieta Concrete Works share my contact information with other companies?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. When you contact Murrieta Concrete Works through our website or by phone, your information stays with our company only. We do not sell, share, or distribute your contact details to other contractors or third-party services.' },
    },
  ],
};
---

<BaseLayout
  title="Best HomeAdvisor Alternatives for Concrete Work in Murrieta, CA (2025)"
  description="Don't let HomeAdvisor sell your driveway or patio project to 5 random contractors. Compare the best alternatives for concrete work in Murrieta, CA — local specialists, Thumbtack, Google LSAs, and more."
  canonicalUrl="https://murrietaconcreteworks.com/homeadvisor-alternatives/"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-primary text-white py-16 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">
        Best HomeAdvisor Alternatives for Concrete Work in Murrieta, CA
      </h1>
      <p class="text-xl text-white/85 max-w-2xl mx-auto">
        Concrete projects are high-dollar and permanent. Here's how to find a real Murrieta concrete contractor — without handing your project over to a lead auction.
      </p>
    </div>
  </section>

  <!-- Why People Search for Alternatives -->
  <section class="max-w-4xl mx-auto px-4 py-14">
    <div class="prose prose-lg max-w-none prose-headings:text-primary text-gray-700">
      <h2>Why Murrieta Homeowners Look for HomeAdvisor Alternatives for Concrete</h2>
      <p>
        Concrete work is among the most expensive and permanent improvements a Murrieta homeowner can make. A driveway replacement runs $5,000–$15,000. A poured concrete patio with stamped finish can exceed $20,000. These are not jobs where you want to hire whoever called you first from a lead auction.
      </p>
      <p>
        HomeAdvisor (now Angi) works by selling your contact information to multiple contractors the moment you submit your request. For concrete, this creates several specific problems in Murrieta:
      </p>
      <ul>
        <li>Quotes vary wildly because contractors haven't seen your property, your soil, or your existing grade</li>
        <li>Murrieta sits on expansive clay soil that moves seasonally — concrete that doesn't account for this will crack. Contractors from outside the area may not know this.</li>
        <li>Many Murrieta communities have HOA rules about driveway finishes, patio sizes, or color palettes — a contractor matched from 50 miles away won't know these</li>
        <li>Riverside County permits are often required for driveways, large patios, and retaining walls — unlicensed contractors may skip this step entirely</li>
        <li>You end up fielding five phone calls from unknown numbers rather than having one productive in-person assessment</li>
      </ul>
      <p>
        For a job this size and this permanent, the right contractor matters. Here are your best options in Murrieta.
      </p>
    </div>
  </section>

  <!-- What to Look For -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-primary mb-6">What to Look For in a Concrete Contractor Alternative</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          { title: 'California C-8 Concrete License', body: 'Concrete work in California requires a C-8 specialty contractor license. Verify at the CSLB before any contract is signed. Unlicensed concrete work is one of the top sources of homeowner disputes in Riverside County.' },
          { title: 'Murrieta Soil Knowledge', body: 'Murrieta\'s expansive clay soil swells in wet conditions and shrinks in heat. Without proper base preparation and expansion joint placement, concrete will crack within 2–5 years. Ask your contractor specifically how they handle expansive soil.' },
          { title: 'HOA Approval Experience', body: 'Many Murrieta HOAs require pre-approval for driveway replacements, patio additions, or retaining walls. A contractor who\'s worked in your community will know the submittal process and required specifications.' },
          { title: 'Riverside County Permit Knowledge', body: 'Driveways, patio covers, and retaining walls over a certain height require permits. Ask your contractor upfront if permits are included in their proposal and whether they handle the submittal.' },
          { title: 'Free On-Site Estimate', body: 'Concrete cannot be quoted without seeing the site. A contractor who quotes driveways over the phone is either guessing or planning to change the price on the day of the pour. Require an in-person written estimate.' },
          { title: 'Mix Design and Finish Specifics', body: 'Ask about PSI rating (3,000 vs. 4,000 PSI), rebar vs. wire mesh reinforcement, base compaction depth, and curing time. A knowledgeable contractor will discuss these without being prompted.' },
        ].map(item => (
          <div class="bg-white rounded-xl p-5 shadow-sm border border-gray-100">
            <h3 class="font-bold text-primary mb-2">{item.title}</h3>
            <p class="text-gray-600 text-sm leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Alternatives -->
  <section class="max-w-4xl mx-auto px-4 py-14">
    <h2 class="text-3xl font-bold text-primary mb-2">6 HomeAdvisor Alternatives for Concrete Work in Murrieta</h2>
    <p class="text-gray-600 mb-10">Ranked from most to least recommended for Murrieta homeowners specifically.</p>

    <!-- Option 1 -->
    <div class="border-2 border-primary rounded-2xl p-7 mb-8 bg-primary/5">
