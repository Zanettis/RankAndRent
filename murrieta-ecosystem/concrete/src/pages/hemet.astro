---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you pour concrete for large rural properties and agricultural outbuildings in Hemet?', acceptedAnswer: { '@type': 'Answer', text: "Yes — Hemet's agricultural properties, horse facilities, and rural estates are a regular part of our work. Barn aprons, shop floors, equipment pads, and agricultural slabs require different design considerations than residential driveways — heavier reinforcement, higher PSI concrete, drainage slopes, and sometimes thicker sections to handle equipment loads. We design and pour commercial-grade concrete for rural applications throughout the Hemet area." } },
    { '@type': 'Question', name: 'What\'s the typical cost for a concrete driveway in Hemet, CA?', acceptedAnswer: { '@type': 'Answer', text: "Concrete driveway costs in Hemet typically run $5–$11 per square foot for standard broom-finish concrete. A standard two-car driveway (400–500 sq ft) runs $2,200–$5,500. Long rural driveways (1,000+ sq ft) and agricultural slabs are priced by the square foot with site visit required. We provide free written estimates — phone quotes aren't accurate because site conditions vary significantly in Hemet." } },
    { '@type': 'Question', name: "How does Hemet's summer heat affect concrete curing and quality?", acceptedAnswer: { '@type': 'Answer', text: "Hemet's summer temperatures regularly exceed 105°F, which can cause rapid surface drying and shrinkage cracking if concrete isn't managed properly. We schedule pours for early morning when temperatures are lowest, apply curing compounds immediately after finishing, and use concrete mix designs with retarders in extreme heat. These steps prevent early cracking and ensure the concrete achieves its design strength." } },
    { '@type': 'Question', name: 'Do you repair concrete for older Hemet neighborhoods and senior communities?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we work throughout Hemet's established neighborhoods, including senior communities like Four Seasons. Many older Hemet driveways and sidewalks have concrete that has cracked from tree roots, soil settlement, or simply age. We assess whether partial repair (panel replacement) or full replacement is the better value — and we never recommend full replacement when repair is the honest answer." } },
  ],
};
---

<BaseLayout
  title="Concrete Contractor Hemet, CA | Driveways, Patios & Repair | Free Estimates"
  description="Licensed concrete contractor serving Hemet, CA. Driveway repair and replacement, patio installation, concrete repair, and decorative stamped concrete. Honest pricing for Hemet homeowners. Free estimates."
  canonicalUrl="https://murrietaconcreteworks.com/hemet/"
>
  <Hero
    headline="Concrete Driveways & Patios in Hemet, CA"
    subheadline="Licensed concrete contractors serving all of Hemet. Driveway repair and replacement, patios, walkways, decorative stamped concrete — quality work at honest prices. Free estimates, no pressure."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Concrete Services in Hemet</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From cracked driveways in Hemet's older neighborhoods to new patio installs throughout the San Jacinto Valley, we deliver quality concrete work — licensed, permitted, and guaranteed.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Concrete Repair for Hemet's Aging Driveways and Walkways</h2>
      <p>
        Hemet has a large stock of older homes — many built in the 1970s and 1980s — where driveways, sidewalks, and patio slabs are now 30–50 years old and showing significant cracking, heaving, and surface deterioration. The San Jacinto Valley's clay-heavy soils expand and contract with seasonal moisture changes, and that movement is one of the primary causes of premature concrete failure in this area. We specialize in both targeted repair — filling and stabilizing cracks before they become full slab failures — and complete driveway replacement when repair is no longer cost-effective.
      </p>

      <h2>Honest Pricing for Hemet Homeowners</h2>
      <p>
        We understand that Hemet is a community where value matters. We don't inflate estimates, we don't upsell work that isn't necessary, and we give you a clear, written breakdown of what the job will cost before we start. If a crack can be repaired rather than replaced, we'll tell you that — even if replacement would be more profitable for us. Our goal is to earn repeat business and referrals from Hemet homeowners, and that only happens when we do right by you the first time.
      </p>

      <h2>New Patio and Walkway Installation in Hemet</h2>
      <p>
        Many Hemet homeowners are adding covered patios, backyard slabs, and decorative walkways as outdoor living upgrades. Stamped concrete is a particularly popular option in Hemet — it gives the look of stone or brick at a fraction of the material cost, and it holds up well in the San Jacinto Valley's climate. We offer a full range of decorative concrete options, including stamped patterns, stained finishes, and exposed aggregate, and can match or complement existing concrete on your property.
      </p>

      <h2>Serving All Hemet Neighborhoods</h2>
      <p>
        We pour and repair concrete throughout Hemet, including East Hemet, Valle Vista, Seven Hills, the Ramona Bowl area, and neighborhoods along Florida Avenue, Stetson Avenue, and Sanderson Avenue. We also serve properties in the surrounding unincorporated Riverside County areas. All work is permitted through the City of Hemet or Riverside County as required. Free estimates available anywhere in Hemet — no travel fee.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Hemet', 'Perris'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Concrete in Hemet</h2>
    <div class="space-y-4">
      {[
        { q: "Do you pour concrete for large rural properties and agricultural outbuildings in Hemet?", a: "Yes — Hemet's agricultural properties, horse facilities, and rural estates are a regular part of our work. Barn aprons, shop floors, equipment pads, and agricultural slabs require different design considerations than residential driveways — heavier reinforcement, higher PSI concrete, drainage slopes, and sometimes thicker sections to handle equipment loads. We design and pour commercial-grade concrete for rural applications throughout the Hemet area." },
        { q: "What's the typical cost for a concrete driveway in Hemet, CA?", a: "Concrete driveway costs in Hemet typically run $5–$11 per square foot for standard broom-finish concrete. A standard two-car driveway (400–500 sq ft) runs $2,200–$5,500. Long rural driveways (1,000+ sq ft) and agricultural slabs are priced by the square foot with site visit required. We provide free written estimates — phone quotes aren't accurate because site conditions vary significantly in Hemet." },
        { q: "How does Hemet's summer heat affect concrete curing and quality?", a: "Hemet's summer temperatures regularly exceed 105°F, which can cause rapid surface drying and shrinkage cracking if concrete isn't managed properly. We schedule pours for early morning when temperatures are lowest, apply curing compounds immediately after finishing, and use concrete mix designs with retarders in extreme heat. These steps prevent early cracking and ensure the concrete achieves its design strength." },
        { q: "Do you repair concrete for older Hemet neighborhoods and senior communities?", a: "Yes — we work throughout Hemet's established neighborhoods, including senior communities like Four Seasons. Many older Hemet driveways and sidewalks have concrete that has cracked from tree roots, soil settlement, or simply age. We assess whether partial repair (panel replacement) or full replacement is the better value — and we never recommend full replacement when repair is the honest answer." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Concrete Estimate in Hemet" />
  </section>
</BaseLayout>
