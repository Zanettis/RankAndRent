---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Can you pour concrete on sloped or hillside lots in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: "Yes — sloped driveways and hillside concrete work are common in Wildomar, especially in Heritage Lake, Palomar Hills, and properties along the Clinton Keith Road corridor. Sloped driveways require proper grading, drainage channels, and thicker slab sections in some areas. We design sloped pours to direct water away from structures and prevent ponding. All quotes account for site-specific slope conditions." } },
    { '@type': 'Question', name: "How does Wildomar's clay soil cause concrete problems?", acceptedAnswer: { '@type': 'Answer', text: "Wildomar's clay soils expand when wet (winter rains) and shrink when dry (summer heat). This cyclic movement puts stress on concrete slabs from below, eventually causing cracking and lifting. We counteract this by removing clay and replacing it with compactable road base material under all slabs, using heavier reinforcement (3/8\" rebar), and thickening edges to resist uplift forces. Getting the base right is the most important part of any Wildomar concrete job." } },
    { '@type': 'Question', name: 'Do you serve Heritage Lake and Palomar Hills communities in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we work throughout Wildomar including Heritage Lake, Palomar Hills, and properties along Clinton Keith Road, Grand Avenue, and Palomar Road. We understand the access constraints on Wildomar's hillside lots and factor in equipment positioning and concrete truck access when quoting your project. We visit every site before providing a written estimate." } },
    { '@type': 'Question', name: "What's the typical cost for a concrete driveway replacement in Wildomar?", acceptedAnswer: { '@type': 'Answer', text: "A standard two-car concrete driveway replacement in Wildomar typically runs $3,500–$7,500, including demolition, base preparation, rebar reinforcement, concrete pour, and broom finish. Sloped driveways, decorative finishes, or sites with limited equipment access run higher. We provide free written on-site estimates — phone quotes aren't reliable because every site is different." } },
  ],
};
---

<BaseLayout
  title="Concrete Contractor Wildomar, CA | Driveways, Patios & Walkways | Free Estimates"
  description="Licensed concrete contractor serving Wildomar, CA. Driveway installation and replacement, patio construction, walkways, and concrete repair. Hillside lot specialists. Serving Heritage Lake, Palomar Hills, and all Wildomar communities. Free estimates."
  canonicalUrl="https://murrietaconcreteworks.com/wildomar/"
>
  <Hero
    headline="Concrete Driveways & Patios in Wildomar, CA"
    subheadline="Licensed concrete contractors built for Wildomar's hillside lots and diverse terrain. New driveways, patios, retaining walls, walkways, and repair — free estimates, no travel fee."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Concrete Services in Wildomar</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      Wildomar's hillside properties and clay soils require a concrete contractor who understands local drainage, slope requirements, and long-term durability. That's exactly what we deliver.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Concrete on Wildomar's Hillside and Sloped Lots</h2>
      <p>
        Many Wildomar properties sit on hillside lots with significant grade changes between the street and the home. Driveways on sloped lots require careful attention to drainage, proper slope angle (typically 1–2%), and a mix design that handles surface runoff without eroding. We've poured driveways on steep Wildomar lots where standard contractors declined the job — our crews are experienced with sloped subgrade prep, drainage channel integration, and the extra forming work that hillside pours require.
      </p>

      <h2>Wildomar's Clay Soil Problem — and How We Solve It</h2>
      <p>
        Like most of Southwest Riverside County, Wildomar sits on expansive clay soils that move with the seasons. Wet winters cause clay to swell; dry summers cause it to shrink and crack. Concrete poured over improperly prepared clay will fail within a few years — slabs crack, heave, and settle unevenly. We address this with aggressive subgrade compaction, appropriate base material, and concrete mix design calibrated for Wildomar's soil conditions. This prep work adds a day to the project but adds decades to the result.
      </p>

      <h2>Serving All Wildomar Communities</h2>
      <p>
        We pour and repair concrete throughout Wildomar, including Heritage Lake, Palomar Hills, Clinton Keith Estates, and rural lots along Wildomar Trail and Bundy Canyon Road. We also serve unincorporated Riverside County properties adjacent to Wildomar. All work is fully permitted through Riverside County Building and Safety. Free on-site estimates available with no travel fee.
      </p>

      <h2>Patio Concrete for Wildomar's Outdoor Living</h2>
      <p>
        Wildomar's wide lots and rural character make it ideal for expanded outdoor living spaces. Many Wildomar homeowners are adding covered patio slabs, outdoor kitchen pads, and detached garage slabs that weren't part of the original construction. We handle the full project — design consultation, permit submittal, forming, pour, and finish — and coordinate with the County inspector so you never have to chase paperwork.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Concrete in Wildomar</h2>
    <div class="space-y-4">
      {[
        { q: "Can you pour concrete on sloped or hillside lots in Wildomar?", a: "Yes — sloped driveways and hillside concrete work are common in Wildomar, especially in Heritage Lake, Palomar Hills, and properties along the Clinton Keith Road corridor. Sloped driveways require proper grading, drainage channels, and thicker slab sections in some areas. We design sloped pours to direct water away from structures and prevent ponding. All quotes account for site-specific slope conditions." },
        { q: "How does Wildomar's clay soil cause concrete problems?", a: "Wildomar's clay soils expand when wet (winter rains) and shrink when dry (summer heat). This cyclic movement puts stress on concrete slabs from below, eventually causing cracking and lifting. We counteract this by removing clay and replacing it with compactable road base material under all slabs, using heavier reinforcement (3/8\" rebar), and thickening edges to resist uplift forces. Getting the base right is the most important part of any Wildomar concrete job." },
        { q: "Do you serve Heritage Lake and Palomar Hills communities in Wildomar?", a: "Yes — we work throughout Wildomar including Heritage Lake, Palomar Hills, and properties along Clinton Keith Road, Grand Avenue, and Palomar Road. We understand the access constraints on Wildomar's hillside lots and factor in equipment positioning and concrete truck access when quoting your project. We visit every site before providing a written estimate." },
        { q: "What's the typical cost for a concrete driveway replacement in Wildomar?", a: "A standard two-car concrete driveway replacement in Wildomar typically runs $3,500–$7,500, including demolition, base preparation, rebar reinforcement, concrete pour, and broom finish. Sloped driveways, decorative finishes, or sites with limited equipment access run higher. We provide free written on-site estimates — phone quotes aren't reliable because every site is different." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Concrete Estimate in Wildomar" />
  </section>
</BaseLayout>
