---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you serve newer Perris communities like Harvest at Citrus Heights with concrete installation?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we work throughout Perris including Harvest at Citrus Heights, Stoneridge, and communities along Ramona Expressway and Interstate 215. New construction and newer development concrete needs range from fresh driveway installation (builder-graded lots) to adding patios and walkways to complete the outdoor space. We coordinate with HOA requirements in master-planned communities for finish approvals." } },
    { '@type': 'Question', name: "How does Perris's soil affect concrete slab stability?", acceptedAnswer: { '@type': 'Answer', text: "Perris has varied soil conditions — sandy loam in the valley floor and more expansive clay soils near hillsides and older neighborhoods. Sandy soils drain well but may have inconsistent compaction; clay soils expand and contract with moisture. We test and assess soil conditions at every site and spec the appropriate base depth and reinforcement for the conditions we find. This prevents premature cracking and settling." } },
    { '@type': 'Question', name: 'Can you pour commercial-grade concrete for Perris warehouses and industrial properties?', acceptedAnswer: { '@type': 'Answer', text: "Yes — Perris has significant industrial and logistics facility development, and we have experience with commercial concrete including warehouse floors, loading dock aprons, and heavy-equipment pads. Commercial projects require higher PSI mix designs, heavier rebar grids, and often vapor barriers and joint placement plans. We work directly with property managers and general contractors on commercial projects throughout Perris." } },
    { '@type': 'Question', name: "What's the typical timeline for a concrete driveway project in Perris?", acceptedAnswer: { '@type': 'Answer', text: "A standard Perris driveway project runs 2–3 days from start to finish: Day 1 demolition and base preparation, Day 2 pour and finish. We ask for 7 days before driving on the new surface. Larger projects or those requiring permits add time to the schedule. We provide a specific timeline at the estimate so you can plan around the project." } },
  ],
};
---

<BaseLayout
  title="Concrete Contractor Perris, CA | Driveways, Patios & New Construction | Free Estimates"
  description="Licensed concrete contractor serving Perris, CA. New driveway installation, patio construction, decorative stamped concrete, and repair for Perris's growing communities. Free estimates."
  canonicalUrl="https://murrietaconcreteworks.com/perris/"
>
  <Hero
    headline="Concrete Driveways & Patios in Perris, CA"
    subheadline="Licensed concrete contractors serving all of Perris. New driveways, patios, walkways, decorative stamped concrete, and repair — fully permitted, built for new construction and established homes. Free estimates."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Concrete Services in Perris</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From new driveway and patio installs in Perris's fast-growing subdivisions to concrete repair in established neighborhoods near Lake Perris, we deliver quality work — licensed, permitted, and guaranteed.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>New Concrete for Perris's Growing Subdivisions</h2>
      <p>
        Perris is one of Inland Southern California's fastest-growing cities, with new residential developments expanding rapidly along the 215 freeway corridor. New homeowners in Perris's subdivisions frequently upgrade their builder-grade outdoor spaces within the first few years — adding extended driveways to accommodate more vehicles, backyard patios for outdoor living, concrete walkways connecting side yards, or decorative stamped concrete to elevate curb appeal. We work with new construction homeowners throughout Perris regularly and understand the permitting requirements and HOA approval processes for exterior concrete improvements.
      </p>

      <h2>Driveway Expansion and RV Pads in Perris</h2>
      <p>
        Perris has a large number of homes with the yard space to accommodate RV parking, boat storage, or additional vehicle parking — and concrete is the right surface for it. We pour RV pads, extended driveways, and secondary parking areas that are properly graded for drainage and built to handle heavy vehicle loads. We pull all required permits from the City of Perris and ensure the work is inspected and documented correctly.
      </p>

      <h2>Concrete for Established Perris Neighborhoods</h2>
      <p>
        Older neighborhoods near Lake Perris State Recreation Area and Perris's historic downtown have driveways and walkways that have been in place for decades. Perris's soil conditions — including areas with expansive clay — contribute to cracking and heaving over time. We assess whether cracking is superficial and repairable or a sign of deeper subgrade movement requiring full replacement. Either way, we give you an honest recommendation and a clear written estimate before any work begins.
      </p>

      <h2>Serving All Perris Communities</h2>
      <p>
        We pour and repair concrete throughout Perris, including neighborhoods near Lake Perris, the 215 freeway corridor, Mead Valley, and developing areas near the Southern California Logistics Airport. All concrete work is permitted through the City of Perris or Riverside County as required. Free estimates available anywhere in Perris — no travel fee.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Hemet', 'Perris'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Concrete in Perris</h2>
    <div class="space-y-4">
      {[
        { q: "Do you serve newer Perris communities like Harvest at Citrus Heights with concrete installation?", a: "Yes — we work throughout Perris including Harvest at Citrus Heights, Stoneridge, and communities along Ramona Expressway and Interstate 215. New construction and newer development concrete needs range from fresh driveway installation (builder-graded lots) to adding patios and walkways to complete the outdoor space. We coordinate with HOA requirements in master-planned communities for finish approvals." },
        { q: "How does Perris's soil affect concrete slab stability?", a: "Perris has varied soil conditions — sandy loam in the valley floor and more expansive clay soils near hillsides and older neighborhoods. Sandy soils drain well but may have inconsistent compaction; clay soils expand and contract with moisture. We test and assess soil conditions at every site and spec the appropriate base depth and reinforcement for the conditions we find. This prevents premature cracking and settling." },
        { q: "Can you pour commercial-grade concrete for Perris warehouses and industrial properties?", a: "Yes — Perris has significant industrial and logistics facility development, and we have experience with commercial concrete including warehouse floors, loading dock aprons, and heavy-equipment pads. Commercial projects require higher PSI mix designs, heavier rebar grids, and often vapor barriers and joint placement plans. We work directly with property managers and general contractors on commercial projects throughout Perris." },
        { q: "What's the typical timeline for a concrete driveway project in Perris?", a: "A standard Perris driveway project runs 2–3 days from start to finish: Day 1 demolition and base preparation, Day 2 pour and finish. We ask for 7 days before driving on the new surface. Larger projects or those requiring permits add time to the schedule. We provide a specific timeline at the estimate so you can plan around the project." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Concrete Estimate in Perris" />
  </section>
</BaseLayout>
