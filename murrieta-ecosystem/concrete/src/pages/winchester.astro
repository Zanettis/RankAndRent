---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you pour concrete driveways and patios in Winchester, CA?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — we serve all of Winchester including newer tract home communities like Winchester Commons and Morningstar Ranch, as well as rural and semi-rural parcels throughout the unincorporated area. We handle driveways, patios, walkways, pool decks, RV pads, and decorative concrete. Free on-site estimates available.' } },
    { '@type': 'Question', name: 'Who issues permits for concrete work in Winchester, CA?', acceptedAnswer: { '@type': 'Answer', text: "Winchester is an unincorporated community in Riverside County — there is no City of Winchester. Permits for concrete work (driveways, patios, and structural pads) are issued by Riverside County Building & Safety, not a city hall. We handle all permit applications and inspections on your behalf so you don't have to navigate the county process yourself." } },
    { '@type': 'Question', name: "How does Winchester's soil affect concrete installation?", acceptedAnswer: { '@type': 'Answer', text: "Winchester sits on expansive clay soils typical of inland Riverside County. Expansive clay absorbs water and swells, then shrinks as it dries — this repeated movement cracks slabs that aren't properly prepared. We address this with adequate compacted base rock, correct joint spacing, and proper sub-base depth. On rural lots with native soil, additional grading or import base may be required. We assess soil conditions during your free estimate." } },
    { '@type': 'Question', name: 'How much does concrete work cost in Winchester, CA?', acceptedAnswer: { '@type': 'Answer', text: 'Winchester concrete projects typically range from $3,000 for smaller walkways and patios to $15,000+ for full driveway replacements, large patio installations, or long rural driveways. Rural properties with longer runs or difficult access may be at the higher end. We provide free on-site estimates with written proposals — contact us to schedule a visit.' } },
  ],
};
---

<BaseLayout
  title="Concrete Contractor Winchester, CA | Driveways, Patios & Walkways"
  description="Licensed concrete contractor serving Winchester, CA. Driveways, patios, walkways, and stamped concrete for rural properties and tract homes. Riverside County permit handling. Free estimates."
  canonicalUrl="https://murrietaconcreteworks.com/winchester/"
>
  <Hero
    headline="Concrete Driveways & Patios in Winchester, CA"
    subheadline="Licensed concrete contractors serving Winchester's rural properties, newer subdivisions, and acreage lots. Driveways, patios, walkways, and decorative concrete. Free estimates."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Concrete Services in Winchester</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From driveway replacements in newer Winchester subdivisions to large concrete pads on rural acreage, we handle every concrete project in the area — built for Riverside County's inland climate and clay soils.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Concrete Work in Winchester's Growing Communities</h2>
      <p>
        Winchester has grown rapidly over the past decade, with master-planned communities like Winchester Commons and Morningstar Ranch bringing thousands of newer tract homes to the area. Many of these properties have builder-grade original concrete — thin driveways and minimal patios that crack or settle within the first 10–15 years. We replace aging or failed concrete across Winchester's subdivisions and also pour new slabs for homeowners adding patios, RV pads, and outdoor living space to their properties. For rural and semi-rural parcels along Winchester Road and the surrounding unincorporated area, we work on larger projects including long driveways, equipment pads, and agricultural slabs.
      </p>

      <h2>Riverside County Permits for Winchester Concrete Projects</h2>
      <p>
        Because Winchester is an unincorporated community — not an incorporated city — all building permits are issued through Riverside County Building & Safety rather than a city planning department. For permitted concrete work (driveways over a certain size, structural pads, and anything attached to a structure), we handle the county permit application, plan submission, and required inspections on your behalf. The county process has different timelines and requirements than city permits, and we navigate it regularly. We won't start any permitted work until the county has issued approval.
      </p>

      <h2>Concrete for Winchester's Rural Properties</h2>
      <p>
        Winchester's rural character means many properties need concrete solutions that go beyond a standard residential driveway. We pour RV pads and storage yard slabs, long driveways on acreage lots, horse property equipment areas, and ADU foundation pads. Rural access and clay soil conditions require additional base preparation — we assess sub-base conditions during every estimate and include the right spec for the site. For long driveways on rural lots, we also plan joint placement and drainage flow carefully to prevent cracking and standing water.
      </p>

      <h2>Why Winchester Homeowners Choose Us</h2>
      <p>
        We're based in the Murrieta/Temecula Valley and serve all of Winchester with no travel fees. Our team handles Riverside County permit applications, county inspections, and all project logistics — you don't have to coordinate with the county yourself. Every installation comes with a 10-year workmanship guarantee: if a defect traces back to our work, we return and fix it at no charge. Free on-site estimates available — we visit the property, assess conditions, and provide a written proposal before any commitment.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Menifee', 'Wildomar', 'Lake Elsinore', 'Perris', 'Hemet', 'San Jacinto'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Concrete in Winchester, CA</h2>
    <div class="space-y-4">
      {[
        { q: "Do you pour concrete driveways and patios in Winchester, CA?", a: "Yes — we serve all of Winchester including newer tract home communities like Winchester Commons and Morningstar Ranch, as well as rural and semi-rural parcels throughout the unincorporated area. We handle driveways, patios, walkways, pool decks, RV pads, and decorative concrete. Free on-site estimates available." },
        { q: "Who issues permits for concrete work in Winchester, CA?", a: "Winchester is an unincorporated community in Riverside County — there is no City of Winchester. Permits for concrete work (driveways, patios, and structural pads) are issued by Riverside County Building & Safety, not a city hall. We handle all permit applications and inspections on your behalf so you don't have to navigate the county process yourself." },
        { q: "How does Winchester's soil affect concrete installation?", a: "Winchester sits on expansive clay soils typical of inland Riverside County. Expansive clay absorbs water and swells, then shrinks as it dries — this repeated movement cracks slabs that aren't properly prepared. We address this with adequate compacted base rock, correct joint spacing, and proper sub-base depth. On rural lots with native soil, additional grading or import base may be required. We assess soil conditions during your free estimate." },
        { q: "How much does concrete work cost in Winchester, CA?", a: "Winchester concrete projects typically range from $3,000 for smaller walkways and patios to $15,000+ for full driveway replacements, large patio installations, or long rural driveways. Rural properties with longer runs or difficult access may be at the higher end. We provide free on-site estimates with written proposals — contact us to schedule a visit." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Concrete Estimate in Winchester" />
  </section>
</BaseLayout>
