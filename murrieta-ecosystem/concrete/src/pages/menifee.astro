---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you repair or replace aging concrete driveways in Sun City Menifee?', acceptedAnswer: { '@type': 'Answer', text: "Yes — Sun City Menifee is one of our busiest service areas for concrete driveway repair and replacement. Many Sun City driveways were poured in the 1970s–1990s and have reached end of life, with widespread cracking, lifting, and surface deterioration. We assess whether repair or full replacement makes better long-term financial sense and give you an honest recommendation. We work clean and quiet, respecting the community character." } },
    { '@type': 'Question', name: "How does Menifee's expansive clay soil cause concrete cracking?", acceptedAnswer: { '@type': 'Answer', text: "Menifee sits on Yolo and Hanford clay soils that are among the most expansive in the Inland Valley. These soils swell up to 10% in volume when saturated and shrink dramatically in dry conditions — putting enormous stress on concrete slabs from below. We address this with proper excavation (removing 6–8 inches of native clay), compactable base replacement, and steel reinforcement sized for the soil conditions. Skipping these steps leads to early failure." } },
    { '@type': 'Question', name: 'Do you serve Heritage Lakes, Heartland, and newer Menifee developments?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we work throughout Menifee including Heritage Lakes, Heartland, Audie Murphy Ranch, and communities along Bradley Road, Newport Road, and Menifee Road. Both older Sun City properties and newer master-planned communities have active concrete replacement programs. We're familiar with HOA requirements in the newer communities and can provide finish samples for approval before installation." } },
    { '@type': 'Question', name: 'Can you install an RV pad or extra parking slab in Menifee?', acceptedAnswer: { '@type': 'Answer', text: "Yes — RV pad installation is a popular request in Menifee, where many homes have side yards or extended lots suitable for additional parking. A standard RV pad (12×40 feet) typically runs $2,800–$5,500 depending on site preparation requirements. We can include a gate cut, drain inlet, and electrical conduit as options. Check with your HOA before requesting a quote — some communities restrict RV storage." } },
  ],
};
---

<BaseLayout
  title="Concrete Contractor Menifee, CA | Driveways, Patios & Repair | Free Estimates"
  description="Licensed concrete contractor serving Menifee, CA. Driveway installation, patio construction, concrete repair, and decorative stamped concrete. Serving Sun City, Quail Valley, Heritage Lakes, and all Menifee communities. Free estimates."
  canonicalUrl="https://murrietaconcreteworks.com/menifee/"
>
  <Hero
    headline="Concrete Driveways & Patios in Menifee, CA"
    subheadline="Licensed concrete contractors serving all of Menifee. New driveways, patios, walkways, decorative stamped concrete, and repair — fully permitted, satisfaction guaranteed, free estimates."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Concrete Services in Menifee</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From cracked driveways in Sun City to new patio installs in Menifee's newest neighborhoods, we deliver quality concrete work — permitted, guaranteed, and built for this climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Concrete Repair for Sun City's Aging Driveways</h2>
      <p>
        Sun City is one of Menifee's oldest and most established neighborhoods, with homes built in the 1960s through 1990s. Many driveways and sidewalks in Sun City are now 30–50 years old and showing the effects of Menifee's clay-heavy soils, which expand and contract with seasonal moisture changes. The result is cracking, heaving, and uneven slabs that create trip hazards and reduce curb appeal. We specialize in both targeted crack repair and full driveway replacement — matching existing concrete texture and aggregate where possible for a clean, consistent look.
      </p>

      <h2>New Construction Concrete for Menifee's Growing Communities</h2>
      <p>
        Menifee is one of the fastest-growing cities in Inland Southern California, with new subdivisions and master-planned communities expanding rapidly. Many new homeowners are upgrading their builder-grade concrete with decorative stamped patios, expanded driveways, or custom walkway designs. We work with Menifee's new homeowner communities and understand the HOA approval processes required for exterior improvements in master-planned developments like Heritage Lakes and Heartland.
      </p>

      <h2>Clay Soil and Concrete Longevity in Menifee</h2>
      <p>
        Menifee's expansive clay soils are one of the main causes of premature concrete failure in this area. When clay absorbs water, it expands — pushing concrete slabs upward and creating cracks. When it dries, it contracts — sometimes creating voids beneath slabs that cause cracking under load. Proper subgrade preparation, including compaction and sometimes a gravel drainage layer, dramatically extends the life of any new concrete installation. We don't skip this step, and it's why our work holds up longer than installations done by contractors who cut corners on prep.
      </p>

      <h2>Serving All Menifee Neighborhoods</h2>
      <p>
        We pour and repair concrete throughout Menifee, including Sun City, Quail Valley, Romoland, Bradley Junction, Heritage Lakes, Heartland, and the expanding neighborhoods near Newport Road, Haun Road, and McCall Boulevard. All work is pulled with the appropriate City of Menifee or Riverside County permits. Free estimates available anywhere in Menifee — no travel fee.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Concrete in Menifee</h2>
    <div class="space-y-4">
      {[
        { q: "Do you repair or replace aging concrete driveways in Sun City Menifee?", a: "Yes — Sun City Menifee is one of our busiest service areas for concrete driveway repair and replacement. Many Sun City driveways were poured in the 1970s–1990s and have reached end of life, with widespread cracking, lifting, and surface deterioration. We assess whether repair or full replacement makes better long-term financial sense and give you an honest recommendation. We work clean and quiet, respecting the community character." },
        { q: "How does Menifee's expansive clay soil cause concrete cracking?", a: "Menifee sits on Yolo and Hanford clay soils that are among the most expansive in the Inland Valley. These soils swell up to 10% in volume when saturated and shrink dramatically in dry conditions — putting enormous stress on concrete slabs from below. We address this with proper excavation (removing 6–8 inches of native clay), compactable base replacement, and steel reinforcement sized for the soil conditions. Skipping these steps leads to early failure." },
        { q: "Do you serve Heritage Lakes, Heartland, and newer Menifee developments?", a: "Yes — we work throughout Menifee including Heritage Lakes, Heartland, Audie Murphy Ranch, and communities along Bradley Road, Newport Road, and Menifee Road. Both older Sun City properties and newer master-planned communities have active concrete replacement programs. We're familiar with HOA requirements in the newer communities and can provide finish samples for approval before installation." },
        { q: "Can you install an RV pad or extra parking slab in Menifee?", a: "Yes — RV pad installation is a popular request in Menifee, where many homes have side yards or extended lots suitable for additional parking. A standard RV pad (12×40 feet) typically runs $2,800–$5,500 depending on site preparation requirements. We can include a gate cut, drain inlet, and electrical conduit as options. Check with your HOA before requesting a quote — some communities restrict RV storage." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Concrete Estimate in Menifee" />
  </section>
</BaseLayout>
