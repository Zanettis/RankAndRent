---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { Image } from 'astro:assets';
import { SITE_CONFIG } from '../../config';
import patioImg from '../../assets/images/patio-formwork.png';
import retainingImg from '../../assets/images/retaining-walls.jpg';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Concrete Patios',
  provider: { '@type': 'LocalBusiness', name: SITE_CONFIG.name, url: SITE_CONFIG.domain, telephone: SITE_CONFIG.phone },
  areaServed: { '@type': 'City', name: 'Murrieta', containedInPlace: { '@type': 'State', name: 'California' } },
  description: 'Custom patio slabs in standard, stamped, or exposed aggregate.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does a concrete patio cost in Murrieta, CA?',
      acceptedAnswer: { '@type': 'Answer', text: 'Standard broom-finish concrete patios in Murrieta typically cost $8–$14 per square foot installed. Stamped or colored concrete runs $14–$22 per square foot depending on pattern complexity. A 300 sq ft patio runs $2,400–$4,200 for standard concrete, or $4,200–$6,600 for stamped. Final cost depends on size, shape, finish, and site prep required. We provide free written estimates with no obligation.' },
    },
    {
      '@type': 'Question',
      name: 'What finish options are available for a concrete patio?',
      acceptedAnswer: { '@type': 'Answer', text: 'We offer broom finish (most affordable, slip-resistant), exposed aggregate (natural stone look, textured), stamped concrete (mimics flagstone, cobblestone, slate, or brick), and stained concrete (acid stains or integral pigments for custom color). All finishes can be sealed for added protection against UV and moisture.' },
    },
    {
      '@type': 'Question',
      name: 'How long before I can use my new concrete patio after installation?',
      acceptedAnswer: { '@type': 'Answer', text: 'You can walk on a newly poured concrete patio after 24–48 hours. For furniture and light use, wait 7 days. Full structural strength (28-day cure) is reached about a month after the pour, but the patio is functionally ready for normal residential use after the first week. We provide care instructions for the curing period.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need a permit for a concrete patio in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most residential concrete patios in Murrieta do not require a building permit if they are at grade level and not attached to the home\'s structure. However, if your HOA requires approval or if the patio involves drainage modifications, additional steps may be needed. We review permit requirements for your specific project during the free estimate.' },
    },
    {
      '@type': 'Question',
      name: 'How do you handle drainage on a new concrete patio?',
      acceptedAnswer: { '@type': 'Answer', text: 'Proper drainage is built into every patio we pour. We grade all slabs with a minimum 1/8 inch per foot slope away from the house foundation to prevent water pooling against the structure. For larger patios or challenging sites, we incorporate trench drains or channel drains at the perimeter.' },
    },
    {
      '@type': 'Question',
      name: 'Can you integrate a concrete patio with existing landscaping?',
      acceptedAnswer: { '@type': 'Answer', text: 'Absolutely. We design patios to work with existing trees, garden beds, and irrigation lines. Before pouring, we check underground utilities and tree root locations — large roots near the pour zone must be managed. We coordinate with tree service professionals when needed, and can reference your landscaping plan to ensure the patio complements your outdoor space.' },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Concrete Patios', item: `${SITE_CONFIG.domain}/services/concrete-patios/` },
  ],
};
---

<BaseLayout
  title="Concrete Patios Murrieta CA | Free Estimates"
  description="Licensed concrete patio contractor in Murrieta, CA. Custom patios in broom finish, stamped, or exposed aggregate. Drainage built in. Free estimates."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Concrete Patio Contractor in Murrieta, CA"
    subheadline="Create the outdoor living space you've always wanted — custom concrete patios built to last in Murrieta's sunny inland climate."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <div class="max-w-4xl mx-auto px-4 pt-8 pb-2">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <Image
        src={patioImg}
        alt="Concrete patio formwork and installation in Murrieta, CA"
        width={800}
        height={500}
        class="rounded-2xl w-full object-cover h-64"
      />
      <Image
        src={retainingImg}
        alt="Finished concrete patio and retaining wall in Murrieta, CA"
        width={800}
        height={500}
        class="rounded-2xl w-full object-cover h-64"
      />
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Concrete Patios: Murrieta's Outdoor Living Foundation</h2>
      <p>
        With Murrieta's warm climate and nearly 280 sunny days per year, outdoor living spaces
        are used from March through November. A properly designed concrete patio gives you a
        durable, low-maintenance foundation for outdoor furniture, BBQ areas, fire pits, and
        entertaining — without the ongoing maintenance costs of pavers or wood decking.
      </p>

      <h2>Patio Finish Options</h2>
      <p>
        Standard broom finish is functional and affordable at $8–$14 per square foot. Exposed
        aggregate adds natural texture and visual interest. Stamped concrete mimics the look of
        stone, brick, or tile at a fraction of the cost — running $14–$22 per square foot
        depending on pattern complexity. We offer all three finishes and can incorporate color
        through integral pigments or acid staining.
      </p>

      <h2>Drainage: Built Into Every Pour</h2>
      <p>
        A concrete patio that holds water is a liability. Every patio we install is graded with
        a minimum 1/8 inch per foot slope away from the house foundation. For sites with complex
        topography or heavy runoff, we incorporate trench drains or channel drains. We assess
        your site during the free estimate and plan accordingly.
      </p>

      <h2>HOA and Permit Considerations</h2>
      <p>
        Many Murrieta neighborhoods — including Redhawk, Paloma del Sol, and California Oaks —
        require HOA approval before exterior concrete work. We can advise on typical approval
        requirements and help you submit the right documentation. Most at-grade patios do not
        require a city building permit, but we confirm this for your specific address.
      </p>

      <h2>Coordinating With Your Landscaping Plan</h2>
      <p>
        New patios work best when planned alongside your landscape. We coordinate with
        <a href="https://landscapingmurrieta.com/services/landscape-design">landscape designers</a>
        to ensure the patio integrates with planting beds, irrigation lines, and outdoor lighting.
        If large tree roots are near the pour zone, we bring in
        <a href="https://murrietatreeexperts.com">tree service professionals</a> to manage them
        before we pour — unmanaged roots cause heaving within 5–10 years.
      </p>
    </div>

    <CrossLinkWidget
      heading="Complete Your Outdoor Space"
      links={[
        {
          text: 'Landscape Design in Murrieta',
          href: 'https://landscapingmurrieta.com/services/landscape-design',
          description: 'Design the planting beds, borders, and softscape that surround your new patio.',
          icon: '🌱',
        },
        {
          text: 'Lawn Care & Restoration',
          href: 'https://landscapingmurrieta.com/services/lawn-care',
          description: 'Restore lawn areas affected during concrete installation.',
          icon: '🌿',
        },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Concrete Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/concrete-patios').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-4">From Our Blog</h2>
      <ul class="space-y-2">
        <li><a href="/blog/concrete-patio-cost-murrieta" class="text-cta hover:underline font-medium">How Much Does a Concrete Patio Cost in Murrieta, CA? (2025 Guide)</a></li>
        <li><a href="/blog/concrete-patio-ideas-small-backyard-murrieta" class="text-cta hover:underline font-medium">Concrete Patio Ideas for Small Backyards in Murrieta</a></li>
        <li><a href="/blog/concrete-patio-vs-wood-deck-murrieta" class="text-cta hover:underline font-medium">Concrete Patio vs. Wood Deck in Murrieta: Which Is the Better Investment?</a></li>
        <li><a href="/blog/patio-ideas-murrieta" class="text-cta hover:underline font-medium">Concrete Patio Design Ideas for Murrieta Backyards (2025)</a></li>
      </ul>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        { q: "How much does a concrete patio cost in Murrieta, CA?", a: "Standard broom-finish concrete patios in Murrieta typically cost $8–$14 per square foot installed. Stamped or colored concrete runs $14–$22 per square foot depending on pattern complexity. A 300 sq ft patio runs $2,400–$4,200 for standard concrete, or $4,200–$6,600 for stamped. Final cost depends on size, shape, finish, and site prep required. We provide free written estimates with no obligation." },
        { q: "What finish options are available for a concrete patio?", a: "We offer broom finish (most affordable, slip-resistant), exposed aggregate (natural stone look, textured), stamped concrete (mimics flagstone, cobblestone, slate, or brick), and stained concrete (acid stains or integral pigments for custom color). All finishes can be sealed for added protection against UV and moisture." },
        { q: "How long before I can use my new concrete patio after installation?", a: "You can walk on a newly poured concrete patio after 24–48 hours. For furniture and light use, wait 7 days. Full structural strength (28-day cure) is reached about a month after the pour, but the patio is functionally ready for normal residential use after the first week. We provide care instructions for the curing period." },
        { q: "Do I need a permit for a concrete patio in Murrieta?", a: "Most residential concrete patios in Murrieta do not require a building permit if they are at grade level and not attached to the home's structure. However, if your HOA requires approval or if the patio involves drainage modifications, additional steps may be needed. We review permit requirements for your specific project during the free estimate." },
        { q: "How do you handle drainage on a new concrete patio?", a: "Proper drainage is built into every patio we pour. We grade all slabs with a minimum 1/8 inch per foot slope away from the house foundation to prevent water pooling against the structure. For larger patios or challenging sites, we incorporate trench drains or channel drains at the perimeter." },
        { q: "Can you integrate a concrete patio with existing landscaping?", a: "Absolutely. We design patios to work with existing trees, garden beds, and irrigation lines. Before pouring, we check underground utilities and tree root locations — large roots near the pour zone must be managed. We coordinate with tree service professionals when needed, and can reference your landscaping plan to ensure the patio complements your outdoor space." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Get Your Free Patio Estimate" />
  </section>
</BaseLayout>
