---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { Image } from 'astro:assets';
import { SITE_CONFIG } from '../../config';
import wallImg from '../../assets/images/retaining-walls.jpg';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Concrete Walls',
  provider: { '@type': 'LocalBusiness', name: SITE_CONFIG.name, url: SITE_CONFIG.domain, telephone: SITE_CONFIG.phone },
  areaServed: { '@type': 'City', name: 'Murrieta', containedInPlace: { '@type': 'State', name: 'California' } },
  description: 'Retaining walls, block walls, and garden walls.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does a concrete retaining wall cost in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: 'Concrete retaining walls in Murrieta typically cost $30–$60 per square foot of wall face, depending on height, wall type, and drainage requirements. A 30-foot run of 4-foot-tall retaining wall runs approximately $3,600–$7,200. Taller walls, walls requiring drainage systems, or engineered walls for hillside lots cost more. We provide free on-site estimates with written pricing before any work begins.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need a permit for a concrete retaining wall in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: 'In Murrieta, retaining walls over 3 feet in height (measured from the bottom of the footing to the top of the wall) typically require a building permit. Walls under 3 feet are usually exempt, though HOA approval may still be required in many Murrieta communities. We review permit requirements for your specific project and address as part of our planning process.' },
    },
    {
      '@type': 'Question',
      name: 'What\'s the difference between a poured concrete wall and a concrete block wall?',
      acceptedAnswer: { '@type': 'Answer', text: 'Poured concrete walls are formed and poured as a single continuous unit — they\'re stronger structurally and better suited for taller retaining applications. Concrete block (CMU) walls are built with individual masonry blocks; they\'re more flexible in terms of curves and design, and slightly more affordable for shorter walls. We assess your specific needs and soil conditions to recommend the right approach.' },
    },
    {
      '@type': 'Question',
      name: 'How important is drainage behind a retaining wall?',
      acceptedAnswer: { '@type': 'Answer', text: 'Drainage is critical. Water pressure (hydrostatic pressure) behind a retaining wall is one of the top causes of wall failure. We install gravel backfill and perforated drainage pipe (French drain) behind every retaining wall to relieve water pressure. Without proper drainage, even a well-built wall will eventually crack, lean, or collapse. This is non-negotiable in our installations.' },
    },
    {
      '@type': 'Question',
      name: 'Can you build decorative concrete garden walls or planters?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Beyond structural retaining walls, we build decorative garden walls, raised planter borders, low privacy walls, and outdoor seating walls. These can be finished with broom texture, exposed aggregate, or stamped patterns to match your patio or home exterior. Decorative walls are typically shorter (1–3 feet) and don\'t require engineering review.' },
    },
    {
      '@type': 'Question',
      name: 'How long does a concrete retaining wall last?',
      acceptedAnswer: { '@type': 'Answer', text: 'A properly designed and installed concrete retaining wall in Murrieta lasts 40–60 years or more. Failure typically comes from poor drainage (hydrostatic pressure cracking the wall), inadequate footing depth, or lack of reinforcement. Our walls include steel rebar reinforcement, proper footings below grade, and drainage systems — the combination that extends wall life significantly.' },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Concrete Walls', item: `${SITE_CONFIG.domain}/services/concrete-walls/` },
  ],
};
---

<BaseLayout
  title="Concrete Retaining Walls Murrieta CA | Free Estimates"
  description="Licensed concrete wall contractor in Murrieta, CA. Retaining walls, block walls, garden walls, and decorative concrete walls. Drainage included. Free estimates."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Concrete Wall Contractor in Murrieta, CA"
    subheadline="Retaining walls, block walls, and decorative garden walls — built with proper drainage and reinforcement to last decades in Murrieta's terrain."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <div class="max-w-4xl mx-auto px-4 pt-8 pb-2">
    <Image
      src={wallImg}
      alt="Concrete retaining wall construction in Murrieta, CA"
      width={1200}
      height={600}
      class="rounded-2xl w-full object-cover max-h-[420px]"
    />
  </div>

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Retaining Walls for Murrieta's Hilly Terrain</h2>
      <p>
        Many Murrieta and Temecula Valley properties have sloped yards, hillside lots, or grade
        changes between neighboring properties. Concrete retaining walls manage these elevation
        differences, prevent soil erosion, and create flat usable space for patios, gardens, or
        lawns. Murrieta's expansive clay soil makes proper wall engineering and drainage especially
        important — clay expands when wet, generating significant pressure against wall surfaces.
      </p>

      <h2>Types of Concrete Walls We Build</h2>
      <p>
        <strong>Poured concrete retaining walls</strong> are the strongest option for taller
        applications (3–8+ feet). They're formed, reinforced with steel rebar, and poured as a
        solid continuous mass. Ideal for high-load applications or steep grade changes.
      </p>
      <p>
        <strong>Concrete block (CMU) walls</strong> use individual masonry units, offering more
        design flexibility for curved layouts or decorative applications. Well-suited for walls
        under 4 feet and garden-facing applications.
      </p>
      <p>
        <strong>Decorative garden and planter walls</strong> are lower-profile structures (1–3 feet)
        that define outdoor spaces, border planting beds, or create raised planters. These can
        be finished with stamped patterns, exposed aggregate, or smooth stucco faces.
      </p>

      <h2>Drainage: The Non-Negotiable Detail</h2>
      <p>
        Hydrostatic pressure — water building up behind a retaining wall — is the leading cause
        of wall failure. Every retaining wall we build includes gravel backfill and a perforated
        drainage pipe (French drain) to route water away from the wall base. We also incorporate
        weep holes in block walls for additional pressure relief. This is not an optional upgrade;
        it's built into every job.
      </p>

      <h2>Permits and HOA Approval</h2>
      <p>
        Murrieta requires permits for retaining walls over 3 feet from footing to top of wall.
        HOA communities like Redhawk, California Oaks, and Paloma del Sol may require separate
        architectural approval. We identify what's required for your specific project and handle
        the permitting coordination.
      </p>

      <h2>Coordinating With Your Landscape Plan</h2>
      <p>
        New retaining walls often create opportunity for new planting beds, drip irrigation, and
        <a href="https://landscapingmurrieta.com/services/landscape-design">landscape design</a>
        on the newly leveled terrain. We coordinate sequencing with landscape contractors so
        irrigation and planting work happens after the wall is complete and backfilled.
      </p>
    </div>

    <CrossLinkWidget
      heading="Related Services in Murrieta"
      links={[
        {
          text: 'Retaining Walls & Landscaping',
          href: 'https://landscapingmurrieta.com/services/retaining-walls',
          description: 'Combine concrete walls with professional landscaping and retaining wall design.',
          icon: '🌱',
        },
        {
          text: 'Tree Removal in Murrieta',
          href: 'https://murrietatreeexperts.com/services/tree-removal',
          description: 'Remove trees near wall areas before construction to avoid future root damage.',
          icon: '🌳',
        },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Concrete Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/concrete-walls').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-4">From Our Blog</h2>
      <ul class="space-y-2">
        <li><a href="/blog/outdoor-living-murrieta" class="text-cta hover:underline font-medium">Creating the Perfect Outdoor Living Space in Murrieta, CA</a></li>
        <li><a href="/blog/concrete-permits-murrieta-temecula" class="text-cta hover:underline font-medium">Concrete Driveway Permits in Murrieta and Temecula: What Homeowners Need to Know</a></li>
        <li><a href="/blog/patio-ideas-murrieta" class="text-cta hover:underline font-medium">Concrete Patio Design Ideas for Murrieta Backyards (2025)</a></li>
      </ul>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        { q: "How much does a concrete retaining wall cost in Murrieta?", a: "Concrete retaining walls in Murrieta typically cost $30–$60 per square foot of wall face, depending on height, wall type, and drainage requirements. A 30-foot run of 4-foot-tall retaining wall runs approximately $3,600–$7,200. Taller walls, walls requiring drainage systems, or engineered walls for hillside lots cost more. We provide free on-site estimates with written pricing before any work begins." },
        { q: "Do I need a permit for a concrete retaining wall in Murrieta?", a: "In Murrieta, retaining walls over 3 feet in height (measured from the bottom of the footing to the top of the wall) typically require a building permit. Walls under 3 feet are usually exempt, though HOA approval may still be required in many Murrieta communities. We review permit requirements for your specific project and address as part of our planning process." },
        { q: "What's the difference between a poured concrete wall and a concrete block wall?", a: "Poured concrete walls are formed and poured as a single continuous unit — they're stronger structurally and better suited for taller retaining applications. Concrete block (CMU) walls are built with individual masonry blocks; they're more flexible in terms of curves and design, and slightly more affordable for shorter walls. We assess your specific needs and soil conditions to recommend the right approach." },
        { q: "How important is drainage behind a retaining wall?", a: "Drainage is critical. Water pressure (hydrostatic pressure) behind a retaining wall is one of the top causes of wall failure. We install gravel backfill and perforated drainage pipe (French drain) behind every retaining wall to relieve water pressure. Without proper drainage, even a well-built wall will eventually crack, lean, or collapse. This is non-negotiable in our installations." },
        { q: "Can you build decorative concrete garden walls or planters?", a: "Yes. Beyond structural retaining walls, we build decorative garden walls, raised planter borders, low privacy walls, and outdoor seating walls. These can be finished with broom texture, exposed aggregate, or stamped patterns to match your patio or home exterior. Decorative walls are typically shorter (1–3 feet) and don't require engineering review." },
        { q: "How long does a concrete retaining wall last?", a: "A properly designed and installed concrete retaining wall in Murrieta lasts 40–60 years or more. Failure typically comes from poor drainage (hydrostatic pressure cracking the wall), inadequate footing depth, or lack of reinforcement. Our walls include steel rebar reinforcement, proper footings below grade, and drainage systems — the combination that extends wall life significantly." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Get Your Free Wall Estimate" />
  </section>
</BaseLayout>
