---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { Image } from 'astro:assets';
import { SITE_CONFIG } from '../../config';
import drivewayImg from '../../assets/images/driveway-fresh.jpg';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Concrete Driveways',
  provider: { '@type': 'LocalBusiness', name: SITE_CONFIG.name, url: SITE_CONFIG.domain, telephone: SITE_CONFIG.phone },
  areaServed: { '@type': 'City', name: 'Murrieta', containedInPlace: { '@type': 'State', name: 'California' } },
  description: 'Durable driveway installation and replacement.',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How long does a concrete driveway last in Murrieta\'s climate?',
      acceptedAnswer: { '@type': 'Answer', text: 'A properly installed concrete driveway in Murrieta typically lasts 30–50 years. Concrete holds up exceptionally well in our inland Southern California climate because it doesn\'t soften in summer heat the way asphalt does. Proper curing, reinforcement, and periodic sealing will keep your driveway looking great and structurally sound for decades.' },
    },
    {
      '@type': 'Question',
      name: 'How much does a concrete driveway cost in Murrieta, CA?',
      acceptedAnswer: { '@type': 'Answer', text: 'Concrete driveway installation in Murrieta typically costs $6–$12 per square foot for standard concrete, and $12–$18 per square foot for stamped or decorative finishes. A standard two-car driveway (400–500 sq ft) runs $2,500–$6,000 installed. Final pricing depends on site conditions, demolition of the existing surface, and finish selection. We provide free, written on-site estimates.' },
    },
    {
      '@type': 'Question',
      name: 'How long does concrete driveway installation take from start to finish?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most residential driveway installations take 2–3 days. Day one is demolition and subbase prep; day two is the pour and finishing. After pouring, we ask for 48–72 hours before light foot traffic and 7 full days before driving on the surface. We\'ll give you a complete timeline before the project starts so you can plan accordingly.' },
    },
    {
      '@type': 'Question',
      name: 'My driveway has cracks from tree roots — what should I do?',
      acceptedAnswer: { '@type': 'Answer', text: 'Tree root intrusion is one of the most common causes of driveway damage in Murrieta — eucalyptus, ficus, and sycamore roots are especially aggressive. Before replacing the concrete, we strongly recommend having a certified arborist assess and remove the offending roots. If you just pour new concrete over an untreated root system, you\'ll face the same cracking problem within 5–10 years. We coordinate with local tree service professionals when needed.' },
    },
    {
      '@type': 'Question',
      name: 'Can I get a decorative or stamped finish on my driveway?',
      acceptedAnswer: { '@type': 'Answer', text: 'Absolutely. Stamped concrete can mimic the look of flagstone, cobblestone, slate, or brick while providing the durability and lower maintenance cost of concrete. We also offer integral color and acid staining options. Decorative driveways typically cost $12–$18 per square foot and significantly boost curb appeal. We\'ll show you pattern and color samples during your free estimate.' },
    },
    {
      '@type': 'Question',
      name: 'Does a concrete driveway need to be sealed, and how often?',
      acceptedAnswer: { '@type': 'Answer', text: 'Sealing is recommended but not mandatory for standard concrete driveways. For Murrieta\'s climate — intense UV exposure and occasional frost — a penetrating sealer every 3–5 years helps prevent surface wear and staining. Stamped and decorative concrete should be sealed every 2–3 years to protect the color and texture. We offer sealing as an add-on service at the time of installation.' },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Concrete Driveways', item: `${SITE_CONFIG.domain}/services/concrete-driveways/` },
  ],
};
---

<BaseLayout
  title="Concrete Driveways Murrieta CA | Free Estimates"
  description="Professional concrete driveway installation and replacement in Murrieta, CA. Licensed contractors, quality materials, 10-year guarantee. Free estimates."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Concrete Driveway Contractor in Murrieta, CA"
    subheadline="New driveway installation or full replacement — built to last in Murrieta's inland climate with proper reinforcement and grading."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <div class="max-w-4xl mx-auto px-4 pt-8 pb-2">
    <Image
      src={drivewayImg}
      alt="Freshly poured and finished concrete driveway in Murrieta, CA"
      width={1200}
      height={600}
      class="rounded-2xl w-full object-cover max-h-[420px]"
    />
  </div>

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Why Choose Concrete for Your Murrieta Driveway?</h2>
      <p>
        Concrete driveways outlast asphalt by decades in Murrieta's climate — typically 30–50 years
        with proper installation vs. 15–25 years for asphalt. Concrete doesn't soften in summer
        heat the way asphalt does, and it doesn't require sealing every few years.
        The initial cost is higher, but the lifetime value is significantly better.
      </p>

      <h2>Our Driveway Installation Process</h2>
      <p>
        We start by excavating existing pavement and grading the subbase to ensure proper drainage
        away from your home. We install a gravel base layer, then steel rebar or wire mesh
        reinforcement before pouring. Expansion joints are placed at precise intervals to control
        cracking. After pouring, the concrete is finished, cured, and sealed for maximum durability.
      </p>
      <p>
        If your project involves removing a tree or large roots near the driveway, we coordinate
        with <a href="https://murrietatreeexperts.com">tree service professionals</a> to handle
        root removal properly before we pour — roots under concrete will cause cracking and heaving
        as they grow.
      </p>

      <h2>Tree Roots and Driveways: A Critical Consideration</h2>
      <p>
        This is one of the most common issues we see in Murrieta — tree roots from established
        eucalyptus, oak, or ficus trees that have grown under older driveways, causing cracking
        and lifting. Before replacing a damaged driveway, a
        <a href="https://murrietatreeexperts.com/services/tree-removal">certified arborist</a>
        should assess whether root pruning or tree removal is necessary to prevent the same
        problem from recurring in 5–10 years.
      </p>

      <h2>After Your New Driveway</h2>
      <p>
        A new concrete driveway dramatically improves curb appeal. Many homeowners also
        refresh the surrounding
        <a href="https://landscapingmurrieta.com/services/landscape-design">landscaping</a>
        at the same time — new plants, mulch, and border edging that frames the new driveway beautifully.
      </p>
    </div>

    <CrossLinkWidget
      heading="Before & After Your New Driveway"
      links={[
        {
          text: 'Tree Removal in Murrieta',
          href: 'https://murrietatreeexperts.com/services/tree-removal',
          description: 'Remove root-invasive trees before pouring your driveway to prevent future cracking.',
          icon: '🌳',
        },
        {
          text: 'Landscape Design in Murrieta',
          href: 'https://landscapingmurrieta.com/services/landscape-design',
          description: 'Refresh the planting beds and borders that frame your new concrete driveway.',
          icon: '🌱',
        },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Concrete Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/concrete-driveways').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-4">From Our Blog</h2>
      <ul class="space-y-2">
        <li><a href="/blog/concrete-driveway-cost-murrieta" class="text-cta hover:underline font-medium">Concrete Driveway Cost in Murrieta, CA: What to Expect in 2025</a></li>
        <li><a href="/blog/best-time-pour-concrete-murrieta" class="text-cta hover:underline font-medium">Best Time to Pour Concrete in Murrieta, CA: A Seasonal Guide</a></li>
        <li><a href="/blog/concrete-permits-murrieta-temecula" class="text-cta hover:underline font-medium">Concrete Driveway Permits in Murrieta and Temecula: What Homeowners Need to Know</a></li>
        <li><a href="/blog/concrete-vs-asphalt-driveway-murrieta" class="text-cta hover:underline font-medium">Concrete vs Asphalt Driveway in Murrieta: Which Is Better?</a></li>
      </ul>
    </div>
  </div>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        { q: "How long does a concrete driveway last in Murrieta's climate?", a: "A properly installed concrete driveway in Murrieta typically lasts 30–50 years. Concrete holds up exceptionally well in our inland Southern California climate because it doesn't soften in summer heat the way asphalt does. Proper curing, reinforcement, and periodic sealing will keep your driveway looking great and structurally sound for decades." },
        { q: "How much does a concrete driveway cost in Murrieta, CA?", a: "Concrete driveway installation in Murrieta typically costs $6–$12 per square foot for standard concrete, and $12–$18 per square foot for stamped or decorative finishes. A standard two-car driveway (400–500 sq ft) runs $2,500–$6,000 installed. Final pricing depends on site conditions, demolition of the existing surface, and finish selection. We provide free, written on-site estimates." },
        { q: "How long does concrete driveway installation take from start to finish?", a: "Most residential driveway installations take 2–3 days. Day one is demolition and subbase prep; day two is the pour and finishing. After pouring, we ask for 48–72 hours before light foot traffic and 7 full days before driving on the surface. We'll give you a complete timeline before the project starts so you can plan accordingly." },
        { q: "My driveway has cracks from tree roots — what should I do?", a: "Tree root intrusion is one of the most common causes of driveway damage in Murrieta — eucalyptus, ficus, and sycamore roots are especially aggressive. Before replacing the concrete, we strongly recommend having a certified arborist assess and remove the offending roots. If you just pour new concrete over an untreated root system, you'll face the same cracking problem within 5–10 years. We coordinate with local tree service professionals when needed." },
        { q: "Can I get a decorative or stamped finish on my driveway?", a: "Absolutely. Stamped concrete can mimic the look of flagstone, cobblestone, slate, or brick while providing the durability and lower maintenance cost of concrete. We also offer integral color and acid staining options. Decorative driveways typically cost $12–$18 per square foot and significantly boost curb appeal. We'll show you pattern and color samples during your free estimate." },
        { q: "Does a concrete driveway need to be sealed, and how often?", a: "Sealing is recommended but not mandatory for standard concrete driveways. For Murrieta's climate — intense UV exposure and occasional frost — a penetrating sealer every 3–5 years helps prevent surface wear and staining. Stamped and decorative concrete should be sealed every 2–3 years to protect the color and texture. We offer sealing as an add-on service at the time of installation." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Get Your Free Driveway Estimate" />
  </section>
</BaseLayout>
