---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE_CONFIG } from '../config';
---

<BaseLayout
  title="Contact Murrieta Concrete | Free Estimate"
  description="Contact Murrieta Concrete for a free estimate on driveways, patios, and walkways. We respond within 24 hours."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-10">
      <h1 class="text-4xl font-bold text-primary mb-4">Get Your Free Concrete Estimate</h1>
      <p class="text-gray-600 text-lg max-w-2xl mx-auto">
        Tell us about your project and we'll provide a detailed, no-obligation estimate.
        Most estimates are completed within 48 hours of your initial request.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div class="lg:col-span-2">
        <LeadForm heading="Request a Free Estimate" />
      </div>

      <aside class="space-y-6">
        <div class="bg-primary text-white rounded-xl p-6">
          <h3 class="font-bold text-lg mb-4">Contact Information</h3>
          <div class="space-y-3 text-sm">
            <p>📞 <a href={`tel:${SITE_CONFIG.phone}`} class="hover:text-accent">{SITE_CONFIG.phone}</a></p>
            <p>✉️ <a href={`mailto:${SITE_CONFIG.email}`} class="hover:text-accent">{SITE_CONFIG.email}</a></p>
            <p>📍 {SITE_CONFIG.address}</p>
            <p>🕐 Mon–Sat: 7am–5pm</p>
          </div>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
          <h3 class="font-bold text-primary text-lg mb-3">What to Expect</h3>
          <ol class="space-y-3 text-sm text-gray-600">
            <li class="flex gap-2"><span class="font-bold text-accent">1.</span> Submit your request</li>
            <li class="flex gap-2"><span class="font-bold text-accent">2.</span> We call you within 24 hours</li>
            <li class="flex gap-2"><span class="font-bold text-accent">3.</span> Free on-site measurement</li>
            <li class="flex gap-2"><span class="font-bold text-accent">4.</span> Written estimate in 48 hours</li>
          </ol>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
