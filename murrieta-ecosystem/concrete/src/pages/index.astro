---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE_CONFIG } from '../config';

const icons = ['🚗', '☀️', '🔧', '✨'];
---

<BaseLayout
  title="Concrete Murrieta, CA | Driveways, Patios & Walkways"
  description="Expert concrete driveways, patios, and walkways in Murrieta, CA. Licensed contractors, quality materials, lasting results. Free estimates."
>
  <Hero
    headline="Driveways & Patios Built to Last in Murrieta"
    subheadline="Licensed concrete contractors serving Murrieta and the Temecula Valley. Driveways, patios, walkways, and decorative concrete — fully permitted, quality guaranteed, free estimates."
    ctaText="Get a Free Estimate"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Our Concrete Services</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From new driveway installations to decorative stamped concrete patios, we deliver
      flawless concrete work that enhances Murrieta homes and withstands the test of time.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service, i) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          href={service.href}
          icon={icons[i] ?? '🏗️'}
        />
      ))}
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">Quality You Can See, Durability You Can Count On</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-10">
        <div class="text-center">
          <div class="text-4xl mb-3">📐</div>
          <h3 class="font-bold text-primary text-lg mb-2">10-Year Workmanship Guarantee</h3>
          <p class="text-gray-600 text-sm">We stand behind every job. Our concrete work comes with a 10-year workmanship guarantee — if it fails due to our work, we fix it. No fine print.</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-3">🌡️</div>
          <h3 class="font-bold text-primary text-lg mb-2">Built for Inland SoCal</h3>
          <p class="text-gray-600 text-sm">We use concrete mixes and curing techniques designed for Murrieta's heat and occasional frost.</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-3">📝</div>
          <h3 class="font-bold text-primary text-lg mb-2">Fully Permitted Work</h3>
          <p class="text-gray-600 text-sm">We handle all permits and inspections. Your project is done right and legally compliant.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Complete Your Outdoor Project</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto mb-8">
      Getting a new driveway? You may need
      <a href="https://murrietatreeexperts.com" class="text-cta hover:underline">tree root removal</a> first,
      or want to finish the project with professional
      <a href="https://landscapingmurrieta.com" class="text-cta hover:underline">landscaping</a> around
      your new concrete. We coordinate with trusted local partners for a seamless experience.
    </p>
    <div class="text-center">
      <a href="/services/concrete-driveways" class="text-cta font-semibold hover:underline">
        See all services →
      </a>
    </div>
  </section>

  <!-- Service Area -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-primary mb-4">Serving Murrieta & the Temecula Valley</h2>
      <p class="text-gray-600 max-w-3xl mx-auto mb-6">
        We pour concrete for homeowners and property owners throughout the region. Free estimates available anywhere in our service area.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
      <a href="/services/concrete-driveways" class="text-cta font-semibold hover:underline">
        See all services →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        {
          q: "How much does a concrete driveway cost in Murrieta, CA?",
          a: "Concrete driveway installation in Murrieta typically costs $6–$12 per square foot for standard concrete, or $12–$18 per square foot for stamped decorative concrete. A standard two-car driveway (400–500 sq ft) runs $2,500–$6,000. We provide free on-site written estimates."
        },
        {
          q: "How long does concrete installation take?",
          a: "Most residential projects take 1–3 days: one day for demolition and prep, one for pouring, and we ask for 48–72 hours of curing before light foot traffic. Driveways need 7 days before vehicle use. We'll give you a full timeline before starting."
        },
        {
          q: "Do you handle permits?",
          a: "Yes. We pull all required permits from the City of Murrieta or Riverside County and handle inspections. Permitted work protects your property value and ensures your project is code-compliant."
        },
        {
          q: "What's the difference between stamped and standard concrete?",
          a: "Standard concrete has a broom or smooth finish and is the most durable and cost-effective option. Stamped (decorative) concrete is imprinted with patterns mimicking stone, brick, or wood, and can be colored. It costs more but dramatically improves curb appeal."
        },
        {
          q: "Do you offer a warranty?",
          a: "Yes — we offer a 10-year workmanship guarantee on all concrete work. If a defect is caused by our installation (not normal wear or ground movement beyond our control), we return and fix it at no cost."
        },
        {
          q: "Do you serve Temecula, Wildomar, and other nearby cities?",
          a: "Yes. We serve Murrieta, Temecula, Wildomar, Menifee, Lake Elsinore, Canyon Lake, and Winchester. Free estimates throughout the Temecula Valley."
        },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Ready for New Concrete? Get Your Free Estimate" />
  </section>
</BaseLayout>
