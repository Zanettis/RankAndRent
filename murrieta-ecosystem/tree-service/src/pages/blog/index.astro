---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout
  title="Tree Service Blog | Tips for Murrieta Homeowners"
  description="Expert tree care advice for Murrieta, CA homeowners. Learn about seasonal trimming, tree health, storm prep, and more from our certified arborists."
>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="mb-10">
      <h1 class="text-4xl font-bold text-primary mb-4">Tree Care Blog</h1>
      <p class="text-gray-600 text-lg">
        Expert advice from our Murrieta arborists — covering everything from seasonal pruning
        to identifying tree disease and planning your complete yard renovation.
      </p>
    </div>

    {posts.length === 0 ? (
      <p class="text-gray-500">No posts yet. Check back soon!</p>
    ) : (
      <div class="grid gap-6">
        {posts.map((post) => (
          <BlogPostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            slug={post.slug}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
