            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Recommendation by Use Case -->
  <section class="max-w-4xl mx-auto px-4 py-14">
    <h2 class="text-3xl font-bold text-primary mb-8">Which Option Is Right for Your Situation?</h2>
    <div class="space-y-5">
      {[
        {
          situation: 'Emergency — tree down, limb on roof, blocked driveway',
          rec: 'Call Murrieta Tree Experts directly at (951) 555-0101. We have 24/7 emergency response. Do not submit a HomeAdvisor or Thumbtack request — the bid-based system takes hours to connect you with someone who might not even be available.',
        },
        {
          situation: 'Hazard tree — dead branches or leaning toward your house',
          rec: 'Call a local ISA-certified arborist first (Murrieta Tree Experts or a Google LSA-verified company). This is a safety issue that requires an in-person assessment, not a phone estimate from an aggregator-matched contractor.',
        },
        {
          situation: 'Routine trimming — healthy trees, not urgent',
          rec: 'Good time to use Nextdoor or Yelp for research, then call 2–3 contractors for written estimates. Thumbtack can also work here if you want a structured comparison.',
        },
        {
          situation: 'Stump grinding — post-removal cleanup',
          rec: 'If we removed the tree, we handle stump grinding too — ask when we\'re on-site. Otherwise, a direct Google search for "stump grinding Murrieta" will surface local specialists.',
        },
        {
          situation: 'Large property or multiple trees',
          rec: 'Call a local specialist directly and schedule an on-site assessment. Multi-tree projects need an arborist to walk the property — no platform is going to match you with someone appropriately qualified via a form.',
        },
      ].map(item => (
        <div class="bg-gray-50 rounded-xl p-5 border border-gray-100">
          <h3 class="font-bold text-gray-800 mb-2">{item.situation}</h3>
          <p class="text-gray-600 text-sm leading-relaxed">{item.rec}</p>
        </div>
      ))}
    </div>
  </section>

