---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: "Do you serve Perris's newer master-planned communities like Harvest at Citrus Heights?", acceptedAnswer: { '@type': 'Answer', text: 'Yes — we work throughout Perris including Harvest at Citrus Heights, Stoneridge, Mead Valley, and surrounding areas. Newer developments in Perris often have fast-growing developer-installed trees that are now reaching problem sizes. We handle both routine maintenance trimming and full removal when a tree has outgrown its location.' } },
    { '@type': 'Question', name: 'How do you handle tree removal on large agricultural or commercial lots in Perris?', acceptedAnswer: { '@type': 'Answer', text: "Perris has a mix of residential, agricultural, and industrial properties, and we handle all of them. Large lots give us better equipment access, which often reduces cost. For agricultural land with multiple trees, we can bundle removals into one visit for efficiency. We also work with commercial property managers on tree maintenance programs." } },
    { '@type': 'Question', name: 'Do I need a permit for tree removal in Perris, CA?', acceptedAnswer: { '@type': 'Answer', text: "Most residential tree removals in Perris don't require a permit. However, trees in unincorporated Riverside County portions of the area may have different rules than City of Perris parcels. We determine the applicable jurisdiction during your estimate and check any permit requirements. Protected species like coast live oaks always require special review regardless of location." } },
    { '@type': 'Question', name: 'What\'s the most common tree problem you see on Perris properties?', acceptedAnswer: { '@type': 'Answer', text: 'In Perris, the most frequent issues we handle are overgrown eucalyptus trees (a liability near structures), invasive pepper trees with surface roots damaging driveways and patios, and large palms that have grown beyond the property\'s scale. We also see storm-damaged trees and trees weakened by prolonged drought stress that have become safety hazards.' } },
  ],
};
---

<BaseLayout
  title="Tree Service Perris CA | Free Estimate"
  description="Licensed tree service in Perris, CA. Tree removal, trimming, stump grinding, and 24/7 emergency response. Serving new construction neighborhoods and established communities near Lake Perris. Free estimates."
  canonicalUrl="https://murrietatreeexperts.com/perris/"
>
  <Hero
    headline="Tree Service in Perris, CA — Certified & Ready"
    subheadline="Licensed arborists serving all of Perris — from new construction subdivisions near the 215 freeway to established neighborhoods near Lake Perris. Tree removal, trimming, stump grinding, and emergency service. Free estimates."
    ctaText="Get a Free Quote"
    secondaryCtaText={`Call ${SITE_CONFIG.phone}`}
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Tree Services We Offer in Perris</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      Whether you're a new homeowner in one of Perris's fast-growing subdivisions or an established resident near Lake Perris State Recreation Area, our certified arborists have the right solution for your trees.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Tree Service for Perris's Fast-Growing Communities</h2>
      <p>
        Perris is one of Inland Southern California's fastest-growing cities, with a population of about 80,000 and expanding rapidly. New subdivisions have been rising throughout Perris for the past decade, bringing an influx of new homeowners who are planting trees for the first time or dealing with builder-standard trees that need professional care to establish properly. Young trees planted in compacted builder soil often develop weak structure without early corrective pruning — our arborists can establish good architecture early before problems become expensive.
      </p>

      <h2>Tree Removal for New Construction in Perris</h2>
      <p>
        Perris's rapid growth often means construction activity near existing trees — additions, ADUs, pool installations, and hardscape projects that require root zone clearing or full tree removal. We provide clean, efficient tree removal with proper root management to protect underground utilities and neighboring structures. We pull all required permits when needed and coordinate with general contractors and landscapers to keep your project timeline on track.
      </p>

      <h2>Mature Trees Near Lake Perris and Older Neighborhoods</h2>
      <p>
        The older residential areas of Perris — particularly neighborhoods near Lake Perris State Recreation Area and the historic downtown corridor — have large, mature trees that have been growing for decades. Many of these trees are now approaching the end of their structural lifespan or have developed significant deadwood that poses a falling hazard during Santa Ana wind events. Our arborists conduct thorough visual assessments and can identify risk before a tree becomes an emergency.
      </p>

      <h2>Emergency Tree Service in Perris</h2>
      <p>
        Wind events in the Perris Valley can be intense — funneled between mountain ranges and intensified by the topography. When a tree falls on a fence, structure, or vehicle, you need someone on-site fast. Our emergency team is available 24 hours a day, seven days a week. We respond quickly, assess the risk, remove what needs to go, and document everything for insurance purposes if needed.
      </p>

      <h2>Why Perris Homeowners Choose Us</h2>
      <p>
        We're based in Murrieta — about 25 minutes from most Perris neighborhoods — and we serve the broader southwest Riverside County area regularly. All our arborists are California licensed and carry full liability insurance and workers' compensation coverage. We provide written estimates before any work begins, haul all debris from the site, and don't consider the job done until you're satisfied. No hidden fees, no pressure tactics.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Hemet', 'Perris'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Tree Service in Perris</h2>
    <div class="space-y-4">
      {[
        { q: "Do you serve Perris's newer master-planned communities like Harvest at Citrus Heights?", a: "Yes — we work throughout Perris including Harvest at Citrus Heights, Stoneridge, Mead Valley, and surrounding areas. Newer developments in Perris often have fast-growing developer-installed trees that are now reaching problem sizes. We handle both routine maintenance trimming and full removal when a tree has outgrown its location." },
        { q: "How do you handle tree removal on large agricultural or commercial lots in Perris?", a: "Perris has a mix of residential, agricultural, and industrial properties, and we handle all of them. Large lots give us better equipment access, which often reduces cost. For agricultural land with multiple trees, we can bundle removals into one visit for efficiency. We also work with commercial property managers on tree maintenance programs." },
        { q: "Do I need a permit for tree removal in Perris, CA?", a: "Most residential tree removals in Perris don't require a permit. However, trees in unincorporated Riverside County portions of the area may have different rules than City of Perris parcels. We determine the applicable jurisdiction during your estimate and check any permit requirements. Protected species like coast live oaks always require special review regardless of location." },
        { q: "What's the most common tree problem you see on Perris properties?", a: "In Perris, the most frequent issues we handle are overgrown eucalyptus trees (a liability near structures), invasive pepper trees with surface roots damaging driveways and patios, and large palms that have grown beyond the property's scale. We also see storm-damaged trees and trees weakened by prolonged drought stress that have become safety hazards." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Tree Service Quote in Perris" />
  </section>
</BaseLayout>
