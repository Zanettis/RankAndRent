---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you remove trees in HOA communities like Redhawk and Wolf Creek in Temecula?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — we work throughout Temecula\'s HOA communities including Redhawk, Wolf Creek, Paloma del Sol, Crowne Hill, and Harveston. Many HOAs require written approval before tree removal, and we\'ll guide you through that process and provide documentation if needed. We\'re familiar with the common tree species in these communities and handle permit coordination when required.' } },
    { '@type': 'Question', name: 'Do I need a city permit to remove a tree in Temecula?', acceptedAnswer: { '@type': 'Answer', text: 'Most residential tree removals in Temecula do not require a city permit. However, protected tree species — such as California oaks — and trees in designated open space areas near wine country properties may require approval from the City of Temecula Planning Department. We check permit requirements during your free estimate at no additional charge.' } },
    { '@type': 'Question', name: 'How do Santa Ana wind events affect tree safety in Temecula?', acceptedAnswer: { '@type': 'Answer', text: 'Santa Ana winds hit the Temecula area hard — especially in fall and early winter — and are the primary cause of emergency tree failures in the region. Trees with unbalanced canopies, compromised root systems, or disease are most vulnerable. We recommend a pre-season canopy reduction for large trees near structures. Our 24/7 emergency team is available when storms cause sudden tree failures.' } },
    { '@type': 'Question', name: 'How much does tree removal typically cost in Temecula, CA?', acceptedAnswer: { '@type': 'Answer', text: 'Tree removal in Temecula typically runs $300–$2,000+ depending on tree size, location, and access. Small trees under 25 feet cost $300–$600; large mature trees over 50 feet near structures run $800–$2,000+. Wine country estates with limited equipment access may incur additional labor costs. We provide free written estimates with no obligation.' } },
  ],
};
---

<BaseLayout
  title="Tree Service Temecula, CA | Tree Removal, Trimming & Stump Grinding"
  description="Professional tree removal, trimming, and stump grinding in Temecula, CA. Licensed arborists, 24/7 emergency service, free estimates. Serving Redhawk, Wolf Creek, Paloma del Sol, and all Temecula communities."
  canonicalUrl="https://murrietatreeexperts.com/temecula/"
>
  <Hero
    headline="Tree Service in Temecula, CA — Licensed & Ready Today"
    subheadline="Certified arborists serving all of Temecula — from Wine Country estates to Redhawk and Wolf Creek neighborhoods. Tree removal, trimming, stump grinding, and 24/7 emergency service. Free estimates."
    ctaText="Get a Free Quote"
    secondaryCtaText={`Call ${SITE_CONFIG.phone}`}
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Tree Services We Offer in Temecula</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From routine trimming to emergency storm damage, our certified arborists handle every tree challenge in Temecula's unique inland wine country climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Tree Care in Temecula's Unique Climate</h2>
      <p>
        Temecula sits at the edge of Southern California's wine country, where warm, dry summers, periodic Santa Ana winds, and clay-heavy soils create specific challenges for trees. Oak trees throughout communities like Crowne Hill and Harveston face stress from drought conditions, while eucalyptus trees in older neighborhoods can grow dangerously large without regular maintenance. Our arborists know Temecula's tree inventory — and we know when a tree can be saved with trimming versus when removal is the safer choice.
      </p>

      <h2>Serving All Temecula Neighborhoods</h2>
      <p>
        We provide tree service throughout Temecula, including Redhawk, Wolf Creek, Paloma del Sol, Crowne Hill, Harveston, Morgan Hill, Great Oak, and the communities surrounding Old Town Temecula and Pechanga Resort. Whether you're on a hillside lot in Wine Country or a newer subdivision near Promenade Temecula, we come to you — with no travel fee within our service area.
      </p>

      <h2>Emergency Tree Service in Temecula</h2>
      <p>
        Temecula's seasonal windstorms and occasional severe weather events can bring down branches or entire trees without warning. Our emergency tree service team is available 24/7 for urgent situations — fallen trees blocking driveways, hazardous limbs over rooflines, and storm damage cleanup. We respond fast and prioritize safe removal to protect your property.
      </p>

      <h2>Why Temecula Homeowners Choose Us</h2>
      <p>
        We're locally based in the Murrieta/Temecula Valley — not a franchise dispatching crews from hours away. All our arborists are California licensed, and we carry full liability and workers' compensation insurance on every job. We provide written estimates before any work begins, and we leave your property clean — wood chipped, debris hauled, site raked. No hidden fees, no pressure.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Temecula Valley</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Tree Service in Temecula</h2>
    <div class="space-y-4">
      {[
        { q: "Do you remove trees in HOA communities like Redhawk and Wolf Creek in Temecula?", a: "Yes — we work throughout Temecula's HOA communities including Redhawk, Wolf Creek, Paloma del Sol, Crowne Hill, and Harveston. Many HOAs require written approval before tree removal, and we'll guide you through that process and provide documentation if needed. We're familiar with the common tree species in these communities and handle permit coordination when required." },
        { q: "Do I need a city permit to remove a tree in Temecula?", a: "Most residential tree removals in Temecula do not require a city permit. However, protected tree species — such as California oaks — and trees in designated open space areas near wine country properties may require approval from the City of Temecula Planning Department. We check permit requirements during your free estimate at no additional charge." },
        { q: "How do Santa Ana wind events affect tree safety in Temecula?", a: "Santa Ana winds hit the Temecula area hard — especially in fall and early winter — and are the primary cause of emergency tree failures in the region. Trees with unbalanced canopies, compromised root systems, or disease are most vulnerable. We recommend a pre-season canopy reduction for large trees near structures. Our 24/7 emergency team is available when storms cause sudden tree failures." },
        { q: "How much does tree removal typically cost in Temecula, CA?", a: "Tree removal in Temecula typically runs $300–$2,000+ depending on tree size, location, and access. Small trees under 25 feet cost $300–$600; large mature trees over 50 feet near structures run $800–$2,000+. Wine country estates with limited equipment access may incur additional labor costs. We provide free written estimates with no obligation." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Tree Service Quote in Temecula" />
  </section>
</BaseLayout>
