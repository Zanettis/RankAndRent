---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you provide tree service in older historic neighborhoods in San Jacinto?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — many San Jacinto neighborhoods have mature trees dating back 40–80 years, often in tight urban lots. We specialize in technical removals where limited equipment access and proximity to structures require careful section-by-section climbing work. We\'ve worked extensively throughout downtown San Jacinto, Ramona Bowl area, and surrounding established neighborhoods.' } },
    { '@type': 'Question', name: "How does San Jacinto Valley's summer heat affect tree health?", acceptedAnswer: { '@type': 'Answer', text: 'The San Jacinto Valley experiences extreme summer heat, with temperatures regularly exceeding 105°F. This stress affects water intake and can accelerate disease progression in drought-weakened trees. We see a spike in calls each fall when trees that looked fine in spring have declined through summer. Annual health assessments help catch problems before they become safety hazards.' } },
    { '@type': 'Question', name: 'Do you handle large rural tree removals near the San Jacinto Mountains foothills?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — we service properties in the foothills east of San Jacinto, including areas near Idyllwild Road and the communities between San Jacinto and Beaumont. Rural and foothill properties often have large old-growth trees that require advanced rigging to remove safely. We assess site access and tree condition together to develop a safe removal plan.' } },
    { '@type': 'Question', name: "What's the typical cost for tree service in San Jacinto?", acceptedAnswer: { '@type': 'Answer', text: 'Tree removal in San Jacinto typically runs $300–$1,800 depending on tree size, access, and location. Urban lots with older mature trees often require more labor than rural properties with good equipment access. We provide free written estimates with no obligation — call or submit a request online to schedule.' } },
  ],
};
---

<BaseLayout
  title="Tree Service San Jacinto, CA | Tree Removal, Trimming & Stump Grinding"
  description="Licensed tree service in San Jacinto, CA. Tree removal, trimming, stump grinding, and 24/7 emergency response. Serving all San Jacinto neighborhoods in the San Jacinto Valley. Free estimates."
  canonicalUrl="https://murrietatreeexperts.com/san-jacinto/"
>
  <Hero
    headline="Tree Service in San Jacinto, CA — Licensed & Local"
    subheadline="Certified arborists serving all of San Jacinto's neighborhoods — from mature eucalyptus and palms in historic residential areas to fire-risk trees on the valley's edge. Tree removal, trimming, stump grinding, and emergency service. Free estimates."
    ctaText="Get a Free Quote"
    secondaryCtaText={`Call ${SITE_CONFIG.phone}`}
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Tree Services We Offer in San Jacinto</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From aging eucalyptus and overgrown palms in San Jacinto's established neighborhoods to hazard trees near newer residential developments, our certified arborists handle every tree challenge professionally and at fair prices.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Tree Care in San Jacinto's Historic Neighborhoods</h2>
      <p>
        San Jacinto is one of Riverside County's oldest incorporated cities — founded in 1888 — and that history is visible in its residential neighborhoods. Many properties in San Jacinto have mature trees that were planted 40–60 years ago: eucalyptus lining older streets, sprawling mulberry trees in back yards, and large palms that have grown far beyond what a homeowner can safely manage. Our certified arborists serve all of San Jacinto's established areas, providing honest assessments and safe tree work for homes with older-growth trees that have become hazards or are simply overdue for professional attention.
      </p>

      <h2>Fire Season Risk and Tree Hazard Assessment</h2>
      <p>
        San Jacinto sits at the edge of the San Jacinto Valley, with Mt. San Jacinto State Park to the east and open desert terrain surrounding much of the city. During fire season — which in Southern California now runs most of the year — overgrown or dead trees on residential properties represent a genuine risk. Eucalyptus trees, common throughout San Jacinto's older neighborhoods, are particularly flammable and drop volatile litter year-round. We assess fire-risk trees, remove dead and dying wood, and help homeowners create defensible space around their properties in compliance with CAL FIRE guidelines.
      </p>

      <h2>Palm Tree Removal and Trimming in San Jacinto</h2>
      <p>
        Mexican fan palms and date palms are found throughout San Jacinto's residential areas and along many of its main corridors. Untrimmed palm skirts — the accumulation of dead fronds — create nesting habitat for rats and a fire hazard during dry summer months. We handle full crown cleaning, skirt removal, and complete palm removal for trees of any height. All work is done using proper rigging and equipment to protect neighboring structures throughout the process.
      </p>

      <h2>Serving All San Jacinto Neighborhoods</h2>
      <p>
        We provide tree service throughout San Jacinto, including the historic downtown area, neighborhoods near Ramona Boulevard, the San Jacinto Valley Academy area, and residential communities along Lyon Avenue and State Street. We also serve properties near the edge of the San Jacinto Wildlife Area and throughout the surrounding unincorporated areas of Riverside County. Our team is based in Murrieta — about 35–45 minutes via I-215 and CA-74 — and serves San Jacinto regularly with no additional travel fees.
      </p>

      <h2>Emergency Tree Service in San Jacinto</h2>
      <p>
        Windstorms off the pass and summer heat stress can push already-weakened trees over the edge without warning. Our emergency response team is available 24 hours a day, seven days a week for fallen trees, split limbs, and storm damage in San Jacinto. We respond promptly, stabilize the situation, and provide a clear written estimate before any additional work begins. We work with most homeowner insurance carriers and can document storm or wind damage thoroughly for a claim.
      </p>

      <h2>Fair Pricing for San Jacinto Homeowners</h2>
      <p>
        We price our work honestly for San Jacinto homeowners. There are no surprise fees, no pressure upsells, and no inflated estimates. We give you an honest assessment of what actually needs to be done — and what can safely wait. Our written estimates are free, we haul all debris from the site, and we stand behind every job with a satisfaction guarantee.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Hemet', 'Perris', 'San Jacinto', 'Fallbrook'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Tree Service in San Jacinto</h2>
    <div class="space-y-4">
      {[
        { q: "Do you provide tree service in older historic neighborhoods in San Jacinto?", a: "Yes — many San Jacinto neighborhoods have mature trees dating back 40–80 years, often in tight urban lots. We specialize in technical removals where limited equipment access and proximity to structures require careful section-by-section climbing work. We've worked extensively throughout downtown San Jacinto, Ramona Bowl area, and surrounding established neighborhoods." },
        { q: "How does San Jacinto Valley's summer heat affect tree health?", a: "The San Jacinto Valley experiences extreme summer heat, with temperatures regularly exceeding 105°F. This stress affects water intake and can accelerate disease progression in drought-weakened trees. We see a spike in calls each fall when trees that looked fine in spring have declined through summer. Annual health assessments help catch problems before they become safety hazards." },
        { q: "Do you handle large rural tree removals near the San Jacinto Mountains foothills?", a: "Yes — we service properties in the foothills east of San Jacinto, including areas near Idyllwild Road and the communities between San Jacinto and Beaumont. Rural and foothill properties often have large old-growth trees that require advanced rigging to remove safely. We assess site access and tree condition together to develop a safe removal plan." },
        { q: "What's the typical cost for tree service in San Jacinto?", a: "Tree removal in San Jacinto typically runs $300–$1,800 depending on tree size, access, and location. Urban lots with older mature trees often require more labor than rural properties with good equipment access. We provide free written estimates with no obligation — call or submit a request online to schedule." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Tree Service Quote in San Jacinto" />
  </section>
</BaseLayout>
