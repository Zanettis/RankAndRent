---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you work on hillside and sloped lots in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — hillside and sloped properties are common in Wildomar, especially in Heritage Lake, Palomar Hills, and Clinton Keith Estates. We have specialized rigging equipment and technique for trees on steep terrain where a ground-level crew can\'t operate safely. Our arborists assess each sloped job individually and develop a removal plan that protects structures below.' } },
    { '@type': 'Question', name: 'Are there tree removal permit requirements in Wildomar, CA?', acceptedAnswer: { '@type': 'Answer', text: 'Wildomar follows Riverside County land use guidelines for tree removal on unincorporated parcels. Most standard residential tree removals do not require a permit, but protected oak species or trees in riparian corridors near Wildomar Creek may need county review. We check applicable requirements during your free estimate and handle the process for you.' } },
    { '@type': 'Question', name: "How does Wildomar's clay soil affect tree root systems?", acceptedAnswer: { '@type': 'Answer', text: "Wildomar's heavy clay soils drain poorly, which can lead to root rot in susceptible tree species and cause surface roots to spread wide and shallow rather than anchoring deep. This creates both a stability risk and a sidewalk/driveway damage concern. We assess root health during our estimate and can recommend whether removal or crown reduction is the right approach." } },
    { '@type': 'Question', name: 'Do you serve Heritage Lake and Palomar Hills communities in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: "Yes — we service all of Wildomar's communities including Heritage Lake, Palomar Hills, and properties along Clinton Keith Road and Grand Avenue. We're familiar with the common tree species in these neighborhoods — particularly Canary Island palms, sycamores, and eucalyptus — and understand the access constraints on Wildomar's hillside lots." } },
    { '@type': 'Question', name: 'What tree services are available in Wildomar, CA?', acceptedAnswer: { '@type': 'Answer', text: 'We offer the full range of tree services in Wildomar: tree removal (including hillside and tight-access lots), tree trimming and pruning, stump grinding, land clearing, emergency tree service (24/7), and tree planting. All work is performed by licensed arborists with California C-61/D-49 contractor certification and full liability insurance.' } },
    { '@type': 'Question', name: 'How quickly can you respond to a tree emergency in Wildomar?', acceptedAnswer: { '@type': 'Answer', text: 'We offer 24/7 emergency tree service in Wildomar. For active hazards — fallen tree blocking access, limb on a roof, tree leaning toward a structure — we respond the same day and are typically on-site within 2–4 hours of your call. We stabilize the hazard immediately and complete the full removal in a follow-up visit if needed.' } },
  ],
};
---

<BaseLayout
  title="Tree Service Wildomar, CA | Tree Removal & Trimming | Free Estimates"
  description="Licensed tree service in Wildomar, CA. Tree removal, trimming, stump grinding, and 24/7 emergency response. Hillside lots, fire-zone trees, and HOA compliance. Free estimates."
  canonicalUrl="https://murrietatreeexperts.com/wildomar/"
>
  <Hero
    headline="Tree Service in Wildomar, CA — Licensed & Local"
    subheadline="Certified arborists serving Wildomar's hillside properties, Heritage Lake, and rural lots. Tree removal, trimming, stump grinding, and 24/7 emergency service. Free estimates."
    ctaText="Get a Free Quote"
    secondaryCtaText={`Call ${SITE_CONFIG.phone}`}
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Tree Services We Offer in Wildomar</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      Wildomar's mix of hillside lots, rural parcels, and newer subdivisions creates unique tree challenges. Our arborists handle every situation safely and efficiently.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Tree Care on Wildomar's Hillside and Rural Properties</h2>
      <p>
        Wildomar sits between Murrieta and Lake Elsinore, with a landscape that ranges from flat suburban streets to steep hillside lots bordering undeveloped open space. That mix creates real tree hazards: large oaks and eucalyptus growing on uneven terrain, root systems undermining driveways and retaining walls, and mature trees weakened by Wildomar's clay soils and periodic drought stress. Our arborists are experienced working on sloped lots and rural parcels where crane access or specialized rigging is required.
      </p>

      <h2>Fire Risk and Defensible Space in Wildomar</h2>
      <p>
        Portions of Wildomar — particularly properties bordering open hillsides and canyon areas — fall within CAL FIRE's designated Wildland-Urban Interface (WUI) zones. Homeowners in these areas are required to maintain 100 feet of defensible space, which includes removing dead trees and shrubs, clearing ladder fuels, and keeping trees trimmed away from rooflines. We perform defensible space clearance work that meets CAL FIRE and Riverside County standards. If an inspection is coming up or you've received a compliance notice, we respond quickly.
      </p>

      <h2>Wildomar Neighborhoods We Serve</h2>
      <p>
        We provide tree services throughout all of Wildomar, CA — from established neighborhoods to rural parcels:
      </p>
      <ul>
        <li><strong>Heritage Lake</strong> — HOA community with Canary Island palms and mature oaks; we handle HOA permit coordination</li>
        <li><strong>Palomar Hills</strong> — hillside lots with steep grade; specialized rigging equipment on every job</li>
        <li><strong>The Farm</strong> — rural agricultural parcels; land clearing and orchard tree removal</li>
        <li><strong>Clinton Keith Estates</strong> — larger residential lots with mature eucalyptus and sycamore</li>
        <li><strong>Wildomar Ridge</strong> — WUI fire zone; defensible space clearance and dead-tree removal</li>
        <li><strong>Bundy Canyon Road corridor</strong> — rural-to-suburban transition; mixed tree populations</li>
        <li><strong>Grand Avenue / I-15 corridor</strong> — commercial and newer residential</li>
        <li>Unincorporated Riverside County parcels adjacent to Wildomar city limits</li>
      </ul>
      <p>No travel fee for any Wildomar address. We're based in Murrieta — typically 10–15 minutes away.</p>

      <h2>Emergency Tree Service in Wildomar</h2>
      <p>
        Santa Ana wind events hit Wildomar's hillside properties hard. A single strong gust can topple a weakened oak or bring down a large eucalyptus branch onto a roof or fence. Our 24/7 emergency response team is available any time a fallen or hanging tree creates an immediate hazard. We stabilize the situation, remove the debris, and provide a written assessment of surrounding trees that may present future risk.
      </p>

      <h2>Why Wildomar Homeowners Choose Us</h2>
      <p>
        We're based in the Murrieta area — close enough to Wildomar that we respond fast. All our arborists carry California licenses and we maintain full liability and workers' comp insurance on every job. We provide written estimates before work begins, haul all debris, and leave your property clean. No surprise charges, no pressure to add services.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Wildomar', 'Menifee', 'Lake Elsinore', 'Canyon Lake', 'Winchester'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Tree Service in Wildomar</h2>
    <div class="space-y-4">
      {[
        { q: "Do you work on hillside and sloped lots in Wildomar?", a: "Yes — hillside and sloped properties are common in Wildomar, especially in Heritage Lake, Palomar Hills, and Clinton Keith Estates. We have specialized rigging equipment and technique for trees on steep terrain where a ground-level crew can't operate safely. Our arborists assess each sloped job individually and develop a removal plan that protects structures below." },
        { q: "Are there tree removal permit requirements in Wildomar, CA?", a: "Wildomar follows Riverside County land use guidelines for tree removal on unincorporated parcels. Most standard residential tree removals do not require a permit, but protected oak species or trees in riparian corridors near Wildomar Creek may need county review. We check applicable requirements during your free estimate and handle the process for you." },
        { q: "How does Wildomar's clay soil affect tree root systems?", a: "Wildomar's heavy clay soils drain poorly, which can lead to root rot in susceptible tree species and cause surface roots to spread wide and shallow rather than anchoring deep. This creates both a stability risk and a sidewalk/driveway damage concern. We assess root health during our estimate and can recommend whether removal or crown reduction is the right approach." },
        { q: "Do you serve Heritage Lake and Palomar Hills communities in Wildomar?", a: "Yes — we service all of Wildomar's communities including Heritage Lake, Palomar Hills, and properties along Clinton Keith Road and Grand Avenue. We're familiar with the common tree species in these neighborhoods — particularly Canary Island palms, sycamores, and eucalyptus — and understand the access constraints on Wildomar's hillside lots." },
        { q: "What tree services are available in Wildomar, CA?", a: "We offer the full range of tree services in Wildomar: tree removal (including hillside and tight-access lots), tree trimming and pruning, stump grinding, land clearing, emergency tree service (24/7), and tree planting. All work is performed by licensed arborists with California C-61/D-49 contractor certification and full liability insurance." },
        { q: "How quickly can you respond to a tree emergency in Wildomar?", a: "We offer 24/7 emergency tree service in Wildomar. For active hazards — fallen tree blocking access, limb on a roof, tree leaning toward a structure — we respond the same day and are typically on-site within 2–4 hours of your call. We stabilize the hazard immediately and complete the full removal in a follow-up visit if needed." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Tree Service Quote in Wildomar" />
  </section>
</BaseLayout>
