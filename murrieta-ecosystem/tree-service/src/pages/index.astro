---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE_CONFIG } from '../config';
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.jpg';
import climberImg from '../assets/images/climber.jpg';
import crewImg from '../assets/images/crew.jpg';

const serviceIcons = [
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3L4 12h5l-3 6h12l-3-6h5L12 3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v3M10 21h4"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-8 h-8"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path stroke-linecap="round" d="M20 4L8.12 15.88M14.47 14.48L20 20M8.12 8.12L12 12"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-8 h-8"><circle cx="12" cy="12" r="3"/><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/></svg>`,
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-8 h-8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does tree removal cost in Murrieta, CA?',
      acceptedAnswer: { '@type': 'Answer', text: 'Tree removal in Murrieta typically costs $300–$1,800+ depending on tree size, location, and complexity. Small trees under 25 ft run $300–$600. Large trees over 60 ft, or trees near structures, run $800–$2,000+. We provide free on-site written estimates with no obligation.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need a permit to remove a tree in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most residential tree removals in Murrieta do not require a permit, but some protected species (like coast live oaks) and trees in certain HOA communities may. We\'ll advise you on permit requirements during your free estimate at no extra charge.' },
    },
    {
      '@type': 'Question',
      name: 'How long does tree removal take?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most standard tree removals take 2–6 hours. Large trees or complex jobs near structures or power lines may take a full day. We\'ll give you a realistic time estimate when we assess the job.' },
    },
    {
      '@type': 'Question',
      name: 'Do you clean up after the job?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes — complete cleanup is always included. We chip all branches, haul away debris, and rake the area clean. Stump grinding is an optional add-on. You\'ll be left with a clean yard, no mess.' },
    },
    {
      '@type': 'Question',
      name: 'Can you remove trees near power lines or my house?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Our certified arborists are trained in hazard tree removal and work safely near structures and utilities. For trees directly contacting power lines, we coordinate with the utility company as required.' },
    },
    {
      '@type': 'Question',
      name: 'Do you offer emergency tree service?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes — 24/7 emergency service is available for storm damage, fallen trees, and hazardous situations. Call us any time for emergency response in Murrieta, Temecula, and surrounding areas.' },
    },
  ],
};

const testimonials = [
  {
    quote: "They came out the same day I called. The crew was professional, cleaned up everything, and the price was fair. My oak tree is gone and the yard looks great.",
    name: "James R.",
    location: "Murrieta, CA",
  },
  {
    quote: "I had a huge pine leaning over my roof after the windstorm. These guys had it down safely in a few hours. Worth every penny for the peace of mind.",
    name: "Sandra M.",
    location: "Temecula, CA",
  },
  {
    quote: "Very knowledgeable about local trees. They trimmed three of my eucalyptus trees and explained exactly what needed to be done. Showed up on time and left the yard spotless.",
    name: "David & Karen T.",
    location: "Murrieta, CA",
  },
];
---

<BaseLayout
  title="Tree Service Murrieta, CA | Professional Tree Removal & Trimming"
  description="Expert tree removal, trimming, and stump grinding in Murrieta, CA. Licensed & insured. 24/7 emergency service. Free estimates — call today!"
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Hero
    headline="Need a Tree Removed in Murrieta? We're Ready Today."
    subheadline="Professional tree removal, trimming, and stump grinding in Murrieta and the Temecula Valley. Licensed, insured, and locally owned — free estimates, no obligation."
    ctaText="Get a Free Quote"
    secondaryCtaText={`Call ${SITE_CONFIG.phone}`}
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
    backgroundImage={heroImg.src}
  />

  <!-- Trust Bar -->
  <div class="bg-white border-b border-gray-100 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-gray-600">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        CA Licensed Arborists
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
        Fully Insured
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        Free Estimates
      </span>
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-primary flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Same-Day Response
      </span>
    </div>
  </div>

  <!-- Services -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Our Tree Services</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From routine pruning to emergency storm damage, our certified arborists handle every tree
      challenge in Murrieta's unique inland Southern California climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service, i) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          href={service.href}
          icon={serviceIcons[i] ?? serviceIcons[0]}
        />
      ))}
    </div>
  </section>

  <!-- Our Work -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Our Work in Murrieta</h2>
    <p class="text-gray-600 text-center mb-10">Certified arborists handling every job safely and professionally.</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="overflow-hidden rounded-xl shadow-md">
        <Image
          src={climberImg}
          alt="Certified arborist climbing a large eucalyptus tree in Murrieta"
          width={600}
          height={288}
          loading="lazy"
          class="w-full h-72 object-cover object-center hover:scale-105 transition-transform duration-500"
        />
        <div class="bg-gray-50 px-4 py-3">
          <p class="text-sm font-semibold text-primary">Tree Climbing & Precision Removal</p>
          <p class="text-xs text-gray-500 mt-1">Safe ascent and controlled sectional removal</p>
        </div>
      </div>
      <div class="overflow-hidden rounded-xl shadow-md">
        <Image
          src={crewImg}
          alt="Tree service crew cutting fallen pine tree in Murrieta with chainsaws"
          width={600}
          height={288}
          loading="lazy"
          class="w-full h-72 object-cover object-center hover:scale-105 transition-transform duration-500"
        />
        <div class="bg-gray-50 px-4 py-3">
          <p class="text-sm font-semibold text-primary">Full Crew — Storm Damage & Large Trees</p>
          <p class="text-xs text-gray-500 mt-1">Experienced teams with professional equipment</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-primary text-center mb-10">Why Murrieta Homeowners Choose Us</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="flex justify-center mb-4">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
          <h3 class="font-bold text-primary text-lg mb-2">10+ Years Local Experience</h3>
          <p class="text-gray-600 text-sm">We know Murrieta's trees, clay soils, and fire season requirements better than anyone.</p>
        </div>
        <div class="text-center">
          <div class="flex justify-center mb-4">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
          </div>
          <h3 class="font-bold text-primary text-lg mb-2">Fully Licensed & Insured</h3>
          <p class="text-gray-600 text-sm">California licensed arborists with full liability and workers' comp coverage on every job.</p>
        </div>
        <div class="text-center">
          <div class="flex justify-center mb-4">
            <div class="w-14 h-14 bg-primary/10 rounded-full flex items-center justify-center">
              <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
              </svg>
            </div>
          </div>
          <h3 class="font-bold text-primary text-lg mb-2">Free, No-Obligation Estimates</h3>
          <p class="text-gray-600 text-sm">We'll come to your property and give you a written estimate at no charge, with no pressure.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">What Murrieta Homeowners Say</h2>
    <p class="text-gray-600 text-center mb-10">Real customers, real results.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((t) => (
        <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm flex flex-col gap-4">
          <div class="flex gap-1">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 fill-yellow-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <p class="text-gray-700 text-sm leading-relaxed flex-1">"{t.quote}"</p>
          <div>
            <p class="font-semibold text-primary text-sm">{t.name}</p>
            <p class="text-gray-500 text-xs">{t.location}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Service Area -->
  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-primary mb-4">Serving All of Murrieta</h2>
      <p class="text-gray-600 max-w-3xl mx-auto mb-8">
        We serve all Murrieta neighborhoods including Old Town, Bear Creek, Murrieta Oaks, Copper Canyon,
        Greer Ranch, and surrounding communities in Temecula, Wildomar, and Lake Elsinore.
      </p>
      <a href="/services/tree-removal" class="text-cta font-semibold hover:underline">
        See all services →
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="max-w-4xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
    <div class="space-y-4">
      {[
        {
          q: "How much does tree removal cost in Murrieta, CA?",
          a: "Tree removal in Murrieta typically costs $300–$1,800+ depending on tree size, location, and complexity. Small trees under 25 ft run $300–$600. Large trees over 60 ft, or trees near structures, run $800–$2,000+. We provide free on-site written estimates with no obligation."
        },
        {
          q: "Do I need a permit to remove a tree in Murrieta?",
          a: "Most residential tree removals in Murrieta do not require a permit, but some protected species (like coast live oaks) and trees in certain HOA communities may. We'll advise you on permit requirements during your free estimate at no extra charge."
        },
        {
          q: "How long does tree removal take?",
          a: "Most standard tree removals take 2–6 hours. Large trees or complex jobs near structures or power lines may take a full day. We'll give you a realistic time estimate when we assess the job."
        },
        {
          q: "Do you clean up after the job?",
          a: "Yes — complete cleanup is always included. We chip all branches, haul away debris, and rake the area clean. Stump grinding is an optional add-on. You'll be left with a clean yard, no mess."
        },
        {
          q: "Can you remove trees near power lines or my house?",
          a: "Yes. Our certified arborists are trained in hazard tree removal and work safely near structures and utilities. For trees directly contacting power lines, we coordinate with the utility company as required."
        },
        {
          q: "Do you offer emergency tree service?",
          a: "Yes — 24/7 emergency service is available for storm damage, fallen trees, and hazardous situations. Call us any time for emergency response in Murrieta, Temecula, and surrounding areas."
        },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Ready to Get Started? Get Your Free Quote" />
  </section>
</BaseLayout>
