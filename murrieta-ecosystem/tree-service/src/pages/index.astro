---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LeadForm from '../components/LeadForm.astro';
import { SITE_CONFIG } from '../config';

const icons = ['🪓', '✂️', '🌀', '⚡'];
---

<BaseLayout
  title="Tree Service Murrieta, CA | Professional Tree Removal & Trimming"
  description="Expert tree removal, trimming, and stump grinding in Murrieta, CA. Licensed & insured. 24/7 emergency service. Free estimates — call today!"
>
  <Hero
    headline="Murrieta's Most Trusted Tree Service"
    subheadline="Professional tree removal, trimming, and stump grinding. Serving Murrieta and the Temecula Valley. Licensed, insured, and locally owned."
    ctaText="Get a Free Quote"
    secondaryCtaText="Call Now"
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Our Tree Services</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From routine pruning to emergency storm damage, our certified arborists handle every tree
      challenge in Murrieta's unique inland Southern California climate.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service, i) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          href={service.href}
          icon={icons[i] ?? '🌳'}
        />
      ))}
    </div>
  </section>

  <section class="bg-gray-50 py-16 px-4">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-primary text-center mb-4">Why Murrieta Homeowners Choose Us</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-10">
        <div class="text-center">
          <div class="text-4xl mb-3">🏆</div>
          <h3 class="font-bold text-primary text-lg mb-2">10+ Years Local Experience</h3>
          <p class="text-gray-600 text-sm">We know Murrieta's trees, clay soils, and fire season requirements better than anyone.</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-3">🛡️</div>
          <h3 class="font-bold text-primary text-lg mb-2">Fully Licensed & Insured</h3>
          <p class="text-gray-600 text-sm">California licensed arborists with full liability and workers' comp coverage on every job.</p>
        </div>
        <div class="text-center">
          <div class="text-4xl mb-3">💰</div>
          <h3 class="font-bold text-primary text-lg mb-2">Free, No-Obligation Estimates</h3>
          <p class="text-gray-600 text-sm">We'll come to your property and give you a written estimate at no charge, with no pressure.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Serving All of Murrieta</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto mb-8">
      We serve all Murrieta neighborhoods including Old Town, Bear Creek, Murrieta Oaks, Copper Canyon,
      Greer Ranch, and surrounding communities in Temecula, Wildomar, and Lake Elsinore.
    </p>
    <div class="text-center">
      <a href="/services/tree-removal" class="text-cta font-semibold hover:underline">
        See all services →
      </a>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 pb-16">
    <LeadForm heading="Ready to Get Started? Get Your Free Quote" />
  </section>
</BaseLayout>
