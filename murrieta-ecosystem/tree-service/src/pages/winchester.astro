---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import LeadForm from '../components/LeadForm.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SITE_CONFIG } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Do you service rural and semi-rural properties in Winchester, CA?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — we regularly work on rural and semi-rural lots in Winchester, including large acreage properties, horse properties, and newer tract homes in communities like Winchester Commons and Morningstar Ranch. We bring the right equipment for both tight suburban lots and open rural properties where larger trees may have grown unchecked for years.' } },
    { '@type': 'Question', name: 'How much does tree removal cost in Winchester, CA?', acceptedAnswer: { '@type': 'Answer', text: 'Tree removal in Winchester typically runs $300–$1,800+ depending on tree size, species, and access. Rural properties with large native oaks or overgrown eucalyptus at the high end of that range. Newer tract homes with smaller ornamental trees are often on the lower end. We provide free written estimates — contact us to schedule an on-site assessment.' } },
    { '@type': 'Question', name: 'Do you remove native oak trees in Winchester?', acceptedAnswer: { '@type': 'Answer', text: 'We do remove oak trees in Winchester, but California oak trees may be subject to protections under Riverside County ordinance depending on trunk diameter and species. We check permit requirements during your free estimate and guide you through the process if approval is needed. In many cases, trimming or crown reduction is a permitted alternative that avoids removal entirely.' } },
    { '@type': 'Question', name: 'Can you clear trees and brush for fire prevention on Winchester rural lots?', acceptedAnswer: { '@type': 'Answer', text: 'Yes — fire clearance is one of the most common requests we get from Winchester property owners. California law requires 100-foot defensible space around structures on rural parcels in high fire hazard severity zones. We remove dead trees, trim overgrown canopies, clear understory brush, and chip material on-site. We can also provide documentation for CAL FIRE compliance inspections.' } },
  ],
};
---

<BaseLayout
  title="Tree Service Winchester CA | Free Estimate"
  description="Professional tree removal, trimming, stump grinding, and fire clearance in Winchester, CA. Serving rural properties, horse lots, and tract homes. Licensed arborists. Free estimates."
  canonicalUrl="https://murrietatreeexperts.com/winchester/"
>
  <Hero
    headline="Tree Service in Winchester, CA — Rural & Residential Experts"
    subheadline="Certified arborists serving Winchester's acreage properties, horse lots, and newer developments. Tree removal, trimming, stump grinding, and fire clearance. Free estimates."
    ctaText="Get a Free Quote"
    secondaryCtaText={`Call ${SITE_CONFIG.phone}`}
    secondaryCtaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <!-- Services Grid -->
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="text-3xl font-bold text-primary text-center mb-4">Tree Services We Offer in Winchester</h2>
    <p class="text-gray-600 text-center max-w-2xl mx-auto mb-10">
      From fire clearance on large rural parcels to routine trimming on new-construction lots, our licensed arborists handle all tree work in Winchester and surrounding unincorporated Riverside County.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {SITE_CONFIG.services.map((service) => (
        <ServiceCard title={service.title} description={service.description} href={service.href} />
      ))}
    </div>
  </section>

  <!-- Local Content -->
  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>Tree Care for Winchester's Diverse Properties</h2>
      <p>
        Winchester spans a range of property types — from newer master-planned communities like Winchester Commons and Morningstar Ranch to established horse properties and open agricultural parcels along Leon Road and Benton Road. Each type of property brings different tree challenges. Tract homes often need routine maintenance of fast-growing ornamentals, while rural lots may have decades-old eucalyptus, pepper trees, and native oaks that have outgrown their space or created fire and structural hazards.
      </p>

      <h2>Fire Clearance and Defensible Space</h2>
      <p>
        Winchester sits in a fire hazard severity zone, and California law requires homeowners to maintain defensible space around structures. This means removing dead trees and branches, reducing canopy coverage near rooflines, and clearing understory vegetation within 100 feet of the home. We perform fire clearance work that meets CAL FIRE standards and can provide documentation for compliance inspections. Proactive tree management is one of the most important steps Winchester homeowners can take to protect their property.
      </p>

      <h2>Native Oaks and Protected Trees</h2>
      <p>
        Winchester's rural landscape includes native California live oak, valley oak, and blue oak — species that provide irreplaceable habitat value and shade but are subject to Riverside County tree protection ordinances. Before removing any oak, we assess trunk diameter and species to determine whether a permit is required. In many cases, strategic pruning or canopy reduction resolves the issue without removal, and we always prefer preservation when it's safe to do so.
      </p>

      <h2>Why Winchester Property Owners Choose Us</h2>
      <p>
        We're based in the Murrieta/Temecula Valley and serve all of unincorporated Winchester without travel fees. Our crew is California licensed and fully insured. We provide written estimates before any work starts, handle large acreage projects with appropriate equipment, and leave every property clean — chips, logs, and debris hauled or chipped on-site.
      </p>
    </div>
  </div>

  <!-- Service Area -->
  <section class="bg-gray-50 py-12 px-4">
    <div class="max-w-6xl mx-auto text-center">
      <h2 class="text-2xl font-bold text-primary mb-4">Also Serving the Surrounding Area</h2>
      <div class="flex flex-wrap justify-center gap-3">
        {['Murrieta', 'Temecula', 'Menifee', 'Wildomar', 'Lake Elsinore', 'Perris', 'San Jacinto', 'Hemet'].map(city => (
          <span class="bg-white border border-gray-200 rounded-full px-4 py-1.5 text-sm text-gray-700 shadow-sm">{city}</span>
        ))}
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="max-w-4xl mx-auto py-12 px-4">
    <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions — Tree Service in Winchester, CA</h2>
    <div class="space-y-4">
      {[
        { q: "Do you service rural and semi-rural properties in Winchester, CA?", a: "Yes — we regularly work on rural and semi-rural lots in Winchester, including large acreage properties, horse properties, and newer tract homes in communities like Winchester Commons and Morningstar Ranch. We bring the right equipment for both tight suburban lots and open rural properties where larger trees may have grown unchecked for years." },
        { q: "How much does tree removal cost in Winchester, CA?", a: "Tree removal in Winchester typically runs $300–$1,800+ depending on tree size, species, and access. Rural properties with large native oaks or overgrown eucalyptus at the high end of that range. Newer tract homes with smaller ornamental trees are often on the lower end. We provide free written estimates — contact us to schedule an on-site assessment." },
        { q: "Do you remove native oak trees in Winchester?", a: "We do remove oak trees in Winchester, but California oak trees may be subject to protections under Riverside County ordinance depending on trunk diameter and species. We check permit requirements during your free estimate and guide you through the process if approval is needed. In many cases, trimming or crown reduction is a permitted alternative that avoids removal entirely." },
        { q: "Can you clear trees and brush for fire prevention on Winchester rural lots?", a: "Yes — fire clearance is one of the most common requests we get from Winchester property owners. California law requires 100-foot defensible space around structures on rural parcels in high fire hazard severity zones. We remove dead trees, trim overgrown canopies, clear understory brush, and chip material on-site. We can also provide documentation for CAL FIRE compliance inspections." },
      ].map(({ q, a }) => (
        <details class="border border-gray-200 rounded-xl overflow-hidden group">
          <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
            {q}
            <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
        </details>
      ))}
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-16">
    <LeadForm heading="Get Your Free Tree Service Quote in Winchester" />
  </section>
</BaseLayout>
