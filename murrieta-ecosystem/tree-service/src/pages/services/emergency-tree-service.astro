---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How quickly do you respond to emergency tree calls?',
      acceptedAnswer: { '@type': 'Answer', text: 'For genuine emergencies — a tree on your home, a fallen limb blocking your driveway, or a tree contacting power lines — we typically dispatch within 2–4 hours. Response time can vary based on demand after major storm events in the Murrieta area. Call us directly for the fastest response; do not rely on an online form in an emergency.' },
    },
    {
      '@type': 'Question',
      name: 'What qualifies as a tree emergency?',
      acceptedAnswer: { '@type': 'Answer', text: 'A tree emergency is any situation posing immediate risk to people, vehicles, structures, or utilities. This includes trees or large limbs that have fallen on your home or car, branches making contact with power lines, trees actively leaning after a storm, or any situation where waiting creates significant additional risk. If you are unsure, call us — we will help you assess the urgency.' },
    },
    {
      '@type': 'Question',
      name: 'Do you charge more for emergency or after-hours service?',
      acceptedAnswer: { '@type': 'Answer', text: 'Emergency and after-hours calls do carry a premium rate compared to scheduled daytime service. The exact surcharge depends on the time of day and nature of the job. We are transparent about pricing before we begin work — you will know the estimated cost upfront. In most cases, the cost is well worth the immediate peace of mind and prevention of further property damage.' },
    },
    {
      '@type': 'Question',
      name: 'Are you available on weekends and holidays?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes — our emergency line is active 24 hours a day, 7 days a week, including weekends and all major holidays. Trees do not wait for business hours, and neither do we. For non-emergency work, we also offer weekend scheduling by appointment.' },
    },
    {
      '@type': 'Question',
      name: 'What should I do while waiting for emergency tree service to arrive?',
      acceptedAnswer: { '@type': 'Answer', text: 'Stay clear of the affected area and keep family and pets away from the tree and any debris. If a tree is touching power lines, do not approach it and call your utility company immediately in addition to calling us. Document the damage with photos for insurance purposes. If the tree has breached your home, cover any openings with tarps if you can safely do so from the inside.' },
    },
    {
      '@type': 'Question',
      name: "Will my homeowner's insurance cover emergency tree removal?",
      acceptedAnswer: { '@type': 'Answer', text: "Homeowner's insurance typically covers emergency tree removal when a tree falls on an insured structure — such as your home, garage, or fence — due to a storm or natural event. Removal of a tree that simply fell in your yard without hitting a structure is usually not covered. We can provide detailed documentation of the damage and work performed to support your insurance claim." },
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Emergency Tree Service',
  name: '24/7 Emergency Tree Service in Murrieta, CA',
  description: '24/7 emergency tree service in Murrieta, CA. Storm damage, fallen trees, and hazardous limbs handled immediately. Licensed arborists, fast response.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    telephone: SITE_CONFIG.phone,
  },
  areaServed: [
    { '@type': 'City', name: 'Murrieta' },
    { '@type': 'City', name: 'Temecula' },
    { '@type': 'City', name: 'Wildomar' },
  ],
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: SITE_CONFIG.domain,
    availableLanguage: 'English',
    hoursAvailable: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  },
};
---

<BaseLayout
  title="Emergency Tree Service Murrieta, CA | 24/7 Storm Damage Response"
  description="24/7 emergency tree service in Murrieta, CA. Storm damage, fallen trees, and hazardous limbs handled immediately. Call now for fast response."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Hero
    headline="24/7 Emergency Tree Service in Murrieta"
    subheadline="Storm damage, fallen trees, and hazardous limbs — we respond fast to protect your home and family. Available day and night."
    ctaText={`Call Now: ${SITE_CONFIG.phone}`}
    ctaHref={`tel:${SITE_CONFIG.phone}`}
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <div class="bg-red-50 border border-red-200 rounded-xl p-6 mb-8">
      <h2 class="text-xl font-bold text-red-700 mb-2">⚠️ Have a Tree Emergency?</h2>
      <p class="text-red-700">
        Call us immediately at <a href={`tel:${SITE_CONFIG.phone}`} class="font-bold underline">{SITE_CONFIG.phone}</a>.
        We're available 24 hours a day, 7 days a week for true emergencies.
      </p>
    </div>

    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>What Counts as a Tree Emergency?</h2>
      <p>
        A tree emergency is any situation where a tree or large branch poses an immediate threat
        to people, vehicles, structures, or utility lines. This includes trees that have fallen
        or are actively leaning after a storm, large limbs hanging over your roof or car,
        trees making contact with power lines, or any situation where waiting would create
        significant additional risk or damage.
      </p>

      <h2>Murrieta's Weather Risks</h2>
      <p>
        Murrieta homeowners face specific tree hazards from Santa Ana winds (which can reach 60+ mph),
        occasional winter storms, and summer thunderstorms. Our team is familiar with which species
        and which root conditions are most vulnerable in local soils — we can assess your trees
        proactively before the next wind event.
      </p>

      <h2>Our Emergency Response Process</h2>
      <p>
        When you call our emergency line, we dispatch an arborist as quickly as possible —
        typically within 2–4 hours for genuine emergencies. We immediately secure the scene,
        assess structural integrity, and perform the minimum necessary work to eliminate
        the hazard. Full cleanup and additional work is scheduled as a follow-up.
      </p>
      <p>
        After emergency work is complete, many homeowners also contact us about
        <a href="https://concrete-murrieta.com">repairing concrete or hardscaping</a> damaged
        by the fallen tree, and refreshing affected
        <a href="https://landscapingmurrieta.com">landscaping areas</a>.
      </p>
    </div>

    <CrossLinkWidget
      heading="Restore Your Yard After Emergency Tree Work"
      links={[
        { text: "Landscape Design in Murrieta", href: "https://landscapingmurrieta.com/services/landscape-design", description: "Rebuild your outdoor space after storm damage or emergency removal.", icon: "🎨" },
        { text: "Seasonal Cleanup", href: "https://landscapingmurrieta.com/services/seasonal-cleanup", description: "Remove debris and prep the area for restoration plantings.", icon: "🍂" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">More Tree Services</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/emergency-tree-service').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <section class="max-w-4xl mx-auto py-8">
        <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {[
            { q: "How quickly do you respond to emergency tree calls?", a: "For genuine emergencies — a tree on your home, a fallen limb blocking your driveway, or a tree contacting power lines — we typically dispatch within 2–4 hours. Response time can vary based on demand after major storm events in the Murrieta area. Call us directly for the fastest response; do not rely on an online form in an emergency." },
            { q: "What qualifies as a tree emergency?", a: "A tree emergency is any situation posing immediate risk to people, vehicles, structures, or utilities. This includes trees or large limbs that have fallen on your home or car, branches making contact with power lines, trees actively leaning after a storm, or any situation where waiting creates significant additional risk. If you are unsure, call us — we will help you assess the urgency." },
            { q: "Do you charge more for emergency or after-hours service?", a: "Emergency and after-hours calls do carry a premium rate compared to scheduled daytime service. The exact surcharge depends on the time of day and nature of the job. We are transparent about pricing before we begin work — you will know the estimated cost upfront. In most cases, the cost is well worth the immediate peace of mind and prevention of further property damage." },
            { q: "Are you available on weekends and holidays?", a: "Yes — our emergency line is active 24 hours a day, 7 days a week, including weekends and all major holidays. Trees do not wait for business hours, and neither do we. For non-emergency work, we also offer weekend scheduling by appointment." },
            { q: "What should I do while waiting for emergency tree service to arrive?", a: "Stay clear of the affected area and keep family and pets away from the tree and any debris. If a tree is touching power lines, do not approach it and call your utility company immediately in addition to calling us. Document the damage with photos for insurance purposes. If the tree has breached your home, cover any openings with tarps if you can safely do so from the inside." },
            { q: "Will my homeowner's insurance cover emergency tree removal?", a: "Homeowner's insurance typically covers emergency tree removal when a tree falls on an insured structure — such as your home, garage, or fence — due to a storm or natural event. Removal of a tree that simply fell in your yard without hitting a structure is usually not covered. We can provide detailed documentation of the damage and work performed to support your insurance claim." },
          ].map(({ q, a }) => (
            <details class="border border-gray-200 rounded-xl overflow-hidden group">
              <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
                {q}
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-12">
      <LeadForm heading="Non-Emergency? Request a Quote Below" />
    </div>
  </div>
</BaseLayout>
