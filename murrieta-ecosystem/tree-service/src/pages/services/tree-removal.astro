---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LeadForm from '../../components/LeadForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CrossLinkWidget from '../../components/CrossLinkWidget.astro';
import { SITE_CONFIG } from '../../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'How much does tree removal cost in Murrieta, CA?',
      acceptedAnswer: { '@type': 'Answer', text: 'Tree removal in Murrieta typically costs $300–$2,000+ depending on tree size, location, and complexity. Small trees under 30 feet run $300–$600, while large trees over 60 feet or those near structures can range from $800 to $2,000+. We provide free written on-site estimates so you know the exact cost before any work begins.' },
    },
    {
      '@type': 'Question',
      name: 'Do I need a permit to remove a tree in Murrieta?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most residential tree removals in Murrieta do not require a permit. However, protected species like coast live oaks and trees in certain HOA communities or designated areas may need special approval. We review permit requirements during your free estimate and can guide you through the process at no additional charge.' },
    },
    {
      '@type': 'Question',
      name: 'How long does tree removal take?',
      acceptedAnswer: { '@type': 'Answer', text: 'Most standard tree removals are completed in 2–6 hours. Large trees, trees near structures, or complex jobs with difficult access may take a full day. Our team will give you a realistic time estimate when we assess your specific tree and site conditions.' },
    },
    {
      '@type': 'Question',
      name: 'Do you clean up after the job?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes — complete cleanup is always included in every job. We chip all branches, haul away debris, and rake the area clean before we leave. Stump grinding is an optional add-on that can be done the same day. You will be left with a clean yard and no mess.' },
    },
    {
      '@type': 'Question',
      name: 'Can you remove trees near power lines or structures?',
      acceptedAnswer: { '@type': 'Answer', text: 'Yes. Our certified arborists are trained in hazard tree removal and use proper rigging and sectional techniques to safely work near homes, fences, and utilities. For trees making direct contact with power lines, we coordinate with the utility company as required by safety regulations.' },
    },
    {
      '@type': 'Question',
      name: "What's the difference between tree removal and stump grinding?",
      acceptedAnswer: { '@type': 'Answer', text: 'Tree removal refers to cutting down and hauling away the above-ground tree — trunk, branches, and all. Stump grinding is a separate service that eliminates the remaining stump by grinding it 6–12 inches below grade. We recommend combining both services in one visit for convenience and often offer a discounted rate when bundled.' },
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tree Removal',
  name: 'Tree Removal in Murrieta, CA',
  description: 'Professional tree removal in Murrieta, CA. Safe removal of hazardous, dead, or unwanted trees by certified arborists. Free estimates, same-day service available.',
  provider: {
    '@type': 'LocalBusiness',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.domain,
    telephone: SITE_CONFIG.phone,
  },
  areaServed: [
    { '@type': 'City', name: 'Murrieta' },
    { '@type': 'City', name: 'Temecula' },
    { '@type': 'City', name: 'Wildomar' },
  ],
  offers: {
    '@type': 'Offer',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: '300',
      maxPrice: '2000',
      priceCurrency: 'USD',
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_CONFIG.domain },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE_CONFIG.domain}/services/` },
    { '@type': 'ListItem', position: 3, name: 'Tree Removal', item: `${SITE_CONFIG.domain}/services/tree-removal/` },
  ],
};
---

<BaseLayout
  title="Tree Removal Murrieta CA | Licensed · Free Estimate"
  description="Professional tree removal in Murrieta, CA. Licensed arborists, safe removal of hazardous and unwanted trees. Free estimates, same-day service available."
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Hero
    headline="Professional Tree Removal in Murrieta, CA"
    subheadline="Safe, efficient removal of hazardous, dead, or unwanted trees. Our certified arborists protect your property every step of the way."
    ctaText="Get a Free Quote"
  />

  <div class="max-w-4xl mx-auto px-4 py-12">
    <nav class="text-sm text-gray-500 mb-8" aria-label="breadcrumb">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="mx-2">/</span>
      <span>Services</span>
      <span class="mx-2">/</span>
      <span class="text-gray-800">Tree Removal</span>
    </nav>

    <div class="prose prose-lg max-w-none prose-headings:text-primary">
      <h2>When Do You Need Tree Removal in Murrieta?</h2>
      <p>
        Trees are valuable assets to any Murrieta property — they provide shade, improve curb appeal,
        and boost home values. However, there are situations where removal becomes necessary.
      </p>

      <h3>Dead or Declining Trees</h3>
      <p>
        A dead tree loses structural integrity quickly in Murrieta's heat and dry conditions. Bark
        falling off, no leaf production by late spring, or soft wood at the base are clear signs the
        tree must come down before it becomes a safety hazard. Eucalyptus and pine — two of the most
        common species here — can become unpredictably brittle when dead.
      </p>

      <h3>Storm Damage & Hazard Trees</h3>
      <p>
        Santa Ana winds and occasional winter storms create sudden failures in trees with dense,
        unmanaged canopies or compromised root systems. A tree leaning toward your house, a large
        split branch hanging overhead, or roots heaving the soil are all urgent removal situations.
        We offer 24/7 emergency response for active hazards.
      </p>

      <h3>Construction or Site Clearance</h3>
      <p>
        New additions, pool installations, driveway expansions, and lot development often require
        one or more trees to be removed. We coordinate with contractors and can time removal to
        fit your project schedule, including stump grinding and debris removal in a single visit.
      </p>

      <h2>Our Tree Removal Process</h2>
      <p>
        We begin every removal with a thorough assessment of the tree's condition, lean, weight
        distribution, and proximity to structures. Our certified arborists develop a removal plan
        that protects your lawn, landscaping, fences, and home. We use professional-grade rigging
        and specialized equipment to section down large trees safely in tight spaces.
      </p>
      <p>
        All debris is removed from your property, and we can grind the stump to ground level
        as part of the same visit if desired. We leave your yard clean and ready for
        <a href="https://landscapingmurrieta.com/services/landscape-design">new landscaping</a> or
        <a href="https://murrietaconcreteworks.com/services/concrete-driveways">hardscaping projects</a>.
      </p>

      <h2>Why Hire a Professional?</h2>
      <p>
        Tree removal is one of the most dangerous home improvement tasks a homeowner can attempt.
        Without proper training and equipment, falling trees and limbs cause serious injuries
        and expensive property damage every year. Our team carries full liability insurance and
        workers' compensation — protecting you from any liability on your property.
      </p>

      <h2>Tree Removal Cost in Murrieta</h2>
      <p>
        Costs vary based on tree size, location, access difficulty, and whether stump grinding is included. We provide free, written on-site estimates with no surprise charges.
      </p>
      <table class="w-full text-sm border border-gray-200 rounded-lg overflow-hidden my-4">
        <thead class="bg-gray-50">
          <tr>
            <th class="text-left px-4 py-3 font-semibold text-primary border-b">Tree Size</th>
            <th class="text-left px-4 py-3 font-semibold text-primary border-b">Typical Cost</th>
            <th class="text-left px-4 py-3 font-semibold text-primary border-b">Examples</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b">
            <td class="px-4 py-3">Small (under 30 ft)</td>
            <td class="px-4 py-3 font-semibold">$300–$600</td>
            <td class="px-4 py-3 text-gray-600">Fruit trees, young pines</td>
          </tr>
          <tr class="border-b bg-gray-50">
            <td class="px-4 py-3">Medium (30–60 ft)</td>
            <td class="px-4 py-3 font-semibold">$600–$1,200</td>
            <td class="px-4 py-3 text-gray-600">Mature oaks, pepper trees</td>
          </tr>
          <tr>
            <td class="px-4 py-3">Large (60 ft+)</td>
            <td class="px-4 py-3 font-semibold">$1,200–$2,000+</td>
            <td class="px-4 py-3 text-gray-600">Eucalyptus, tall palms near structures</td>
          </tr>
        </tbody>
      </table>
      <p class="text-sm text-gray-600">Stump grinding add-on: $100–$300 when bundled with removal on the same visit.</p>

      <h2>Service Area</h2>
      <p>
        We serve all Murrieta neighborhoods including Old Town, Bear Creek, Murrieta Oaks,
        Copper Canyon, and Greer Ranch, as well as Temecula, Wildomar, and Lake Elsinore.
      </p>
    </div>

    <CrossLinkWidget
      heading="Ready to Landscape After Tree Removal?"
      links={[
        { text: "Landscape Design in Murrieta", href: "https://landscapingmurrieta.com/services/landscape-design", description: "Custom yard plans that turn a cleared tree area into something beautiful.", icon: "🎨" },
        { text: "Lawn Care & Restoration", href: "https://landscapingmurrieta.com/services/lawn-care", description: "Restore and maintain the turf area left behind after removal.", icon: "🌿" },
        { text: "Concrete Driveways & Patios", href: "https://murrietaconcreteworks.com/services/concrete-driveways", description: "Pour a new concrete driveway or patio in the area cleared by tree removal.", icon: "🏗️" },
        { text: "Seasonal Cleanup", href: "https://landscapingmurrieta.com/services/seasonal-cleanup", description: "Clear debris and prep the area for new planting after tree work.", icon: "🍂" },
      ]}
    />

    <div class="mt-12">
      <h2 class="text-2xl font-bold text-primary mb-6">Other Services We Offer</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {SITE_CONFIG.services.filter(s => s.href !== '/services/tree-removal').map((s) => (
          <ServiceCard title={s.title} description={s.description} href={s.href} />
        ))}
      </div>
    </div>

    <div class="mt-12">
      <section class="max-w-4xl mx-auto py-8">
        <h2 class="text-3xl font-bold text-primary text-center mb-10">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {[
            { q: "How much does tree removal cost in Murrieta, CA?", a: "Tree removal in Murrieta typically costs $300–$2,000+ depending on tree size, location, and complexity. Small trees under 30 feet run $300–$600, while large trees over 60 feet or those near structures can range from $800 to $2,000+. We provide free written on-site estimates so you know the exact cost before any work begins." },
            { q: "Do I need a permit to remove a tree in Murrieta?", a: "Most residential tree removals in Murrieta do not require a permit. However, protected species like coast live oaks and trees in certain HOA communities or designated areas may need special approval. We review permit requirements during your free estimate and can guide you through the process at no additional charge." },
            { q: "How long does tree removal take?", a: "Most standard tree removals are completed in 2–6 hours. Large trees, trees near structures, or complex jobs with difficult access may take a full day. Our team will give you a realistic time estimate when we assess your specific tree and site conditions." },
            { q: "Do you clean up after the job?", a: "Yes — complete cleanup is always included in every job. We chip all branches, haul away debris, and rake the area clean before we leave. Stump grinding is an optional add-on that can be done the same day. You will be left with a clean yard and no mess." },
            { q: "Can you remove trees near power lines or structures?", a: "Yes. Our certified arborists are trained in hazard tree removal and use proper rigging and sectional techniques to safely work near homes, fences, and utilities. For trees making direct contact with power lines, we coordinate with the utility company as required by safety regulations." },
            { q: "What's the difference between tree removal and stump grinding?", a: "Tree removal refers to cutting down and hauling away the above-ground tree — trunk, branches, and all. Stump grinding is a separate service that eliminates the remaining stump by grinding it 6–12 inches below grade. We recommend combining both services in one visit for convenience and often offer a discounted rate when bundled." },
          ].map(({ q, a }) => (
            <details class="border border-gray-200 rounded-xl overflow-hidden group">
              <summary class="flex justify-between items-center px-6 py-4 cursor-pointer font-semibold text-primary hover:bg-gray-50 list-none">
                {q}
                <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-6 pb-5 text-gray-600 text-sm leading-relaxed">{a}</div>
            </details>
          ))}
        </div>
      </section>
    </div>

    <div class="mt-12">
      <LeadForm heading="Get Your Free Tree Removal Estimate" />
    </div>
  </div>
</BaseLayout>
