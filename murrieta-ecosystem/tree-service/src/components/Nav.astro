---
import { SITE_CONFIG } from '../config';
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services/tree-removal', label: 'Tree Removal' },
  { href: '/services/tree-trimming', label: 'Trimming' },
  { href: '/services/stump-grinding', label: 'Stump Grinding' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="bg-primary text-white shadow-md sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight hover:text-accent transition-colors">
      {SITE_CONFIG.name}
    </a>

    <button
      id="menu-toggle"
      class="md:hidden p-2 rounded focus:outline-none focus:ring-2 focus:ring-accent"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <nav id="nav-menu" class="hidden md:flex items-center gap-6 text-sm font-medium">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-accent transition-colors">{link.label}</a>
      ))}
      <a
        href={`tel:${SITE_CONFIG.phone}`}
        class="border border-white/50 text-white px-4 py-2 rounded font-semibold hover:bg-white/10 transition-colors"
      >
        {SITE_CONFIG.phone}
      </a>
      <a
        href="/contact"
        class="bg-cta text-white px-4 py-2 rounded font-semibold hover:opacity-90 transition-opacity"
      >
        Free Quote
      </a>
    </nav>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-primary border-t border-white/20">
    <nav class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-3 text-sm font-medium">
      {navLinks.map((link) => (
        <a href={link.href} class="hover:text-accent transition-colors py-1">{link.label}</a>
      ))}
      <a
        href={`tel:${SITE_CONFIG.phone}`}
        class="border border-white/50 text-white px-4 py-2 rounded font-semibold text-center hover:bg-white/10 transition-colors"
      >
        {SITE_CONFIG.phone}
      </a>
      <a
        href="/contact"
        class="bg-cta text-white px-4 py-2 rounded font-semibold text-center hover:opacity-90 transition-opacity"
      >
        Free Quote
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
